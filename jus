# ---------------------------------------------------------------------------
# jus doctor — is this project's SOP surface actually loaded? (#4508)
# ---------------------------------------------------------------------------
#
# ⚠️ THE CHECK EXISTED AND NOBODY COULD RUN IT. The three plugin detectors above
# are scope-aware and have been corrected twice (#4005, #4403), and their only
# caller was the interactive `jus init`. So an agent told by `.jus/SOP.md` that
# "the skills win where the two differ" had no way to discover it had not got
# them — `jus help` named neither the plugin nor the skills.
#
# ⚠️ A HOOK CANNOT DO THIS. The enforcement hooks ship INSIDE the plugin, so in
# exactly the failure case nothing fires.
#
# ⚠️ AND THE HARD PART IS CONFIDENCE, NOT DETECTION. A warning that nags a
# correctly-installed user is one that gets ignored, which costs more than a
# missed warning. Every branch below that cannot substantiate a verdict says so
# and returns 0 — the same position jus_plugin_installed_machine_wide already
# takes when `jq` is absent.

# The report lines print through the jus_ui_ helpers since #4839: ✓ for a
# check that passed, ✗ for one that failed, and a dim note for the context
# under it. Three constants used to carry the marks with a two-space indent.

# Does a root hold at least one skill whose link RESOLVES?
#
# ⚠️ A DANGLING LINK IS THE FAILURE A DIRECTORY LISTING HIDES. `ls` shows the
# entry and the tool loads nothing — which is what `rm -rf ~/.jus-skills` leaves
# behind, links and all. `-e` follows the symlink; `-L` would not.
jus_doctor_skills_linked() {
  local root="$1" entry found=1
  [[ -d "$root" ]] || return 1
  for entry in "$root"/*; do
    [[ -e "$entry" ]] || continue
    found=0
  done
  return "$found"
}

# Reports the skills-bundle surface for a non-Claude tool. Echoes lines; returns
# 0 when .agents/skills/ resolves, the one root every such tool reads (#5189).
#
# ⚠️ A PROJECT WIRED THROUGH THE TOOL'S OWN PLUGIN HAS NO LINKS AT ALL (#4833,
# #4836), so the links are judged only when the tool does not report its plugin
# active. "Cannot tell" falls through to the links too — never read as installed.
jus_doctor_report_skills() {
  local project_root="$1" choice="$2"
  if jus_tool_plugin_enabled "$choice" "$project_root"; then
    jus_doctor_report_tool_plugin "$choice" "$project_root"
    return
  fi
  if jus_doctor_skills_linked "${project_root}/.agents/skills"; then
    jus_ui_done "skills linked in .agents/skills/"
    return 0
  fi
  jus_ui_fail "no resolvable skills in .agents/skills/"
  jus_print_bundle_link_hint "$choice"
  return 1
}

# The tool's own plugin serves the skills. Fails if something an earlier install
# made is still there beside it and loads as well: the skill links (#4833,
# #4836), or a hooks merge once the plugin registers the hooks itself (#4834).
jus_doctor_report_tool_plugin() {
  local choice="$1" project_root="$2" kind name rm_line merged
  kind="$(jus_tool_plugin_kind "$choice")"
  name="$(jus_tool_plugin_brand "$choice")"
  jus_ui_done "skills served by the jus ${name} ${kind}"
  if jus_tool_plugin_hooks "$choice" >/dev/null && merged="$(jus_installed_manifest "$choice" "$project_root")"; then
    jus_ui_fail "the ${kind} registers the enforcement hooks, and ${merged} does too,"
    jus_ui_note "so every hook fires twice. Remove the merged copy: ${PROG_NAME} remove-hooks"
    return 1
  fi
  local root doubled=0
  while IFS= read -r root; do
    rm_line="$(jus_clone_links_rm_line "$project_root" "$root")"
    [[ -n "$rm_line" ]] || continue
    doubled=1
    jus_ui_fail "${root}/ still links them too, so ${name} loads every skill twice."
    jus_ui_note "Remove the links:"
    jus_ui_cmd "${rm_line}"
  done < <(jus_tool_plugin_shadowed_roots "$choice")
  [[ "$doubled" -eq 0 ]] || return 1
  jus_ui_note "A ${name} session started before the install has not loaded them yet."
  return 0
}

# Reports the Claude Code plugin surface. Echoes lines; returns 0 when the
# plugin serves this project.
jus_doctor_report_plugin() {
  local project_root="$1"
  if jus_committed_bundle_present "$project_root"; then
    jus_ui_done "skills served by a committed copy (.claude/skills/ tracked in git)"
    jus_ui_note "the plugin is deliberately NOT installed on top — it would"
    jus_ui_note "double-register every skill and hook."
    return 0
  fi

  if ! jus_plugin_installed "$project_root"; then
    jus_ui_fail "the jus@jus-skills plugin is not installed for this project"
    # ⚠️ A SLUG, NOT THE MENU POSITION (#4877). This said `1`, written under
    # #4508 when the menu was position-keyed. After #4760 it matched no case
    # arm, so `jus_sop_method` answered `fallback` and the one user whose skills
    # come WITH the enforcement hooks was told to clone and link instead.
    jus_print_bundle_install claude "Claude Code"
    return 1
  fi

  jus_ui_done "the jus@jus-skills plugin is installed for this project"
  if jus_plugin_installed_machine_wide; then
    jus_ui_note "scope: machine-wide — it loads in every project on this computer."
  fi
  # ⚠️ THE THIRD STATE, AND THE ONE PEOPLE ACTUALLY HIT. "Installed, but this
  # session started before the install" leaves no trace on disk anywhere, so a
  # clean registry is the only moment the reload can be named — which makes a
  # passing verdict still actionable rather than merely reassuring.
  jus_ui_note "If the skills are still missing in an open session, that session"
  jus_ui_note "predates the install. Run /reload-plugins inside it."
  jus_doctor_report_autoupdate "$project_root"
  return 0
}

# Whether Claude Code keeps the plugin current (#5387). A warning, never a
# failure: the skills load today, and what is at stake is next month's SOP.
#
# ⚠️ OFF IS THE DEFAULT. Claude Code updates Anthropic's own marketplaces by
# itself and no other, so a hand-added jus-skills never updates unless
# `autoUpdate` is on. known_marketplaces.json is where the setting lands once
# Claude Code has applied it, whichever settings file declared it.
#
# Silent without jq or without that file: a warning it cannot substantiate is
# worse than none.
jus_doctor_report_autoupdate() {
  local project_root="$1" known="$HOME/.claude/plugins/known_marketplaces.json" killed
  command -v jq &>/dev/null || return 0
  [[ -f "$known" ]] || return 0
  if ! jq -e '.["jus-skills"].autoUpdate == true' "$known" >/dev/null 2>&1; then
    jus_ui_warn "plugin auto-update is off for jus-skills, so the skills never update"
    if jq -e '.extraKnownMarketplaces["jus-skills"].autoUpdate == true' \
      "${project_root}/.claude/settings.json" >/dev/null 2>&1; then
      jus_ui_note $'This project\'s .claude/settings.json turns it on, and Claude Code\nreads that once the folder is trusted. Launch Claude Code here and\ntrust the folder.'
    else
      jus_ui_note $'Inside Claude Code: /plugin, then Marketplaces, jus-skills, and\nEnable auto-update.'
    fi
    return 0
  fi
  if killed="$(jus_claude_autoupdate_killed "$project_root")"; then
    jus_ui_warn "jus-skills asks for auto-update, but ${killed} switches it off"
    jus_ui_note $'Plugin updates share the Claude Code updater\'s off switch. Set\nFORCE_AUTOUPDATE_PLUGINS=1 beside it to keep the plugin current.'
    return 0
  fi
  jus_ui_done "plugin auto-update is on for jus-skills"
  jus_ui_note $'A Homebrew or npm install of Claude Code switches it off unless\nFORCE_AUTOUPDATE_PLUGINS=1 is set.'
}

# Echo which setting switches plugin auto-update off — "NAME in <where>" — or
# fail when none does, or when FORCE_AUTOUPDATE_PLUGINS overrides it.
#
# ⚠️ CLAUDE CODE'S SETTINGS AS WELL AS THIS SHELL. Its `env` block is where a
# pinned Claude Code version usually lives, and doctor's own environment never
# sees it.
jus_claude_autoupdate_killed() {
  local project_root="$1" name
  jus_claude_env_set FORCE_AUTOUPDATE_PLUGINS "$project_root" >/dev/null && return 1
  for name in DISABLE_AUTOUPDATER DISABLE_UPDATES; do
    jus_claude_env_set "$name" "$project_root" && return 0
  done
  return 1
}

# Echo "NAME in this shell" or "NAME in <settings file>" for the first place
# that gives NAME a value, or fail.
jus_claude_env_set() {
  local name="$1" project_root="$2" file
  if [[ -n "${!name:-}" ]]; then
    printf '%s in this shell\n' "$name"
    return 0
  fi
  for file in "$HOME/.claude/settings.json" \
              "${project_root}/.claude/settings.json" \
              "${project_root}/.claude/settings.local.json"; do
    jq -e --arg n "$name" '(.env[$n] // "") | tostring | length > 0' "$file" >/dev/null 2>&1 || continue
    printf '%s in %s\n' "$name" "$(jus_tilde_path "$file")"
    return 0
  done
  return 1
}

# Which surface to judge, when nothing was recorded, as a brand slug.
#
# ⚠️ INFERRED, NOT GUESSED, and silent when neither exists. A project with
# resolvable links is a skills install whatever the menu said; one whose plugin
# is registered is a Claude install. With neither, the honest answer is that we
# do not know, and a check that guesses nags whichever user it guessed wrong
# about.
#
# ⚠️ A SLUG, NEVER A MENU NUMBER (#4955). This answered "2" and "1" from #4508
# on, and after #4760 every consumer read both as "fallback": `jus doctor`
# checked nothing and passed, and `jus refresh-hooks` found no manifest. The
# skills tool is the one whose hook manifest is installed; with none, Cursor —
# what "2" meant here, and a tool with no plugin of its own to ask about.
#
# ⚠️ CURSOR IS THE GUESS, SO IT GOES LAST (#5986). An installed hook manifest,
# a registered Claude Code plugin and a git-tracked `.claude/skills/` copy
# (#2195) are all evidence; Cursor with no manifest is not. Asked first, it
# named Cursor for this repository, which links skills into its own tree and
# runs Claude Code on its committed copy, and doctor then judged the missing
# clone and said nothing was being enforced.
jus_doctor_infer_choice() {
  local project_root="$1" slug linked=0
  if jus_doctor_skills_linked "${project_root}/.agents/skills"; then
    linked=1
    for slug in "${JUS_TOOL_SLUGS[@]}"; do
      [[ "$(jus_sop_method "$slug")" == "skills" ]] || continue
      if jus_installed_manifest "$slug" "$project_root" >/dev/null; then
        printf '%s\n' "$slug"
        return 0
      fi
    done
  fi
  if jus_committed_bundle_present "$project_root" || jus_plugin_installed "$project_root"; then
    printf 'claude\n'
    return 0
  fi
  [[ "$linked" -eq 1 ]] || return 1
  printf 'cursor\n'
}

# ── manifest staleness (#4421) ───────────────────────────────────────────────
#
# ⚠️ A CLONE PULL REACHES TWO OF THE THREE PAYLOADS. Skills are symlinks into
# the clone and the shared hook scripts are referenced from inside the manifest
# by absolute path, so `git -C ~/.jus-skills pull` updates both. Every MANIFEST
# is a copy — `.cursor/hooks.json`, `.qwen/settings.json`, `~/.kimi-code/config.toml`
# — so a change to WHICH events an adapter registers reaches nobody who has
# already installed, and nothing reported the difference.
#
# ⚠️ THE KEY IS THE REGISTERED COMMANDS, NOT THE BYTES. `jus init` rewrites the
# clone path into the manifest and a user may have moved the clone, so a byte
# compare reports a difference that is not one. The command set is what the tool
# actually RUNS — the identity the Codex installer merged on since #4239, for the
# reason its comment gives.
#
# ⚠️ AND NO VERSION STAMP, DELIBERATELY. A stamp inside Qwen's settings.json
# would have to survive a merge into a file the user owns and edits. The command
# set is derivable from the file, so nothing has to be stored.

# Every place a tool's manifest is documented to live, project scope first.
#
# ⚠️ A LIST TO SCAN, NOT A DESTINATION TO WRITE. Windsurf documents four
# locations, Antigravity two, Copilot a directory rather than a file, and some
# are user-scope where others are project-scope — so there is no honest single
# answer to "where does this go". An installed manifest says where it lives.
jus_manifest_locations() {
  local choice="$1" project_root="$2"
  case "$choice" in
    cursor) printf '%s\n' "${project_root}/.cursor/hooks.json" "$HOME/.cursor/hooks.json" ;;
    codex) printf '%s\n' "${project_root}/.codex/hooks.json" "$HOME/.codex/hooks.json" ;;
    # ⚠️ CHOICE 4 IS GEMINI CLI, NOT ANTIGRAVITY (#4419). It pointed at the
    # Antigravity manifest on the premise that Gemini CLI had been sunset —
    # measured false on 2026-09-19 — and that manifest registers PreToolUse,
    # PostToolUse, Stop and PreInvocation, none of which Gemini CLI fires. A
    # Gemini user who ran `jus init` got a manifest that registered nothing.
    # Antigravity keeps its own adapter, reached from its own README.
    gemini) printf '%s\n' "${project_root}/.gemini/settings.json" "$HOME/.gemini/settings.json" ;;
    # ⚠️ USER SETTINGS FIRST, AND THE REPO PATH ONLY AS LEGACY (#4771). Copilot
    # 1.0.87 does not load .github/hooks/*.json at all — measured with a control:
    # installed there a real turn RAN the command our guard refuses; installed at
    # user level it was blocked. The repo path stays in the SCAN so an install
    # left by an older jus init is still found and reported, but it must not come
    # first: jus_installed_manifest takes the first hit and would keep writing to
    # the location nothing reads.
    copilot) printf '%s\n' "$HOME/.copilot/settings.json" "${project_root}"/.github/hooks/*.json ;;
    windsurf) printf '%s\n' "${project_root}/.windsurf/hooks.json" "$HOME/.codeium/windsurf/hooks.json" \
         "$HOME/.codeium/hooks.json" ;;
    kimi) printf '%s\n' "$HOME/.kimi-code/config.toml" ;;
    qwen) printf '%s\n' "${project_root}/.qwen/settings.json" "$HOME/.qwen/settings.json" ;;
    # Global only (#4804): the project path, <root>/.agents/hooks.json, measured
    # loading ZERO hooks in `agy -p` (hooks/antigravity/README.md).
    antigravity) printf '%s\n' "$HOME/.gemini/config/hooks.json" ;;
    *) : ;;
  esac
}

# The bundle's own manifest for a tool, or nothing.
jus_manifest_source() {
  local choice="$1" clone rel
  # The RESOLVED bundle, not the clone directory: a brew-installed bundle is
  # what its own manifests should be read from (#4759). Falls back to where a
  # clone would go, so callers testing `-f` still get a path to name.
  clone="$(jus_bundle_dir)" || clone="$(jus_bundle_clone_dir)"
  case "$choice" in
    cursor) rel="cursor/hooks.json" ;;
    codex) rel="codex/hooks.json" ;;
    gemini) rel="gemini/settings.json" ;;
    copilot) rel="copilot/hooks.json" ;;
    windsurf) rel="windsurf/hooks.json" ;;
    kimi) rel="kimi-code/config-hooks.toml" ;;
    qwen) rel="qwen/settings.json" ;;
    antigravity) rel="antigravity/hooks.json" ;;
    *) return 1 ;;
  esac
  printf '%s\n' "${clone}/hooks/${rel}"
}

# The jus-owned command strings in a manifest, normalised so the clone path
# cannot make two identical registrations look different.
#
# ⚠️ COPILOT KEYS ITS COMMAND `bash`, NOT `command`, and Kimi's is TOML. An
# extractor reading only JSON `command` reports ZERO registrations for Copilot —
# which reads as "nothing installed" rather than "I cannot read this format",
# and is the worse of the two failures because it looks like an answer.
jus_manifest_jus_commands() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  # ⚠️ `grep -o`, NOT `sed` — AND THAT IS NOT A STYLE CHOICE. A sed substitution
  # rewrites each LINE once, and its leading `.*` is greedy, so on a manifest
  # written as a single line of JSON it captures only the LAST registration and
  # silently drops the rest. Measured while writing this: an installed manifest
  # holding two hooks compared as holding one, and the check reported a
  # registration as missing that was right there. The bundle's own manifests are
  # pretty-printed, which is exactly why it would never have shown up here.
  #
  # ⚠️ AND `-E`, NOT BRE WITH `\|`. BSD sed and BSD grep — macOS's — have no
  # alternation in a basic regular expression, so `\(command\|bash\)` matches
  # nothing there and still exits 0.
  local cmd launcher
  while IFS= read -r cmd; do
    # ⚠️ THE IDENTITY IS THE LAUNCHER FORM ON BOTH SIDES (#4759), and it has to
    # be. A migrated manifest compared against a bundle clone that is still
    # path-shaped otherwise matches nothing, so the merge reads every
    # registration as missing and appends it a second time — the double-fire
    # this ticket exists to prevent, arrived at from the other direction.
    if launcher="$(jus_launcher_command "$cmd")"; then
      printf '%s\n' "$launcher"
      continue
    fi
    printf '%s\n' "$cmd"
  done < <(jus_manifest_raw_commands "$file") \
    | sed 's#[^[:space:]]*/hooks/#hooks/#g' \
    | sed -E 's#^[^[:space:]]*/jus hook #jus hook #' \
    | grep -E 'hooks/[A-Za-z0-9/._-]*jus-[A-Za-z0-9._-]*\.sh|^jus hook ' \
    | sort -u
}

# ── migrating an installed manifest onto the launcher (#4759) ────────────────
#
# ⚠️ IT REWRITES COMMAND STRINGS, NOT FILES, and that is what makes one
# implementation cover all four formats: JSON with `command`, Copilot's `bash`,
# Gemini and Qwen's nested settings.json, and Kimi's TOML. What changes is
# inside the string either way, and a literal replacement cannot reformat a
# file the user owns.
#
# ⚠️ AND IT PARSES BY WORD, NOT BY REGEX. A command holds two bundle paths, so
# an ERE with a greedy prefix and leftmost-longest semantics picks the wrong
# `/hooks/` — BSD and GNU disagree about which. Splitting on whitespace and
# matching each word with a `case` glob has no such ambiguity.

# Whether a word looks like a filesystem path — absolute, or rooted at a
# literal tilde the tool will expand itself.
#
# ⚠️ THE TILDE COMES FROM A VARIABLE. A literal `~/` inside a quoted pattern is
# SC2088 and no inline suppression may silence it, so it is built the same way
# `jus_tilde_path` builds one.
jus_is_path_word() {
  local tilde='~'
  case "$1" in
    /* | "${tilde}/"*) return 0 ;;
    *) return 1 ;;
  esac
}

# The bundle-relative reference a hook-script path stands for: `jus-docs-nudge`
# for a shared script, `kimi-code/jus-kimi-prompt-nudge` for one only that tool
# has. Exit 1 for anything that is not a bundle path — a `${CLAUDE_PLUGIN_ROOT}`
# command, or one the user wrote.
jus_bundle_script_ref() {
  local word="$1" rest
  jus_is_path_word "$word" || return 1
  case "$word" in
    */hooks/scripts/jus-*.sh)
      rest="${word##*/hooks/scripts/}"
      printf '%s\n' "${rest%.sh}"
      ;;
    */hooks/*/scripts/jus-*.sh)
      rest="${word##*/hooks/}"
      printf '%s/%s\n' "${rest%%/*}" "$(basename "$rest" .sh)"
      ;;
    *) return 1 ;;
  esac
}

# The tool an adapter path belongs to, or exit 1 when the word is not one.
jus_bundle_adapter_tool() {
  local word="$1" rest
  jus_is_path_word "$word" || return 1
  case "$word" in
    */hooks/*/scripts/jus-*-adapt.sh)
      rest="${word##*/hooks/}"
      printf '%s\n' "${rest%%/*}"
      ;;
    *) return 1 ;;
  esac
}

# One registration's launcher form, or exit 1 when it is not a bundle command.
# The three word counts are the three shapes every manifest is built from;
# antigravity is the only adapter that takes an event, and it takes it first.
jus_launcher_command() {
  local cmd="$1" tool name
  local -a words=()
  read -r -a words <<<"$cmd"
  case ${#words[@]} in
    1)
      name="$(jus_bundle_script_ref "${words[0]}")" || return 1
      printf 'jus hook %s\n' "$name"
      ;;
    2)
      tool="$(jus_bundle_adapter_tool "${words[0]}")" || return 1
      name="$(jus_bundle_script_ref "${words[1]}")" || return 1
      printf 'jus hook --adapt %s %s\n' "$tool" "$name"
      ;;
    3)
      tool="$(jus_bundle_adapter_tool "${words[0]}")" || return 1
      name="$(jus_bundle_script_ref "${words[2]}")" || return 1
      printf 'jus hook --adapt %s --event %s %s\n' "$tool" "${words[1]}" "$name"
      ;;
    *) return 1 ;;
  esac
}

# Every command string in a manifest, verbatim — no normalising, because these
# are what a literal replacement has to find.
jus_manifest_raw_commands() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  grep -oE '("(command|bash)"[[:space:]]*:|(^|[[:space:]])command[[:space:]]*=)[[:space:]]*"[^"]*"' "$file" \
    | sed -E 's/.*"([^"]*)"$/\1/' \
    | sort -u
}

# A literal (not regex) replacement of every occurrence, printed to stdout.
#
# ⚠️ `index`/`substr`, NOT `gsub`. awk's gsub takes an ERE, and every string
# here is a path full of `.` and `-`; `sed` would need the same escaping. This
# needs none.
jus_replace_literal() {
  awk -v old="$2" -v new="$3" '
    {
      line = $0
      out = ""
      while ((i = index(line, old)) > 0) {
        out = out substr(line, 1, i - 1) new
        line = substr(line, i + length(old))
      }
      print out line
    }
  ' "$1"
}

# Rewrites an installed manifest onto `jus hook`. Exit 0 when it changed
# something, 1 when there was nothing to do — so a caller can report only the
# migration that happened.
#
# ⚠️ THIS HAS TO RUN BEFORE THE MERGE, NOT BESIDE IT. `jus refresh-hooks` is
# additive by design (#4421): it adds what is missing and removes nothing. Run
# the merge against an unmigrated manifest and the old path-shaped command
# stays AND the launcher command arrives, so every hook fires twice.
# The path a symlink chain ends at, or the path itself (#4788). Same shape as
# the BASH_SOURCE walk at the top of this file, and for the same reason: BSD
# `readlink` has only lately had `-f`, and `realpath` is not everywhere.
jus_resolve_link() {
  local path="$1" dir
  while [[ -L "$path" ]]; do
    dir="$(cd "$(dirname "$path")" && pwd)"
    path="$(readlink "$path")"
    [[ "$path" != /* ]] && path="${dir}/${path}"
  done
  printf '%s' "$path"
}

# Replaces a file's contents by RENAME, never by truncation (#4788).
#
# ⚠️ `> file` HAS AN EMPTY STATE IN THE MIDDLE OF IT. The shell truncates before
# the writer produces a byte, and these are not jus files: Kimi has no
# project-level config at all, so ~/.kimi-code/config.toml holds every setting
# the user has, and Copilot, Gemini and Qwen are the same shape. A failure
# between the two left nothing, with no backup.
#
# ⚠️ AND THE LINK IS FOLLOWED FIRST, because a rename replaces the path it is
# given. `~/.copilot/settings.json` pointing into a dotfiles repository is an
# ordinary setup, and renaming over the link would turn it into a regular file
# and quietly detach it — something the truncating version got right for free.
#
# ⚠️ THE STAGING FILE IS A SIBLING, not a $TMPDIR one, so the rename stays
# inside one filesystem and is a real rename(2) rather than a copy. `cp -p` onto
# it carries the mode across without a `stat`, whose flags differ between BSD
# and GNU and would have needed a branch.
jus_replace_file_atomically() {
  local file staged
  file="$(jus_resolve_link "$1")"
  staged="$(mktemp "${file}.jus-XXXXXX")" || return 1

  if cp -p "$file" "$staged" && cat "$2" > "$staged" && mv -f "$staged" "$file"; then
    return 0
  fi
  rm -f "$staged"
  return 1
}

jus_migrate_manifest_commands() {
  local file="$1" cmd new changed=0 tmp
  [[ -f "$file" ]] || return 1
  tmp="$(mktemp)" || return 1
  cat "$file" > "$tmp"
  while IFS= read -r cmd; do
    [[ -n "$cmd" ]] || continue
    new="$(jus_launcher_command "$cmd")" || continue
    [[ "$new" != "$cmd" ]] || continue
    jus_replace_literal "$tmp" "$cmd" "$new" > "${tmp}.next"
    mv "${tmp}.next" "$tmp"
    changed=1
  done < <(jus_manifest_raw_commands "$file")

  # ⚠️ THREE OUTCOMES, NOT TWO (#4788). "Nothing to migrate" and "tried and
  # could not" are both non-zero, and collapsing them is how a failed rewrite
  # becomes silent: the caller prints nothing and then merges into a manifest
  # still holding its old commands, which is the double-fire #4759 exists to
  # prevent. 0 migrated, 1 nothing to do, 2 tried and failed.
  if [[ "$changed" -ne 1 ]]; then
    rm -f "$tmp"
    return 1
  fi
  if jus_replace_file_atomically "$file" "$tmp"; then
    rm -f "$tmp"
    return 0
  fi
  rm -f "$tmp"
  return 2
}

# The installed manifest for a tool, or nothing. First location that actually
# carries jus registrations wins.
jus_installed_manifest() {
  local choice="$1" project_root="$2" candidate
  while IFS= read -r candidate; do
    [[ -f "$candidate" ]] || continue
    [[ -n "$(jus_manifest_jus_commands "$candidate")" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done < <(jus_manifest_locations "$choice" "$project_root")
  return 1
}

# What the bundle registers that the installed manifest does not.
#
# ⚠️ ONE DIRECTION ONLY. A registration the USER added is not a defect, and
# reporting it would make every hand-extended manifest permanently "stale".
jus_manifest_missing() {
  local source="$1" installed="$2"
  comm -23 \
    <(jus_manifest_jus_commands "$source") \
    <(jus_manifest_jus_commands "$installed")
}

# Reports whether the installed manifest is behind the bundle. Echoes lines;
# returns 0 when there is nothing to say — including when nothing is installed,
# which is a different problem and `jus init`'s (#4420).
jus_doctor_report_manifest() {
  local choice="$1" project_root="$2" source installed missing
  source="$(jus_manifest_source "$choice")" || return 0
  [[ -f "$source" ]] || return 0
  installed="$(jus_installed_manifest "$choice" "$project_root")" || return 0

  missing="$(jus_manifest_missing "$source" "$installed")"
  [[ -n "$missing" ]] || return 0

  jus_ui_fail "${installed} is behind the bundle"
  jus_ui_note "A clone pull updates the skills and the hook scripts — both are"
  jus_ui_note "reached by reference. A manifest is a COPY, so it never moves."
  jus_ui_note "Missing registrations:"
  jus_ui_note "$(sed 's|^|  |' <<<"$missing")"
  jus_ui_note "Add them with: ${PROG_NAME} refresh-hooks"
  return 1
}

# ── the Cursor hook gap (#4430) ──────────────────────────────────────────────
#
# ⚠️ THE WORST SHAPE A SAFETY FEATURE CAN HAVE: maximum confidence, zero
# coverage. `cursor-agent` reads Claude Code's three settings files among its
# seven hook sources, converts the event names and tool matchers, and sets
# CLAUDE_PROJECT_DIR itself — so a `.claude/settings.json` registering
# `${CLAUDE_PROJECT_DIR}/jus/hooks/scripts/...` resolves and RUNS. Every one of
# the thirteen then exits 0 and writes nothing, because they gate on
# `tool_name == "Bash"` and the matcher conversion rewrites that to `Shell`.
#
# ⚠️ AND NO CLAUDE EVENT MAPS TO `beforeShellExecution`, which is the finding: a
# repo relying on the Claude registration alone has NO command blockers under
# Cursor, while its configured-hooks list looks complete. Re-verified against
# cursor-agent 2026.09.15-d2fe57e on #4430 — it is undocumented behaviour of
# somebody else's binary, so it is checked rather than assumed.

# Does a Claude settings file in this project register jus hooks?
jus_claude_registers_jus_hooks() {
  local project_root="$1" f
  for f in "${project_root}/.claude/settings.json" \
           "${project_root}/.claude/settings.local.json" \
           "$HOME/.claude/settings.json"; do
    [[ -f "$f" ]] && grep -q 'jus/hooks/scripts' "$f" && return 0
  done
  return 1
}

# Is there evidence this project is opened in Cursor?
#
# ⚠️ WITHOUT THIS TERM THE CHECK NAGS EVERY CORRECT CLAUDE CODE SETUP — jus
# hooks in `.claude/settings.json` and no `.cursor/hooks.json` is exactly what a
# Claude-only project looks like, including this one. The recorded tool answers
# it when the wizard was run; a `.cursor/` directory answers it when the repo
# has simply been opened there.
jus_cursor_in_use() {
  local project_root="$1"
  [[ "$(jus_recorded_ai_tool)" == "cursor" ]] && return 0
  [[ -d "${project_root}/.cursor" ]]
}

# The three terms together. Returns 0 only when the gap is real.
jus_cursor_hook_gap() {
  local project_root="$1"
  jus_cursor_in_use "$project_root" || return 1
  [[ -f "${project_root}/.cursor/hooks.json" ]] && return 1
  jus_claude_registers_jus_hooks "$project_root"
}

# ⚠️ NAMES THE CONSEQUENCE, NOT THE CONDITION. "You have no .cursor/hooks.json"
# is a fact about the filesystem; "no command blockers under Cursor" is what it
# costs, and it is the only half that makes anyone act.
jus_doctor_report_cursor_gap() {
  jus_ui_fail "NO command blockers under Cursor"
  jus_ui_note "Cursor loads this project's .claude/settings.json hooks, converts them"
  jus_ui_note "and runs them — but no Claude event maps to Cursor's shell event, so"
  jus_ui_note "every command guard exits 0 without looking. The hooks list looks"
  jus_ui_note "complete and nothing is blocked."
  jus_ui_note "Install the Cursor manifest as well:"
  jus_ui_cmd "cp ~/.jus-skills/hooks/cursor/hooks.json .cursor/hooks.json"
  jus_ui_note "See hooks/cursor/README.md for the path rewrite it needs."
}

# The same question `cmd_doctor` answers, asked silently: is the skills surface
# this project was set up for demonstrably absent? Returns 0 only when it is.
#
# ⚠️ EVERY UNCERTAIN BRANCH RETURNS 1, AND THAT IS THE DESIGN. A warning that
# nags a correctly-installed user is one that gets ignored, which costs more
# than a missed warning. No record and no surface to infer from, a committed
# bundle, a tool with no skills surface at all — each of those returns 1.
jus_skills_surface_missing() {
  local project_root="$1" choice
  jus_committed_bundle_present "$project_root" && return 1
  choice="$(jus_recorded_ai_tool)"
  [[ -n "$choice" ]] || choice="$(jus_doctor_infer_choice "$project_root")" || return 1
  case "$(jus_sop_method "$choice")" in
    plugin) jus_plugin_installed "$project_root" && return 1 ;;
    skills)
      jus_doctor_skills_linked "${project_root}/.agents/skills" && return 1
      # ⚠️ ASKED ONLY ONCE A LINK IS MISSING, because asking is a process.
      # A project on the tool's own plugin has no links at all (#4833, #4836).
      jus_tool_plugin_enabled "$choice" "$project_root" && return 1
      ;;
    *) return 1 ;;
  esac
  return 0
}

# One stderr line, on the call the SOP already makes an agent run first (#4508).
#
# ⚠️ IT RIDES `agent_state` DELIBERATELY, AND NOTHING ELSE. That is the
# documented session-start call, so this reaches an agent at the one moment the
# answer changes what it does — before it reads an SOP claiming skills it has
# not got. Every extra call site is another chance to nag.
#
# ⚠️ STDERR, NEVER STDOUT. Callers pipe `jus api` into a parser; a line on
# stdout would corrupt the JSON contract (#2016).
jus_maybe_warn_skills() {
  local method="$1" path="$2"
  [[ "$method" == "GET" ]] || return 0
  [[ "$path" == *"/agent_state"* ]] || return 0
  if jus_skills_surface_missing "$PROJECT_ROOT"; then
    printf 'jus: the Juscribe skills are not loaded for this project — run `%s doctor`.\n' \
      "$PROG_NAME" >&2
  fi
  # ⚠️ A SEPARATE LINE FOR A SEPARATE FAILURE (#4430). The skills can be
  # perfectly installed while Cursor has no command blockers at all, so one
  # condition cannot stand for both.
  if jus_cursor_hook_gap "$PROJECT_ROOT"; then
    printf 'jus: no command blockers under Cursor — the Claude hooks run and block nothing. Run `%s doctor`.\n' \
      "$PROG_NAME" >&2
  fi
}

cmd_doctor() {
  local project_root="$PROJECT_ROOT" choice inferred=0 failures=0

  echo "jus doctor — ${project_root}"
  echo ""

  if [[ -f "$TOKEN_FILE" ]]; then
    jus_ui_done "API token in .jus/config/api_token.txt"
  else
    jus_ui_fail "no API token — run '${PROG_NAME} login'"
    failures=1
  fi

  if [[ -f "$WORKSPACE_FILE" ]]; then
    jus_doctor_report_workspace || failures=1
  else
    jus_ui_fail "no workspace — run '${PROG_NAME} init'"
    failures=1
  fi

  if git -C "$project_root" rev-parse --git-dir &>/dev/null; then
    jus_ui_done "git repository"
  else
    jus_ui_fail "not a git repository — the whole workflow is commit-shaped"
    failures=1
  fi

  # ⚠️ BEFORE THE AI-TOOL CHECKS, which return early when nothing is recorded.
  # Every board call from here fails, whatever the project is wired for (#4982).
  if jus_codex_network_off; then
    jus_ui_fail "Codex's sandbox has the network off, so nothing here can reach the board"
    jus_codex_network_fix
    failures=1
  # These markers do not all prove the network is off, so the board is asked
  # rather than blamed — otherwise this would fail after the fix, too (#5000).
  elif jus_sandbox_marked && ! jus_board_answers; then
    jus_ui_fail "The board at ${BASE_URL} did not answer from inside this sandbox"
    jus_sandbox_explain
    failures=1
  fi

  jus_doctor_report_codex_agents_md "$project_root"

  choice="$(jus_recorded_ai_tool)"
  if [[ -z "$choice" ]]; then
    if choice="$(jus_doctor_infer_choice "$project_root")"; then
      inferred=1
    else
      jus_ui_note "AI tool: not recorded, and no skills surface to infer from —"
      jus_ui_note "cannot tell whether this project is wired. Re-run"
      jus_ui_note "'${PROG_NAME} init' to record it."
      return "$failures"
    fi
  fi

  if [[ "$inferred" -eq 1 ]]; then
    # #5986. Named, so a wrong inference is visible rather than only its effects.
    jus_ui_note "AI tool: not recorded; inferred $(jus_ai_tool_name "$choice") from what is on disk."
  else
    jus_ui_note "AI tool: $(jus_ai_tool_name "$choice")"
  fi

  case "$(jus_sop_method "$choice")" in
    plugin) jus_doctor_report_plugin "$project_root" || failures=1 ;;
    skills)
      jus_doctor_report_skills "$project_root" "$choice" || failures=1
      jus_doctor_report_bundle || failures=1
      ;;
    *)
      # ⚠️ "Other / skip" HAS NO SKILLS SURFACE BY DESIGN — the SOP is appended
      # to a context file instead, so an absent plugin is correct rather than
      # broken. Reporting a failure here would be the false nag.
      jus_ui_note "This tool loads the SOP from its context file, not from skills."
      ;;
  esac

  # Independent of the skills verdict above: the hooks can be absent while the
  # skills are perfectly installed, and under Cursor that is invisible (#4430).
  if jus_cursor_hook_gap "$project_root"; then
    jus_doctor_report_cursor_gap
    failures=1
  fi

  jus_doctor_report_manifest "$choice" "$project_root" || failures=1

  if [[ "$choice" == "codex" ]]; then
    jus_doctor_report_codex_network "$project_root"
  fi

  return "$failures"
}

# The saved number against the token's (#5047). It used to check only that the
# file existed, so a workspace re-numbered by a transfer read as healthy while
# every workspace command 404ed. Only a board that returns the profile can be
# compared against; anything else keeps the old line and says it did not look.
jus_doctor_report_workspace() {
  local saved token profile check=0
  saved="$(tr -d "[:space:]" < "$WORKSPACE_FILE")"
  if ! token="$(resolve_token 2>/dev/null)"; then
    jus_ui_done "workspace ${saved}"
    return 0
  fi
  if ! profile="$(validate_token "$token" 2>/dev/null)"; then
    jus_ui_done "workspace ${saved}"
    jus_ui_note "Not compared with your token's: the board did not return your profile."
    return 0
  fi
  jus_check_saved_workspace "$profile" || check=$?
  case "$check" in
    0) jus_ui_done "workspace ${saved}" ;;
    1) jus_ui_done "workspace $(tr -d "[:space:]" < "$WORKSPACE_FILE") — ${JUS_WORKSPACE_NOTICE}" ;;
    *)
      jus_ui_fail "workspace ${saved} — ${JUS_WORKSPACE_NOTICE}"
      return 1
      ;;
  esac
}

# A warning, never a failure: a profile or a per-session -c flag can turn the
# network on where no file says so, and Codex can ask to re-run one command
# outside the sandbox. Silent inside ANY Codex sandbox — an offline one already
# failed above, and one that is online proves the setting took (#4982).
jus_doctor_report_codex_network() {
  local project_root="$1"
  [[ -z "${CODEX_SANDBOX:-}" ]] || return 0
  jus_codex_network_enabled "$project_root" && return 0
  jus_ui_warn "Codex's sandbox blocks the network, and no Codex config here turns it on,"
  jus_ui_note "so jus cannot reach the board from inside Codex."
  jus_codex_network_fix
}

# A warning, never a failure: a profile or a -c flag can raise the limit where
# no file says so. Whatever tool the project records, since anyone with Codex
# installed may open it there (#5563). Silent in a project Codex is told not to
# trust, which gets no AGENTS.md at all and so has no cut.
jus_doctor_report_codex_agents_md() {
  local project_root="$1" name="" file size trust own limit origin lines cut raise
  [[ -f "$(jus_codex_config_file)" ]] || command -v codex >/dev/null || return 0
  # Codex reads the override INSTEAD of AGENTS.md when both exist.
  for name in AGENTS.override.md AGENTS.md ""; do
    [[ -z "$name" || -f "${project_root}/${name}" ]] && break
  done
  [[ -n "$name" ]] || return 0
  file="${project_root}/${name}"

  trust="$(jus_codex_project_trust "$project_root")"
  [[ "$trust" != "untrusted" ]] || return 0
  # The project's own config overrides the user's, but only once it is trusted.
  own="$(jus_codex_doc_limit_in "${project_root}/.codex/config.toml")" || own=""
  if [[ -n "$own" && "$trust" == "trusted" ]]; then
    limit="$own" origin=project
  elif limit="$(jus_codex_doc_limit_in "$(jus_codex_config_file)")"; then
    origin=user
  else
    limit="$JUS_CODEX_DOC_LIMIT_DEFAULT" origin=default
  fi

  size="$(wc -c <"$file" | tr -d '[:space:]')"
  (( size > limit )) || return 0
  lines="$(wc -l <"$file" | tr -d '[:space:]')"
  cut=$(( $(head -c "$limit" "$file" | wc -l) + 1 ))
  # The next 32 KiB step with at least 16 KiB to spare, so the warning does
  # not come back on the next few paragraphs.
  raise=$(( (size + 16384 + 32767) / 32768 * 32768 ))

  jus_ui_warn "${name} is ${size} bytes, and Codex reads only the first ${limit}"
  jus_ui_note "It drops the rest without a word: the cut lands on line ${cut} of ${lines}."
  if [[ "$origin" == "project" ]]; then
    jus_ui_note "This project's .codex/config.toml sets it, over yours. Raise it there:"
    jus_ui_cmd "project_doc_max_bytes = ${raise}"
    return 0
  fi
  jus_ui_note "Raise it at the top of $(jus_tilde_path "$(jus_codex_config_file)"), above the first [table]:"
  jus_ui_cmd "project_doc_max_bytes = ${raise}"
  if [[ -n "$own" ]]; then
    jus_ui_note "This project's .codex/config.toml sets ${own}, but Codex reads that file"
    jus_ui_note "only once it trusts this project."
  else
    jus_ui_note "Or commit it to .codex/config.toml, for every machine at once;"
    jus_ui_note "Codex reads that file once it trusts this project:"
    jus_ui_cmd "project_doc_max_bytes = ${raise}"
  fi
}

# ---------------------------------------------------------------------------
# jus remove-hooks — the undo for the hooks install (#4828)
#
# Deletes only the bundle's entries from a tool's hook config and leaves the
# rest of the file alone. "Ours" needs no marker: every bundle command is
# `jus hook …` since #4759, which `jus/hooks/tests.sh` enforces.
#   JSON  inner hooks go, then any group and any event left empty
#   TOML  whole [[hooks]] blocks go (Kimi's ~/.kimi-code/config.toml)
jus_remove_hooks_from() {
  local file="$1" tmp
  [[ -f "$file" ]] || return 0
  tmp="${file}.jus-remove.$$"
  case "$file" in
    *.toml)
      awk '
        function flush() { if (block != "" && !ours) printf "%s", block; block = ""; ours = 0 }
        /^\[\[hooks\]\]/ { flush(); block = $0 "\n"; next }
        block != "" && /^\[/ { flush() }
        block != "" { block = block $0 "\n"; if ($0 ~ /jus hook/) ours = 1; next }
        { print }
        END { flush() }
      ' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
      ;;
    *)
      command -v jq >/dev/null 2>&1 || return 1
      jq '
        def ours: ((.command // .bash // "") | type == "string") and
                  ((.command // .bash // "") | test("(^|/)jus hook "));
        if (.hooks | type) == "object" then
          .hooks |= (with_entries(
              .value |= [ .[]
                | if (.hooks | type) == "array" then .hooks |= map(select(ours | not)) else . end
                | select((((.hooks | type) == "array" and (.hooks | length) == 0) or ours) | not) ]
            ) | with_entries(select(.value | length > 0)))
        else . end
      ' "$file" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
      ;;
  esac
  mv "$tmp" "$file"
  jus_ui_done "Removed the Juscribe enforcement hooks from $(jus_tilde_path "$file")."
}

cmd_remove_hooks() {
  local project_root="$PROJECT_ROOT" choice location
  choice="$(jus_recorded_ai_tool)"
  if [[ -z "$choice" ]]; then
    jus_ui_fail "No AI tool recorded for this project, so there is nothing to find."
    jus_ui_note "Run '${PROG_NAME} init' to record it."
    return 1
  fi
  while IFS= read -r location; do
    [[ -n "$location" && -f "$location" ]] && jus_remove_hooks_from "$location"
  done < <(jus_manifest_locations "$choice" "$project_root")
  return 0
}

# jus refresh-hooks — bring an installed manifest back up to the bundle (#4421)
# ---------------------------------------------------------------------------
#
# ⚠️ IT REFRESHES WHAT IS THERE AND INSTALLS NOTHING. A tool with no manifest is
# `jus init`'s job (#4420); writing one here would guess a destination the
# adapter READMEs do not agree on — Windsurf documents four, Antigravity two,
# Copilot a directory.
#
# ⚠️ ADDITIVE, WHICH IS WHY IT CANNOT DESTROY A HAND EDIT. A registration the
# user added is not in the bundle's set, so nothing removes it. A copy would
# have needed a diff and a prompt; a merge needs neither.
jus_refresh_manifest() {
  local choice="$1" project_root="$2" source installed missing merged staged migrated status=0
  source="$(jus_manifest_source "$choice")" || return 0
  [[ -f "$source" ]] || return 0
  installed="$(jus_installed_manifest "$choice" "$project_root")" || return 0

  # ⚠️ BEFORE THE MERGE (#4759). The merge is additive, so an unmigrated
  # manifest would keep its path-shaped command AND gain the launcher one.
  #
  # ⚠️ AND A FAILED MIGRATION STOPS THE MERGE (#4788). Exit 2 means the rewrite
  # was attempted and could not land; merging on top of a manifest that still
  # holds its old commands is the double-fire this ordering exists to prevent,
  # so the only safe thing left is to say so and stop.
  migrated=0
  jus_migrate_manifest_commands "$installed" || migrated=$?
  if [[ "$migrated" -eq 0 ]]; then
    jus_ui_done "Migrated ${installed} onto '${PROG_NAME} hook' — the bundle's location"
    jus_ui_note "is no longer baked into it."
  elif [[ "$migrated" -eq 2 ]]; then
    jus_ui_fail "Could not rewrite ${installed} — left it untouched." >&2
    jus_ui_note "Check that its directory is writable, then run '${PROG_NAME} refresh-hooks' again." >&2
    return 1
  fi

  # ⚠️ AND THE SOURCE IS MIGRATED TOO, ON A COPY. A clone that predates the
  # launcher still holds path-shaped commands, and the jq merge compares the
  # literal strings — so a migrated manifest would match none of them, every
  # registration would read as missing, and the merge would append a second
  # copy of each. Same double-fire, reached from the other side. The copy is
  # what gets merged FROM, so what lands is the launcher form either way; the
  # clone itself is never written to.
  staged="$(mktemp)" || return 1
  cat "$source" > "$staged"
  jus_migrate_manifest_commands "$staged" || true

  missing="$(jus_manifest_missing "$staged" "$installed")"
  if [[ -z "$missing" ]]; then
    rm -f "$staged"
    jus_ui_done "${installed} is already up to date."
    return 0
  fi

  case "$installed" in
    *.toml) jus_refresh_toml_manifest "$staged" "$installed" "$missing" ;;
    *)
      if merged="$(jus_merge_json_manifest "$staged" "$installed")"; then
        printf '%s\n' "$merged" > "$installed"
      else
        jus_ui_fail "Could not merge ${installed} — left it untouched."
        jus_ui_note "Merge by hand from: ${source}"
        status=1
      fi
      ;;
  esac
  rm -f "$staged"
  [[ "$status" -eq 0 ]] || return 1

  jus_ui_done "Updated ${installed}:"
  jus_ui_note "$(sed 's|^|+ |' <<<"$missing")"
}

# ⚠️ KEYED ON THE COMMAND STRING, the identity the Codex installer has merged
# on since #4239: it is what the tool actually runs, so it is the only thing that can
# tell "already registered" from "registered something that looks similar".
# Normalised on both sides, so a manifest installed from a moved clone is not
# re-registered under its new path.
jus_merge_json_manifest() {
  local source="$1" installed="$2"
  command -v jq >/dev/null 2>&1 || return 1
  jq -s '
    # ⚠️ TWO NORMALISATIONS SINCE #4759, because a manifest can hold either
    # shape: a path-shaped command mid-migration, or a launcher command whose
    # binary someone named absolutely.
    def norm: gsub("[^ ]*/hooks/"; "hooks/") | sub("^[^ ]*/jus hook "; "jus hook");
    def cmd: (.command // .bash) | select(type == "string") | norm;
    # ⚠️ THE IDENTITY IS (EVENT, MATCHER, COMMAND) — NOT THE COMMAND ALONE
    # (#4549). Every adapter registers jus-docs-nudge under two matchers, so a
    # command already installed on the shell matcher is NOT evidence that the
    # edit matcher has it. Comparing commands globally silently drops the second
    # copy; comparing only the group appended the whole group every refresh,
    # which is the defect this replaces.
    def commands_of: [ .. | objects | cmd ];
    # ⚠️ TWO MANIFEST SHAPES SINCE #4804, AND ASSUMING ONE INSTALLED NOTHING AT
    # ALL (#4861). Seven adapters nest every event under `hooks`; Antigravity
    # keys its file by the NAMED HOOK instead — {"jus-hard-rules": {"enabled":
    # true, "PreToolUse": [...]}} — which is the shape `agy` loads. `$want.hooks
    # // {}` was empty for that one, so the reduce below returned the installed
    # file untouched, and jus_install_tool_hooks wrote that `{}` under a line
    # saying twelve registrations had gone in.
    #
    # So the [container, event] paths are READ OFF the manifest rather than
    # assumed. A third shape therefore installs what it can name rather than
    # silently nothing.
    def event_paths:
      if (.hooks | type) == "object"
      then [ .hooks | keys_unsorted[] as $evt | [ "hooks", $evt ] ]
      else . as $m
        | [ $m
            | keys_unsorted[] as $name
            | select(($m[$name] | type) == "object")
            | ($m[$name] | keys_unsorted[]) as $evt
            | select(($m[$name][$evt] | type) == "array")
            | [ $name, $evt ] ]
      end;
    # ⚠️ AND THE KEYS THAT ARE NOT EVENTS COME WITH IT. `enabled: true` sits
    # beside the event arrays inside a named-hook object, so an object rebuilt
    # from its arrays alone is a manifest the tool loads and then ignores —
    # the same silent failure one level down. Installed values win, so this
    # only ever fills a gap; `hooks` is excluded because the shape above owns it
    # and its siblings (`description`, `version`) were never copied.
    def frames($want):
      reduce ($want | to_entries[]
              | select(.key != "hooks")
              | select((.value | type) == "object")) as $named
        (.;
          .[$named.key] = (($named.value | with_entries(select((.value | type) != "array")))
                           + (.[$named.key] // {})));
    # The commands installed under this event beside a group with the same
    # matcher. A group carrying no matcher (BeforeAgent, AfterAgent) matches
    # the installed groups that carry none either, because null == null.
    def known($installed; $matcher):
      [ $installed[] | select(.matcher == $matcher) | commands_of[] ];
    def unknown($installed):
      . as $group
      | (known($installed; $group.matcher)) as $seen
      | if ($group.hooks | type) == "array"
        # ⚠️ `cmd // ""`, NOT `cmd`. An entry carrying no command at all makes
        # `cmd` produce EMPTY, and `select(empty | not)` drops the entry
        # silently — a merge that deletes what it cannot classify. The flat
        # branch below already defaulted; this one did not.
        then ($group | .hooks |= [ .[] | select(((cmd // "") | IN($seen[])) | not) ])
             | select((.hooks | length) > 0)
        else select((($group | cmd // "") | IN($seen[])) | not)
        end;
    (.[0] // {}) as $have
    | (.[1] // {}) as $want
    | reduce ($want | event_paths[]) as $path
        ($have | frames($want);
          (getpath($path) // []) as $installed
          | setpath($path; $installed + [ ($want | getpath($path))[] | unknown($installed) ]))
  ' "$installed" "$source" 2>/dev/null
}

# Kimi's manifest is APPENDED to a config file the user owns, so the refresh
# appends too — the whole `[[hooks]]` block for each missing command.
jus_refresh_toml_manifest() {
  local source="$1" installed="$2" missing="$3" needle
  while IFS= read -r needle; do
    [[ -n "$needle" ]] || continue
    awk -v want="${needle##* }" '
      /^\[\[hooks\]\]/ { block = $0 "\n"; keep = 0; next }
      block != "" { block = block $0 "\n"; if (index($0, want)) keep = 1 }
      /^$/ && block != "" { if (keep) printf "%s", block; block = ""; keep = 0 }
      END { if (block != "" && keep) printf "%s", block }
    ' "$source" >> "$installed"
  done <<<"$missing"
}

# ---------------------------------------------------------------------------
# Installing a tool's enforcement hooks (#4420)
# ---------------------------------------------------------------------------
#
# ⚠️ `jus init` INSTALLED SKILLS FOR EVERY TOOL IN ITS MENU AND HOOKS FOR TWO.
# The skills layer is prompt-level — it works when the model chooses to load a
# skill. The hooks layer is the deterministic half. A user who picked Cursor or
# Qwen, answered every prompt and saw a success line had installed the half that
# sometimes works and not the half that always does, and nothing said so.
#
# ⚠️ IT IS THE #4421 MERGE, NOT SIX INSTALLERS. Three of this ticket's criteria
# fall out of that rather than needing their own code: the merge skips a command
# already present, so a second run cannot double-register; it preserves
# everything else in the file, so Qwen's whole configuration survives; and the
# target is any EXISTING jus manifest wherever it lives, so a second scope is
# never created. There is no copy path, which is why "a copy where a merge
# belongs" is not a mistake this code can make.

# Where a tool's hooks go when none is installed yet. Project scope for every
# tool but Kimi, whose config has no project-level form.
#
# ⚠️ SPELLED OUT RATHER THAN `jus_manifest_locations | head -1`, and Copilot is
# why. Its scan entry is a GLOB — it owns a directory rather than a file — and
# an unmatched glob leaves the literal pattern behind, so the first draft wrote
# a file named `*.json`. The scan tolerates that because it tests each candidate
# with `-f`; a target cannot.
jus_hook_install_target() {
  local choice="$1" project_root="$2"
  case "$choice" in
    cursor) printf '%s\n' "${project_root}/.cursor/hooks.json" ;;
    codex) printf '%s\n' "${project_root}/.codex/hooks.json" ;;
    gemini) printf '%s\n' "${project_root}/.gemini/settings.json" ;;
    # ⚠️ MACHINE SCOPE, LIKE KIMI — and for the same reason: it is the only
    # scope the tool reads (#4771). Every shared script guards on
    # juscribe_sop_require_jus_project, so the hooks no-op outside a jus project.
    copilot) printf '%s\n' "$HOME/.copilot/settings.json" ;;
    windsurf) printf '%s\n' "${project_root}/.windsurf/hooks.json" ;;
    kimi) printf '%s\n' "$HOME/.kimi-code/config.toml" ;;
    qwen) printf '%s\n' "${project_root}/.qwen/settings.json" ;;
    antigravity) printf '%s\n' "$HOME/.gemini/config/hooks.json" ;;
    *) : ;;
  esac
}

# ⚠️ WHICH LINK ANSWERED, NOT JUST WHETHER ONE DID (#4759). Every enforcement
# hook now runs through `jus hook`, which resolves the bundle at run time — so a
# stale clone winning over a brew install, or an override naming nothing, is the
# difference between hooks that enforce and hooks that no-op. Nothing else
# reports it, because a hook that cannot find its bundle fails OPEN and silent.
#
# ⚠️ THE `skills` METHOD ONLY, and that is not a hedge. Claude Code loads the
# same scripts out of the installed plugin through `${CLAUDE_PLUGIN_ROOT}`, so
# a Claude project with no clone at all is correctly wired — failing it here
# would be the false nag `jus_doctor_report_skills` is careful to avoid.
# The numbers #4776 is gated on: what the installed bundle is, what the CLI is,
# and how far behind the bundle has been allowed to get. Silent when the bundle
# carries no version — a diagnostic that cannot read one has nothing to say,
# and the line above already reported the directory.
jus_doctor_report_skew() {
  local bundle="$1" version age
  version="$(jus_bundle_version "$bundle")" || return 0
  if age="$(jus_bundle_age_days "$bundle")"; then
    jus_ui_note "bundle ${version}, CLI $(resolve_client_version) — last pulled ${age} days ago"
    return 0
  fi
  jus_ui_note "bundle ${version}, CLI $(resolve_client_version)"
}

# The X.Y.Z inside a version string, or fail. A leading `v` and a pre-release or
# build suffix are dropped; anything else is unreadable rather than guessed at.
#
# ⚠️ A COPY OF jus/hooks/scripts/lib/cli_floor.sh's juscribe_sop_bare_version,
# and jus_version_older below is its juscribe_sop_version_older. The CLI cannot
# source the bundle's file: a missing bundle is one of the things doctor
# reports. jus_doctor_spec.rb runs one table through both copies.
jus_bare_version() {
  local shape='^v?([0-9]+(\.[0-9]+)*)([-+][0-9A-Za-z.-]*)?$'
  [[ "$1" =~ $shape ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

# 0 when dotted version $1 is older than $2, each part compared as a number, so
# 0.8.9 is older than 0.8.14. A missing part counts as 0; `10#` keeps a leading
# zero from reading as octal.
jus_version_older() {
  local -a have want
  local i a b
  IFS=. read -ra have <<<"$1"
  IFS=. read -ra want <<<"$2"
  for ((i = 0; i < ${#have[@]} || i < ${#want[@]}; i++)); do
    a=$((10#${have[i]:-0}))
    b=$((10#${want[i]:-0}))
    if ((a < b)); then return 0; fi
    if ((a > b)); then return 1; fi
  done
  return 1
}

# This CLI against the bundle's JUS_MIN_VERSION (#5387). Silent when the bundle
# carries no floor, which every bundle before #5080 does.
#
# ⚠️ THE SESSION WARNING CANNOT FIRE WHERE THIS MATTERS. Every adapter but
# Claude Code launches the bundle's floor check through `jus hook`, which a CLI
# too old for the bundle refuses before the check is read, so the hooks fail
# open with nothing said. Doctor runs in the CLI itself and can say it.
jus_doctor_report_floor() {
  local bundle="$1" floor have
  [[ -r "${bundle}/JUS_MIN_VERSION" ]] || return 0
  floor="$(<"${bundle}/JUS_MIN_VERSION")"
  floor="$(jus_bare_version "${floor//[[:space:]]/}")" || return 0
  if ! have="$(jus_bare_version "$(resolve_client_version)")"; then
    jus_ui_note "Cannot read this CLI's version, so the bundle's"
    jus_ui_note "floor (jus ${floor}) was not checked."
    return 0
  fi
  jus_version_older "$have" "$floor" || return 0
  jus_ui_fail "jus ${have} is older than the jus ${floor} this bundle needs"
  jus_ui_note "A hook calling a subcommand this CLI lacks answers"
  jus_ui_note "'Usage: jus <command>' and enforces nothing. Upgrade:"
  jus_ui_cmd "brew upgrade jus"
  return 1
}

jus_doctor_report_bundle() {
  local line
  if line="$(jus_bundle_resolve)"; then
    jus_ui_done "skills bundle at ${line#*$'\t'} — ${line%%$'\t'*}"
    jus_doctor_report_skew "${line#*$'\t'}"
    jus_doctor_report_floor "${line#*$'\t'}"
    return
  fi
  jus_ui_fail "no skills bundle at ${line#*$'\t'} (${line%%$'\t'*})"
  jus_ui_note "Every enforcement hook runs through '${PROG_NAME} hook'"
  jus_ui_note "and fails OPEN without it — nothing is being enforced."
  return 1
}

# ⚠️ EACH ADAPTER'S OWN CAVEAT, NOT A UNIFORM ONE. Qwen has no measured
# degradation (#4263); Cursor and Antigravity are the weakest evidence in the
# bundle and their READMEs say so in their first paragraph; Kimi's is "never
# both this and the plugin". Presenting the six as equivalent would be a claim
# none of those boxes makes.
jus_hook_install_note() {
  case "$1" in
    cursor | windsurf)
      jus_ui_note $'Note: this adapter is NOT live-verified — nothing has been watched refusing\nanything on it. Read hooks/<tool>/README.md before relying on it.'
      ;;
    gemini)
      jus_ui_note $'Note: NOT live-verified. And Gemini CLI has no Stop event — the nearest,\nAfterAgent, RETRIES on deny rather than blocking, so the dirty-tree gate\nmakes the agent keep going rather than stopping it.\nSee hooks/gemini/README.md.'
      ;;
    codex)
      jus_ui_warn "Not enforced yet: run /hooks inside Codex to review and trust them."
      jus_record_needs_you "Run /hooks inside Codex to review and trust the enforcement hooks."
      ;;
    copilot)
      jus_ui_note $'Note: installed at USER scope — ~/.copilot/settings.json — because\nCopilot does not read repo-level hooks (#4771). The guards no-op\noutside a jus project, but they load in every project you open.'
      ;;
    kimi)
      jus_ui_note "Note: do NOT also install the Kimi plugin — the rules would fire twice."
      ;;
    antigravity)
      jus_ui_note $'Note: installed GLOBALLY — ~/.gemini/config/hooks.json — because agy does\nnot load project-level hooks. Verified on the agy CLI only; the\nAntigravity IDE has never been driven. See hooks/antigravity/README.md.'
      ;;
    *) : ;;
  esac
}

# Installs (or tops up) a tool's manifest. Silent and harmless for a tool with
# no adapter in the bundle.
jus_install_tool_hooks() {
  local choice="$1" project_root="$2" source target missing
  source="$(jus_manifest_source "$choice")" || return 0
  [[ -f "$source" ]] || return 0

  # ⚠️ EVERY WRITE HERE IS A MERGE, SO NO jq MEANS NO INSTALL — and a
  # half-written manifest is worse than none. The rest of this file degrades
  # rather than dying when a host tool is missing; so does this, and the Codex
  # installer this replaces did the same since #4239.
  if ! command -v jq >/dev/null 2>&1; then
    jus_ui_fail "Enforcement hooks not installed: jq is required to merge the manifest safely."
    jus_ui_note "Install jq and re-run, or merge by hand from:"
    jus_ui_cmd "${source}"
    return 0
  fi

  # ⚠️ AN EXISTING MANIFEST WINS, WHEREVER IT IS. That is the one-scope rule
  # enforced rather than documented: installing at both scopes fires every hook
  # twice per event.
  if ! target="$(jus_installed_manifest "$choice" "$project_root")"; then
    target="$(jus_hook_install_target "$choice" "$project_root")"
    [[ -n "$target" ]] || return 0
    mkdir -p "$(dirname "$target")"
    [[ -f "$target" ]] || case "$target" in
      *.toml) : > "$target" ;;
      *) echo '{}' > "$target" ;;
    esac
  fi

  missing="$(jus_manifest_missing "$source" "$target")"
  if [[ -z "$missing" ]]; then
    jus_ui_done "Enforcement hooks already registered in ${target}."
    jus_hook_install_note "$choice"
    return 0
  fi

  case "$target" in
    *.toml) jus_refresh_toml_manifest "$source" "$target" "$missing" ;;
    *)
      local merged
      merged="$(jus_merge_json_manifest "$source" "$target")" || {
        jus_ui_fail "Enforcement hooks NOT installed: could not merge ${target}."
        jus_ui_note "Left it untouched. Merge by hand from: ${source}"
        return 1
      }
      printf '%s\n' "$merged" > "$target"
      ;;
  esac

  jus_ui_done "Installed the Juscribe enforcement hooks into ${target}."
  jus_record_setup_action "Installed the enforcement hooks into $(jus_tilde_path "$target") — undo with: ${PROG_NAME} remove-hooks"
  jus_hook_install_note "$choice"
}

# ⚠️ SAYS WHICH HALF WENT IN WHEN ONLY ONE DID. A success line covering the
# skills alone is the failure this ticket is about.
jus_offer_tool_hooks() {
  local choice="$1" project_root="$2" tool="$3"
  local source
  source="$(jus_manifest_source "$choice")" || return 0

  # ⚠️ NO CLONE AND NO ADAPTER ARE DIFFERENT FAILURES, AND THIS BRANCH
  # REPORTED BOTH AS THE SECOND (#4755). The manifest lives INSIDE the clone, so
  # a declined clone makes every tool look like it has no adapter — while the
  # skills, which are symlinks into that same clone, did not install either. The
  # old message said "Skills installed", named the tool as the one lacking an
  # adapter, and claimed the prompt-level half was in place. None of it was true.
  if [[ ! -d "$(jus_bundle_clone_dir)" ]]; then
    jus_ui_fail "Nothing was installed — the skills bundle was not cloned."
    jus_ui_note $'That is both halves: no skills, no enforcement hooks.\nGet them with:'
    jus_print_bundle_link_hint "$choice"
    return 0
  fi

  if [[ ! -f "$source" ]]; then
    jus_ui_warn "Skills installed. Enforcement hooks NOT installed — the clone carries no"
    jus_ui_note "adapter manifest for ${tool}. Only the prompt-level half is in place."
    return 0
  fi

  jus_ui_note "${tool} also runs the enforcement hooks — the deterministic half of the SOP."
  jus_install_tool_hooks "$choice" "$project_root"
}

# ---------------------------------------------------------------------------
# Subcommand: hook — run a bundle hook, wherever the bundle is (#4759)
# ---------------------------------------------------------------------------
#
#   jus hook <name>                              a shared script
#   jus hook --adapt <tool> <name>               through that tool's adapter
#   jus hook --adapt antigravity --event E <n>   antigravity takes the event first
#   jus hook <tool>/<name>                       a script only that tool has
#   jus hook --where                             which chain link answered
#
# ⚠️ IT FAILS OPEN, AND THAT IS NOT A SOFTENING. Every adapter reads a non-2
# exit as permission, so a launcher that cannot find its bundle has no way to
# block: exiting 127 and exiting 0 are the same permission with different
# legibility. What it can do is SAY so, which 127 does not. A fail-closed mode
# would block every commit on a machine whose clone is missing — including the
# machine of someone who has never installed the bundle at all.

# One place, so the wording and the exit code cannot drift apart.
jus_hook_fail_open() {
  echo "${PROG_NAME} hook: $1" >&2
  echo "${PROG_NAME} hook: nothing was enforced for this event." >&2
  return 0
}

jus_hook_where() {
  local line
  if line="$(jus_bundle_resolve)"; then
    printf '%s  (%s)\n' "${line#*$'\t'}" "${line%%$'\t'*}"
    return 0
  fi
  printf '%s  (%s) — not present\n' "${line#*$'\t'}" "${line%%$'\t'*}" >&2
  return 1
}

# ⚠️ `exec`, SO THE HOOK IS THE PROCESS. stdin, stdout, stderr and the exit
# code then pass through because there is nothing left in the middle to relay
# them — and a hook's exit code IS its verdict, so a launcher that relayed the
# wrong one would turn every deny into an allow.
jus_hook_exec() {
  local target="$1"
  shift
  if [[ -x "$target" ]]; then
    exec "$target" "$@"
  fi
  # A clone made with a restrictive umask, or a bundle unpacked from an archive
  # that dropped the mode bits. Running it under bash beats exit 126.
  exec bash "$target" "$@"
}

cmd_hook() {
  local adapt="" event="" ref="" line bundle script adapter

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --where) jus_hook_where; return ;;
      # ⚠️ THE COUNT IS CHECKED BEFORE THE SHIFT, AND THAT IS NOT DEFENSIVE
      # TIDYING (#4789). This file is `set -euo pipefail`, and `shift 2` returns
      # non-zero when the count exceeds `$#` — so `jus hook --adapt` with no
      # value ended the shell right here, with nothing on either stream. Exit 1
      # is permission to every adapter exactly as exit 0 is, so the silence was
      # the whole of the defect: the one path built to SAY it could not enforce
      # anything was the one path that could not reach the message.
      --adapt | --event)
        [[ $# -ge 2 ]] || { jus_hook_fail_open "$1 needs a value"; return 0; }
        if [[ "$1" == "--adapt" ]]; then adapt="$2"; else event="$2"; fi
        shift 2
        ;;
      --) shift; break ;;
      # #5080: an option this CLI does not know is most likely one a newer
      # bundle passes, so the reply names the upgrade too.
      -*) jus_hook_fail_open "unknown option $1 — the plugin may need a newer ${PROG_NAME}: brew upgrade jus"; return 0 ;;
      *) ref="$1"; shift; break ;;
    esac
  done

  # ⚠️ A REF MAY NOT CLIMB OUT OF THE BUNDLE (#4789). This is not a privilege
  # boundary — a manifest that can write `jus hook ../../x` can already write
  # `bash ./x`, so an attacker gains nothing by the escape. It is the invariant
  # `jus_bundle_resolve` rests on: a committed manifest may NAME a guard script
  # and may never SUPPLY one, which is the stated reason a project copy is not a
  # link in the chain. Without this the sentence is only nearly true.
  case "$ref" in
    .. | ../* | */.. | */../*)
      jus_hook_fail_open "hook name resolves outside the bundle: ${ref}"
      return 0
      ;;
  esac

  if [[ -z "$ref" ]]; then
    jus_hook_fail_open "no hook named — usage: ${PROG_NAME} hook [--adapt <tool>] [--event <e>] <name>"
    return 0
  fi

  line="$(jus_bundle_resolve)" || {
    jus_hook_fail_open "no skills bundle at ${line#*$'\t'}"
    return 0
  }
  bundle="${line#*$'\t'}"

  case "$ref" in
    */*) script="${bundle}/hooks/${ref%/*}/scripts/${ref##*/}.sh" ;;
    *) script="${bundle}/hooks/scripts/${ref}.sh" ;;
  esac
  [[ -f "$script" ]] || {
    jus_hook_fail_open "no hook script ${ref} in ${bundle}"
    return 0
  }

  if [[ -z "$adapt" ]]; then
    jus_hook_exec "$script" "$@"
  fi

  adapter="$(jus_hook_adapter_file "$adapt")" || {
    jus_hook_fail_open "no adapter for ${adapt}"
    return 0
  }
  adapter="${bundle}/hooks/${adapt}/scripts/${adapter}"
  [[ -f "$adapter" ]] || {
    jus_hook_fail_open "no ${adapt} adapter in ${bundle}"
    return 0
  }

  if [[ -n "$event" ]]; then
    jus_hook_exec "$adapter" "$event" "$script" "$@"
  fi
  jus_hook_exec "$adapter" "$script" "$@"
}

cmd_refresh_hooks() {
  local project_root="$PROJECT_ROOT" choice
  choice="$(jus_recorded_ai_tool)"
  if [[ -z "$choice" ]]; then
    choice="$(jus_doctor_infer_choice "$project_root")" || {
      jus_ui_fail "No AI tool recorded for this project, and none inferable."
      jus_ui_note "Run '${PROG_NAME} init' to record it."
      return 1
    }
  fi
  jus_refresh_manifest "$choice" "$project_root"
}

cmd_init() {
  # When installed via Homebrew, JUS_DIR points to the brew prefix.
  # Override to use the current working directory as the project root.
  local init_project_root="$PWD"
  local init_jus_dir="${init_project_root}/.jus"
  local init_config_dir="${init_jus_dir}/config"
  local init_token_file="${init_config_dir}/api_token.txt"
  local init_workspace_file="${init_config_dir}/workspace_id"
  local init_org_file="${init_config_dir}/organization_id"
  mkdir -p "$init_config_dir"
  jus_scaffold_docs_dir "$init_project_root"

  jus_ui_banner "Juscribe Setup"
  jus_ui_note "Project: $init_project_root"

  # Five steps, and each header is printed HERE, not by the helper it calls
  # (#4838): a step the token or the machine already answers keeps its number
  # and shows the answer and where it came from, because "of 5" is on screen
  # before it is known which steps have anything to ask.

  # --- Step 1: Project — a git repository (#1907), before the token save, so
  #     the .gitignore guard (#1924) applies the moment the token lands ---
  echo ""
  jus_ui_step 1 5 "Project"
  jus_offer_git_init "$init_project_root"

  # --- Step 2: API token ---
  echo ""
  jus_ui_step 2 5 "API token"
  local token="" user_json="" validate_status=0
  if [[ -n "${JUSCRIBE_API_TOKEN:-}" ]]; then
    token="$JUSCRIBE_API_TOKEN"
    jus_ui_done "Found JUSCRIBE_API_TOKEN in environment."
  elif [[ -f "$init_token_file" ]]; then
    token=$(cat "$init_token_file")
    jus_ui_done "Found existing token in .jus/config/api_token.txt."
  fi

  if [[ -n "$token" ]]; then
    jus_ui_note "Validating existing token..."
    validate_status=0
    user_json=$(validate_token "$token") || validate_status=$?
    if (( validate_status == 2 )); then
      # Not "your token is bad, paste another" — the next one would fail
      # identically, since nothing here has reached the server (#4520).
      unreachable_message >&2
      exit 1
    elif (( validate_status != 0 )); then
      jus_ui_fail "Existing token is invalid."
      token=""
    else
      jus_ui_done "Authenticated as: $(json_val "$user_json" '.user.name')"
      # What the token carries, before the decision to keep it (#4838).
      jus_describe_token "$user_json"
      jus_ui_ask --default Yes "Use this token? [Y/n]"
      if [[ "$JUS_UI_ANSWER" =~ ^[Nn] ]]; then
        token=""
      fi
    fi
  fi

  # #4576. The browser first, as `jus login` does, and the pasted token only
  # where the server offers no browser sign-in or it did not finish.
  if [[ -z "$token" ]]; then
    local init_sign_in=0
    jus_browser_sign_in || init_sign_in=$?
    if (( init_sign_in == 0 )); then
      token="$JUS_SIGNED_IN_TOKEN"
    elif (( init_sign_in != 3 )); then
      jus_ui_note "The browser sign-in did not finish, so paste a token instead."
    fi
  fi

  if [[ -z "$token" ]]; then
    jus_ui_note "Create an agent token at: $(agent_tokens_page)"
    jus_ui_ask --secret "Paste your API token:"
    token="$JUS_UI_ANSWER"

    if [[ -z "$token" ]]; then
      jus_ui_fail "Error: No token provided. Aborting." >&2
      exit 1
    fi

    jus_ui_note "Validating..."
    validate_status=0
    user_json=$(validate_token "$token") || validate_status=$?
    if (( validate_status == 2 )); then
      unreachable_message >&2
      exit 1
    elif (( validate_status != 0 )); then
      jus_ui_fail "Error: Invalid token — could not authenticate." >&2
      exit 1
    fi

    jus_ui_done "Authenticated as: $(json_val "$user_json" '.user.name')"
    jus_describe_token "$user_json"
  fi

  # Save token
  mkdir -p "$init_config_dir"
  printf '%s' "$token" > "$init_token_file"
  chmod 600 "$init_token_file"
  jus_ui_done "Token saved."
  jus_record_setup_action $'Saved your API token to .jus/config/api_token.txt,\nkept out of git by .gitignore — undo with: rm .jus/config/api_token.txt'
  jus_ensure_gitignore "$init_project_root"

  # --- Step 3: Workspace — from the token when the token names one (#4838),
  #     else listed and asked ---
  echo ""
  jus_ui_step 3 5 "Workspace"
  local ws_id ws_name scoped_org_id scoped_org_name
  ws_id="$(jus_json_field "$user_json" '.token_scope.workspace_id')"
  if [[ -n "$ws_id" ]]; then
    # ⚠️ NO /workspaces LIST AND NO ORGANIZATION PROBE: /profile already said
    # which workspace and which organization the token is for.
    ws_name="$(jus_json_field "$user_json" '.token_scope.workspace_name')"
    scoped_org_id="$(jus_json_field "$user_json" '.token_scope.organization_id')"
    scoped_org_name="$(jus_json_field "$user_json" '.token_scope.organization_name')"
    printf '%s' "$ws_id" > "$init_workspace_file"
    jus_ui_done "Workspace saved: ${ws_name} (id: ${ws_id}), from your token"
    jus_record_setup_action "Connected this project to the workspace ${ws_name} — undo with: rm -f .jus/config/workspace_id .jus/config/organization_id"
    if [[ -n "$scoped_org_id" ]]; then
      printf '%s' "$scoped_org_id" > "$init_org_file"
      jus_ui_done "Organization saved: ${scoped_org_name}, from your token"
    fi
  else
    jus_ui_note "Fetching your workspaces..."
    local ws_response
    ws_response=$(curl -s \
      -K <(jus_curl_auth "$token") \
      -H "Accept: application/json" \
      "${BASE_URL}/api/v1/workspaces")

    local ws_count
    if command -v jq &>/dev/null; then
      ws_count=$(echo "$ws_response" | jq '.workspaces | length')
    elif command -v python3 &>/dev/null; then
      ws_count=$(echo "$ws_response" | python3 -c "import sys,json; print(len(json.load(sys.stdin)['workspaces']))")
    else
      ws_count="unknown"
    fi

    if [[ "$ws_count" == "0" ]]; then
      jus_ui_warn "No workspaces found. You may need to be invited to an organization first."
      jus_record_skipped "Workspace: none found — you may need to be invited to an organization first"
    elif [[ "$ws_count" == "1" ]]; then
      if command -v jq &>/dev/null; then
        ws_id=$(echo "$ws_response" | jq -r '.workspaces[0].id')
        ws_name=$(echo "$ws_response" | jq -r '.workspaces[0].name')
      else
        ws_id=$(echo "$ws_response" | python3 -c "import sys,json; print(json.load(sys.stdin)['workspaces'][0]['id'])")
        ws_name=$(echo "$ws_response" | python3 -c "import sys,json; print(json.load(sys.stdin)['workspaces'][0]['name'])")
      fi
      jus_ui_done "Found workspace: $ws_name (id: $ws_id)"
      printf '%s' "$ws_id" > "$init_workspace_file"
      jus_ui_done "Workspace saved."
      jus_record_setup_action "Connected this project to the workspace ${ws_name} — undo with: rm -f .jus/config/workspace_id .jus/config/organization_id"
    else
      jus_ui_note "Available workspaces:"
      if command -v jq &>/dev/null; then
        jus_ui_note "$(echo "$ws_response" | jq -r '.workspaces | to_entries[] | "  \(.key + 1)) \(.value.name) (id: \(.value.id))"')"
      elif command -v python3 &>/dev/null; then
        jus_ui_note "$(echo "$ws_response" | python3 -c "
import sys, json
ws = json.load(sys.stdin)['workspaces']
for i, w in enumerate(ws):
    print(f'  {i+1}) {w[\"name\"]} (id: {w[\"id\"]})')
")"
      fi

      # The number is mapped before the answer line, so it can say the name.
      jus_ui_ask --quiet "Select workspace [1-${ws_count}]:"
      local ws_choice="$JUS_UI_ANSWER"
      if [[ -z "$ws_choice" ]] || ! [[ "$ws_choice" =~ ^[0-9]+$ ]] || [[ "$ws_choice" -lt 1 ]] || [[ "$ws_choice" -gt "$ws_count" ]]; then
        jus_ui_answer "${ws_choice:-(nothing entered)}"
        jus_ui_warn "Invalid selection. Skipping workspace setup."
        jus_record_skipped "Workspace: no valid selection"
      else
        local idx=$((ws_choice - 1))
        if command -v jq &>/dev/null; then
          ws_id=$(echo "$ws_response" | jq -r ".workspaces[$idx].id")
          ws_name=$(echo "$ws_response" | jq -r ".workspaces[$idx].name")
        else
          # The index rides argv rather than the program text (#5067): it is a
          # checked integer, and a reader should not have to find the check.
          ws_id=$(echo "$ws_response" | python3 -c "import sys,json; print(json.load(sys.stdin)['workspaces'][int(sys.argv[1])]['id'])" "$idx")
          ws_name=$(echo "$ws_response" | python3 -c "import sys,json; print(json.load(sys.stdin)['workspaces'][int(sys.argv[1])]['name'])" "$idx")
        fi
        jus_ui_answer "$ws_name (id: $ws_id)"
        printf '%s' "$ws_id" > "$init_workspace_file"
        jus_ui_done "Workspace saved."
        jus_record_setup_action "Connected this project to the workspace ${ws_name} — undo with: rm -f .jus/config/workspace_id .jus/config/organization_id"
      fi
    fi

    # --- Step 3a: Resolve and store organization_id ---
    if [[ -f "$init_workspace_file" ]]; then
      jus_ui_note "Resolving organization..."
      local session_response
      session_response=$(curl -s \
        -K <(jus_curl_auth "$token") \
        -H "Accept: application/json" \
        "${BASE_URL}/api/v1/session")

    local org_id=""
    if command -v jq &>/dev/null; then
      local org_count
      org_count=$(echo "$session_response" | jq '.organizations | length')
      if [[ "$org_count" == "1" ]]; then
        org_id=$(echo "$session_response" | jq -r '.organizations[0].id')
      elif [[ "$org_count" -gt 1 ]]; then
        # Multi-org: probe each org to find which owns the workspace
        local stored_ws_id_for_org
        stored_ws_id_for_org=$(cat "$init_workspace_file")
        for i in $(seq 0 $((org_count - 1))); do
          local candidate_org
          candidate_org=$(echo "$session_response" | jq -r ".organizations[$i].id")
          local probe_status
          probe_status=$(curl -s -o /dev/null -w "%{http_code}" \
            -K <(jus_curl_auth "$token") \
            -H "Accept: application/json" \
            -H "X-Organization-Id: $candidate_org" \
            "${BASE_URL}/api/v1/workspaces/${stored_ws_id_for_org}?fields=name")
          if [[ "$probe_status" == "200" ]]; then
            org_id="$candidate_org"
            break
          fi
        done
        # Fallback to first org if no match
        if [[ -z "$org_id" ]]; then
          org_id=$(echo "$session_response" | jq -r '.organizations[0].id')
        fi
      fi
    elif command -v python3 &>/dev/null; then
      # The token arrives on stdin: an argument would put it in python3's argv,
      # which `ps` shows every local user. printf rather than a here-string,
      # which appends a newline (an invalid header value) and, before bash 5.1,
      # goes through a temporary file.
      org_id=$(printf '%s' "$token" | python3 -c "
import sys, json, urllib.request
data = json.loads(sys.argv[1])
orgs = data.get('organizations', [])
if len(orgs) == 0:
    print('')
elif len(orgs) == 1:
    print(orgs[0]['id'])
else:
    # Multi-org: probe each org to find which owns the workspace
    ws_id = sys.argv[2]
    base_url = sys.argv[3]
    token = sys.stdin.read()
    found = ''
    for org in orgs:
        try:
            req = urllib.request.Request(
                base_url + '/api/v1/workspaces/' + ws_id + '?fields=name',
                headers={
                    'Authorization': 'Bearer ' + token,
                    'Accept': 'application/json',
                    'X-Organization-Id': str(org['id']),
                },
            )
            resp = urllib.request.urlopen(req, timeout=10)
            if resp.status == 200:
                found = str(org['id'])
                break
        except Exception:
            continue
    print(found if found else str(orgs[0]['id']))
" "$session_response" "$(cat "$init_workspace_file")" "$BASE_URL" 2>/dev/null)
    fi

      if [[ -n "$org_id" ]]; then
        printf '%s' "$org_id" > "$init_org_file"
        jus_ui_done "Organization saved."
      fi
    fi
  fi

  # --- Step 3b: Display workspace description ---
  if [[ -f "$init_workspace_file" ]]; then
    local stored_ws_id
    stored_ws_id=$(cat "$init_workspace_file")
    local desc_response
    desc_response=$(curl -s \
      -K <(jus_curl_auth "$token") \
      -H "Accept: application/json" \
      "${BASE_URL}/api/v1/workspaces/${stored_ws_id}?fields=description")

    local ws_description=""
    if command -v jq &>/dev/null; then
      ws_description=$(echo "$desc_response" | jq -r '.workspace.description // empty')
    elif command -v python3 &>/dev/null; then
      ws_description=$(echo "$desc_response" | python3 -c "import sys,json; d=json.load(sys.stdin).get('workspace',{}).get('description',''); print(d or '')" 2>/dev/null)
    fi

    # Text from the server is printed indented and left to the terminal to
    # wrap — nothing here folds it (#4838).
    if [[ -n "$ws_description" ]]; then
      jus_ui_note "Workspace description:"
      jus_ui_note "  $ws_description"
      jus_ui_note "Tip: Include this description in your AI agent context file"
      jus_ui_note "     (e.g. AGENTS.md) so your agent understands the project."
    fi
  fi

  # --- Step 4: Command line — a bin/jus symlink, skipped when jus is already
  #     on PATH (e.g. via Homebrew) ---
  echo ""
  jus_ui_step 4 5 "Command line"
  if command -v jus &>/dev/null; then
    jus_ui_done "jus is already on PATH ($(command -v jus)). Skipping symlink."
    jus_record_skipped "Linking bin/jus: jus is already on PATH"
  else
    local bin_dir="${init_project_root}/bin"
    local symlink_path="${bin_dir}/jus"
    local target="../.jus/bin/jus"

    if [[ -L "$symlink_path" ]]; then
      jus_ui_done "Symlink already exists: bin/jus"
    elif [[ -f "$symlink_path" ]]; then
      jus_ui_warn "Warning: bin/jus exists but is not a symlink. Skipping."
      jus_record_skipped "Linking bin/jus: a file is already there, and it is not a symlink"
    else
      jus_ui_ask --default Yes "Create symlink bin/jus → .jus/bin/jus? [Y/n]"
      if [[ ! "$JUS_UI_ANSWER" =~ ^[Nn] ]]; then
        mkdir -p "$bin_dir"
        ln -sf "$target" "$symlink_path"
        jus_ui_done "Created: bin/jus → .jus/bin/jus"
        jus_record_setup_action "Linked bin/jus → .jus/bin/jus — undo with: rm bin/jus"
      else
        jus_ui_note "Skipped. You can run the CLI directly: .jus/bin/jus"
        jus_record_skipped "Linking bin/jus: declined — run the CLI directly: .jus/bin/jus"
      fi
    fi
  fi

  # --- Step 5: AI tool (menu gated on the server flag, #1996) ---
  # The token's own tool answers it when that was picked (#4814).
  echo ""
  jus_ui_step 5 5 "AI tool"
  local llm_choice
  llm_choice="$(jus_choose_ai_tool "$user_json")"

  local context_file="" tool_name=""
  context_file="$(jus_init_context_file "$llm_choice" "$init_project_root")"
  if [[ -n "$context_file" ]]; then
    tool_name="$(jus_ai_tool_name "$llm_choice")"
  else
    jus_ui_note $'Skipping LLM integration. You can manually add a Juscribe section to your AI\ncontext file later.'
    jus_record_skipped "AI tool: none chosen, so no SOP was set up"
  fi

  # ⚠️ RECORDED IN EVERY PATH, INCLUDING THE ONE NOBODY WAS ASKED ABOUT (#4508).
  # jus_select_ai_tool returns `claude` without prompting when the provider menu is
  # gated off, and a recorded `claude` there is the truth rather than a guess — it is
  # what this project was actually set up for.
  mkdir -p "$init_config_dir"
  printf '%s\n' "$llm_choice" > "${init_config_dir}/ai_tool"
  jus_record_setup_action "Set this project up for $(jus_ai_tool_name "$llm_choice") — undo with: rm .jus/config/ai_tool"

  # For skills-capable tools, offer the bundle install (recommended) instead of
  # appending the full SOP to the context file. Skill-less tools fall through to
  # the append below (their only path). Avoids carrying the SOP twice.
  local do_append=1 sop_method
  sop_method="$(jus_sop_method "$llm_choice")"
  if [[ -n "$context_file" ]] && [[ "$sop_method" != "fallback" ]]; then
    local hooks_note=""
    [[ "$sop_method" == "plugin" ]] && hooks_note=" + hooks"
    local init_ws_id=""
    [[ -f "$init_workspace_file" ]] && init_ws_id=$(cat "$init_workspace_file")

    # Committed bundle copy (#2195): the repo already serves the skills and
    # hooks itself — never declare the plugin on top of it (#1846).
    if [[ "$sop_method" == "plugin" ]] && jus_committed_bundle_present "$init_project_root"; then
      jus_print_committed_copy_skip
      do_append=0
    # Already-installed plugin: verify instead of re-prompting (#1922).
    elif [[ "$sop_method" == "plugin" ]] && jus_plugin_installed "$init_project_root"; then
      jus_ui_done "jus@jus-skills plugin already installed for Claude Code."
      jus_warn_machine_wide_plugin
      jus_remove_claude_bridge "$init_project_root"
      # A plugin installed user-level still leaves this project's settings bare
      # (#1923) — ensure the project declares the marketplace + plugin so the
      # config travels with the repo. Best-effort: skipped without jq.
      jus_write_claude_plugin_settings "$init_project_root" || true
      jus_warn_legacy_sop_block "$init_project_root" "$context_file" "the plugin" "$llm_choice"
      [[ -n "$init_ws_id" ]] && jus_close_plugin_chore "$init_config_dir" "$token" "$init_ws_id"
      do_append=0
    else
      # ⚠️ THE QUESTION KEEPS ITS TEXT AND STAYS ABOVE ITS OPTIONS:
      # onboarding_sop_question_parity_spec.rb reads both off this source, and
      # the onboarding page quotes the two answers word for word.
      jus_ui_note "${tool_name} supports the Juscribe skill bundle."
      jus_ui_question "How do you want the SOP?"
      jus_ui_note "  1) Install the bundle (recommended — skills${hooks_note})" >&2
      jus_ui_note "  2) Append the SOP to ${context_file} (legacy)" >&2
      jus_ui_ask --quiet --under "Select [1-2]:"
      local sop_choice="$JUS_UI_ANSWER" sop_answer="Install the bundle"
      if [[ "$sop_choice" != "2" ]]; then
        [[ -z "$sop_choice" ]] && sop_answer+=" (default)"
      else
        sop_answer="Append the SOP to ${context_file}"
      fi
      jus_ui_answer "$sop_answer"
      if [[ "$sop_choice" != "2" ]]; then
        if [[ "$sop_method" == "plugin" ]]; then
          # Write the declaration first (#1923) — it is the record that travels
          # with the repo, and it registers the marketplace for teammates. It is
          # NOT an install, which is what #3565 corrected: the settings write
          # used to decide this branch, so a machine with jq reported success
          # having installed nothing. The INSTALL decides it now.
          jus_write_claude_plugin_settings "$init_project_root" || true
          if jus_offer_plugin_install "$init_project_root"; then
            [[ -n "$init_ws_id" ]] && jus_close_plugin_chore "$init_config_dir" "$token" "$init_ws_id"
          else
            jus_print_bundle_install "$llm_choice" "$tool_name"
            # The /plugin install can be arbitrarily far away — bridge the gap
            # so the SOP is usable meanwhile (#2197). The verify re-run this
            # path instructs is the guaranteed handoff moment.
            jus_install_claude_bridge "$init_project_root"
            [[ -n "$init_ws_id" ]] && jus_offer_plugin_chore "$init_config_dir" "$token" "$init_ws_id"
          fi
        else
          # ⚠️ EVERY ADAPTER, NOT JUST CODEX (#4420). This branch installed
          # hooks for choice 3 alone and said in terms that it was "not the
          # start of a general hook installer". It is one now: the skills layer
          # is prompt-level and the hooks layer is the deterministic half, so a
          # run that installs only the first has installed the half that
          # sometimes works. Both halves are in jus_install_tool_skills.
          jus_install_tool_skills "$llm_choice" "$init_project_root" "$tool_name" "$context_file"
        fi
        do_append=0
      fi
    fi
  fi

  if [[ -n "$context_file" ]] && [[ "$do_append" -eq 1 ]]; then
    local full_path="${init_project_root}/${context_file}" carrier=""
    local sop_path="${init_jus_dir}/SOP.md"

    # Download SOP from the API if not present locally
    if [[ ! -f "$sop_path" ]] && [[ -f "$init_workspace_file" ]]; then
      local ws_id_for_sop
      ws_id_for_sop=$(cat "$init_workspace_file")
      jus_ui_note "Downloading SOP from workspace..."
      local sop_http_code
      sop_http_code=$(curl -s -o "${sop_path}.tmp" -w "%{http_code}" \
        -K <(jus_curl_auth "$token") \
        -H "Accept: text/markdown" \
        "${BASE_URL}/api/v1/workspaces/${ws_id_for_sop}/sop")
      if [[ "$sop_http_code" == "200" ]] && [[ -s "${sop_path}.tmp" ]]; then
        mkdir -p "$(dirname "$sop_path")"
        mv "${sop_path}.tmp" "$sop_path"
        jus_ui_done "Downloaded SOP to .jus/SOP.md"
        jus_record_setup_action "Downloaded the Juscribe SOP to .jus/SOP.md — undo with: rm .jus/SOP.md"
      else
        rm -f "${sop_path}.tmp"
      fi
    fi

    if [[ ! -f "$sop_path" ]]; then
      jus_ui_warn "Warning: SOP file not found at .jus/SOP.md. Skipping LLM integration."
      jus_ui_note "You can download it later with:"
      jus_ui_cmd "jus api GET /workspaces/<id>/sop"
      jus_record_skipped "The SOP: .jus/SOP.md was not found and could not be downloaded"
    elif carrier="$(jus_legacy_sop_carrier "$llm_choice" "$init_project_root" "$context_file")"; then
      if [[ "$carrier" == /* ]]; then
        # ⚠️ A FILE THIS PROJECT DOES NOT OWN (#4970): it is never edited, and
        # the summary names it, so the package's reliance on it is visible.
        carrier="$(jus_tilde_path "$carrier")"
        jus_ui_done "${carrier}, in a folder above, carries the Juscribe SOP,"
        jus_ui_note "and Claude Code reads it here too, so none is written."
        jus_record_skipped "The SOP: ${carrier}, in a folder above, carries it."$'\n'"If that copy is removed, run ${PROG_NAME} init here again."
      else
        jus_ui_done "Juscribe SOP already exists in ${carrier}. Skipping."
      fi
    elif [[ -f "$full_path" ]]; then
      # Append full SOP content to existing file
      jus_warn_sop_size "$sop_path" "$llm_choice" "$context_file"
      { printf '\n\n---\n\n'; cat "$sop_path"; } >> "$full_path"
      jus_ui_done "Appended Juscribe SOP to ${context_file}."
      jus_record_setup_action "Appended the Juscribe SOP to ${context_file} — undo by deleting it from the line '# Juscribe Workflow SOP' down"
    else
      # Create new file with SOP content (ensure parent directory exists)
      jus_warn_sop_size "$sop_path" "$llm_choice" "$context_file"
      mkdir -p "$(dirname "$full_path")"
      cp "$sop_path" "$full_path"
      jus_ui_done "Created ${context_file} with Juscribe SOP."
      jus_record_setup_action "Created ${context_file} with the Juscribe SOP — undo with: rm ${context_file}"
    fi

    # Claude Code reads AGENTS.md by itself only while the project has no
    # CLAUDE.md family file; beside one, an import line in that file is what
    # makes the SOP reachable (#4866).
    if [[ "$llm_choice" == "claude" ]] && jus_sop_block_present "$full_path"; then
      jus_claude_import_agents_md "$init_project_root" "$context_file"
    fi
  fi

  # --- After the five steps: record the dispatch CLI, silently ---
  #
  # ⚠️ IT DOES NOT ASK, WHATEVER `provider_selection` SAYS (#4802). Which CLI a
  # dispatch runs is a dispatch question, the same reasoning that took the old
  # Steps 6 and 7 out below. The prompt ran even after "Other / skip" and
  # listed Codex whatever its per-brand flag said. Only `dispatch/` reads this
  # file, and `jus switch` is where it is changed.
  local cli_provider_file="${init_config_dir}/cli_provider"
  printf '%s' "claude" > "$cli_provider_file"

  # ⚠️ THE WIZARD ENDS HERE, AND THE TWO MISSING STEPS ARE BOTH DELIBERATE.
  #
  # The old Step 6 reported where `jus-dispatch` was installed, or printed
  # `brew install juscribe/tap/jus`. It ran unconditionally, so every `jus init`
  # ended by telling the reader how to install the agent — the loudest
  # advertisement in this file, and it went with the feature (#3987). The
  # binary stays published for whoever already has it; nothing here points at it.
  #
  # The old Step 7 shelled out to `jus-dispatch setup-sandbox`. #4243 restored
  # it and then took it back out the same day (stakeholder ruling, 2026-09-15),
  # for a reason worth keeping: `jus init` is GENERIC PROJECT SETUP — it
  # scaffolds `.jus/`, offers `git init`, validates a token, records the
  # workspace. A sandbox is a DISPATCH concern, and putting it here showed a
  # full-screen disclosure about OrbStack, Docker, bare Ubuntu and network
  # egress to everyone who merely wanted `jus api` in their project.
  #
  # ⚠️ AND IT NEVER ASKED FIRST. The function was called `..._prompt` and offered
  # no yes/no gate — it went straight into the chooser, whose risk step requires
  # a literal `agree`. Pressing Enter through it ended in a refusal. Optional in
  # principle, mandatory in flow.
  #
  # Setting up dispatch is its own path, taken once a workspace exists. The
  # sandbox question lives in `jus dispatch init` and in `jus-dispatch
  # setup-sandbox`, where someone has already said they want a dispatch.
  jus_print_quick_start "$init_config_dir"
}


# ---------------------------------------------------------------------------
# Subcommand: dispatch
# ---------------------------------------------------------------------------
#
# ⚠️ THIS WAS `jus station` UNTIL #3912, AND THERE IS NO ALIAS. The binary is
# `jus-dispatch` now — a different one, not a rename — and the server refuses
# every `jus-station` at subscribe (#3900 raised `AgentChannel`'s protocol floor
# to 3). So a `jus station` that still worked would be a command that connects
# to nothing. `cmd_station` below is a stub that says where it went.
#
# ⚠️ `auth` IS BACK, WITH THE SANDBOX (#4243). This comment said it was gone
# "and not for tidiness" — true while the sandbox stayed behind at the
# `station-final` tag, and false since p188 brought the placement layer back.
# `jus-dispatch` has seven subcommands: `version`, `init`, `start`,
# `setup-sandbox`, `setup-orb`, `setup-docker` and `auth`. The wrapper routes
# all but `version`, which it answers itself (#4291).

# ⚠️ THIS DELIBERATELY DOES NOT SAY HOW TO INSTALL IT (#3987). The line it used
# to print — `brew install juscribe/tap/jus` — was an install advertisement on a
# path anybody could reach by typing a subcommand nothing documents any more.
dispatch_binary_missing() {
  echo "Error: jus-dispatch not found in PATH." >&2
  exit 1
}

cmd_dispatch_start() {
  command -v jus-dispatch &>/dev/null || dispatch_binary_missing

  # Resolve token from jus CLI config
  local token
  token=$(resolve_token) || exit 1

  # Build WebSocket server URL from HTTP base URL
  local ws_url
  local http_base="$BASE_URL"
  ws_url=$(echo "$http_base" | sed 's|^https://|wss://|; s|^http://|ws://|')
  ws_url="${ws_url}/cable"

  # Name the token source (#1939): the injection silently overrides any
  # dispatch.toml token, which misdirected the #1937 debugging for an hour.
  # $TOKEN_FILE is the resolved per-project path, not a hardcoded label.
  local token_source="$TOKEN_FILE"
  [[ -n "${JUSCRIBE_API_TOKEN:-}" ]] && token_source="JUSCRIBE_API_TOKEN env"
  echo "Starting jus-dispatch..."
  echo "  Server: $ws_url"
  echo "  Project: $PROJECT_ROOT"
  echo "  Token: from ${token_source} (exported as JUSCRIBE_API_TOKEN; overrides any dispatch.toml token)"
  # The token rides the environment, never argv (#1939) — argv is readable in
  # process listings for the daemon's whole lifetime.
  JUSCRIBE_API_TOKEN="$token" exec jus-dispatch start --server "$ws_url" --project "$PROJECT_ROOT" "$@"
}

cmd_dispatch_logs() {
  local log_file="${HOME}/.local/share/jus-dispatch/logs/jus-dispatch.log"

  if [[ ! -f "$log_file" ]]; then
    echo "No log file found at: $log_file" >&2
    echo "Has jus-dispatch been started?" >&2
    exit 1
  fi

  tail -f "$log_file" "$@"
}

cmd_dispatch_init() {
  command -v jus-dispatch &>/dev/null || dispatch_binary_missing

  exec jus-dispatch init "$@"
}

# The sandbox surface, forwarded verbatim (#4291).
#
# ⚠️ `jus-dispatch init` ADVISES TWO OF THESE and the wrapper answered with its
# own usage block and exit 1 — "re-run 'jus dispatch setup-sandbox'", printed
# when sandbox setup is skipped or fails, which is exactly when an operator is
# following instructions rather than improvising.
#
# One function rather than four: each of them is the binary check and an `exec`,
# and `start`, `init` and `logs` earn their own only because they build
# arguments first. These add nothing, so a shared passthrough is what keeps a
# fifth subcommand from being another copy.
cmd_dispatch_passthrough() {
  command -v jus-dispatch &>/dev/null || dispatch_binary_missing

  exec jus-dispatch "$@"
}

# `jus dispatch` requires a project (#3864, stakeholder rule 2026-09-07). The
# rule is about where config LANDS: `jus dispatch init` writes the project-local
# .jus/dispatch.toml when there is a .jus/ directory and the global
# ~/.config/jus-dispatch/config.toml when there is not, so a dispatch command run
# outside a project is the only way a jus config reaches a path outside one.
#
# It also closes the state that put /opt/homebrew/Cellar/jus in a config as a
# project path: with no project found, JUS_DIR stays at the Homebrew prefix and
# everything derived from it describes the Cellar rather than anybody's project.
jus_require_project() {
  jus_find_project_jus_dir >/dev/null && return 0

  echo "Error: no jus project at or above $PWD." >&2
  echo "" >&2
  echo "\`$PROG_NAME dispatch\` configures an agent FOR a project, and writes that" >&2
  echo "configuration into the project. Run this from one, or set one up:" >&2
  echo "" >&2
  echo "  $PROG_NAME init" >&2
  exit 1
}

cmd_dispatch() {
  local subcmd="${1:-}"
  if [[ -n "$subcmd" ]]; then
    shift
  fi

  # Before the router, so every subcommand is covered by construction rather
  # than by three remembered calls. Bare `jus dispatch` still prints its usage
  # anywhere — refusing to say what the commands ARE would be a poor answer to
  # standing in the wrong directory.
  #
  # ⚠️ An `if` rather than `[[ … ]] && jus_require_project`. Under this file's
  # `set -e` that one-liner is safe only because bash exempts the command before
  # a final `&&`, which is a rule nobody should have to know to edit this.
  if [[ -n "$subcmd" ]]; then
    jus_require_project
  fi

  case "$subcmd" in
    init)
      cmd_dispatch_init "$@"
      ;;
    start)
      cmd_dispatch_start "$@"
      ;;
    logs)
      cmd_dispatch_logs "$@"
      ;;
    setup-sandbox | setup-orb | setup-docker | auth)
      cmd_dispatch_passthrough "$subcmd" "$@"
      ;;
    *)
      echo "Usage: $PROG_NAME dispatch <command>" >&2
      echo "" >&2
      echo "Commands:" >&2
      echo "  init [flags]           Interactive jus-dispatch setup" >&2
      echo "  start [flags]          Start jus-dispatch with auto-configured token/server" >&2
      echo "  logs                   Tail the jus-dispatch log file" >&2
      echo "  setup-sandbox          Choose and provision where dispatches run" >&2
      echo "  setup-orb              Provision the OrbStack machine directly" >&2
      echo "  setup-docker           Provision the Docker image and auth volume directly" >&2
      echo "  auth                   Sign the sandbox CLI in" >&2
      exit 1
      ;;
  esac
}

# ⚠️ A SIGNPOST, NOT AN ALIAS (#3912). `jus station` reached a binary this
# product no longer publishes and a protocol the server no longer accepts, so
# forwarding it would hand someone a session that cannot connect. It exits 1 and
# says the one thing worth knowing.
cmd_station() {
  echo "Error: \`$PROG_NAME station\` is now \`$PROG_NAME dispatch\`." >&2
  echo "" >&2
  echo "The agent is jus-dispatch. It reads, answers, and leaves any code it" >&2
  echo "writes on a branch. jus-station is retired and the server refuses it" >&2
  echo "at connect." >&2
  exit 1
}

# ---------------------------------------------------------------------------
# Subcommand: cleanup
# ---------------------------------------------------------------------------

cmd_cleanup() {
  local tmp_dir="${JUS_DIR}/tmp"

  if [[ ! -d "$tmp_dir" ]]; then
    jus_ui_done "Nothing to clean — .jus/tmp/ does not exist."
    return 0
  fi

  # Collect items to remove (everything except .keep)
  local items=()
  while IFS= read -r -d '' item; do
    items+=("$item")
  done < <(find "$tmp_dir" -mindepth 1 -not -name '.keep' -print0)

  if [[ ${#items[@]} -eq 0 ]]; then
    jus_ui_done "Nothing to clean — .jus/tmp/ is already empty."
    return 0
  fi

  local file_count=0
  local dir_count=0
  local total_bytes=0

  for item in "${items[@]}"; do
    if [[ -f "$item" ]]; then
      total_bytes=$((total_bytes + $(wc -c < "$item")))
      file_count=$((file_count + 1))
    elif [[ -d "$item" ]]; then
      dir_count=$((dir_count + 1))
    fi
  done

  # Remove everything except .keep
  find "$tmp_dir" -mindepth 1 -not -name '.keep' -delete

  # Format size for display
  local size_display
  if [[ $total_bytes -ge 1048576 ]]; then
    size_display="$(( total_bytes / 1048576 )) MB"
  elif [[ $total_bytes -ge 1024 ]]; then
    size_display="$(( total_bytes / 1024 )) KB"
  else
    size_display="${total_bytes} bytes"
  fi

  local summary="Cleaned .jus/tmp/: removed ${file_count} file(s)"
  if [[ $dir_count -gt 0 ]]; then
    summary+=", ${dir_count} directory/directories"
  fi
  summary+=" (${size_display} freed)."

  jus_ui_done "$summary"
}

# ---------------------------------------------------------------------------
# Subcommand: switch — change active AI provider
# ---------------------------------------------------------------------------

cmd_switch() {
  # Same gate as init's tool menu — one source of truth, or the flag would govern
  # which provider you pick at setup but not whether you can change it (#1996).
  if ! jus_provider_selection_enabled; then
    jus_ui_fail "Error: multi-LLM support is not enabled for this account." >&2
    jus_ui_note "Set JUS_MULTI_LLM=1 to override locally." >&2
    exit 1
  fi

  local cli_provider_file="${CONFIG_DIR}/cli_provider"
  local current=""
  if [[ -f "$cli_provider_file" ]]; then
    current=$(cat "$cli_provider_file")
  fi

  # One vocabulary, not two (#4760) — this used to be a second hand-kept copy.
  local valid_providers=("${JUS_CLI_PROVIDERS[@]}")
  local target="${1:-}"

  if [[ "$target" == "--list" ]]; then
    echo "Supported providers:"
    local list_schema
    list_schema="$(jus_fetch_schema)"
    for p in "${valid_providers[@]}"; do
      # The maturity mark is the server's (#4225); it was a `!= claude` test
      # here until then (#3503). (current) and the maturity are different claims
      # and both have to survive.
      local marks=() mark
      [[ "$p" == "$current" ]] && marks+=("(current)")
      mark="$(jus_provider_suffix "$p" "$list_schema")"
      [[ -n "$mark" ]] && marks+=("$mark")
      if [[ ${#marks[@]} -eq 0 ]]; then
        echo "  $p"
      else
        echo "  $p ${marks[*]}"
      fi
    done
    return
  fi

  if [[ -z "$target" ]]; then
    # The question and its rows go to stderr, like jus init's menu, and the
    # number is mapped before the answer line so it can say which provider.
    jus_ui_question "Which AI coding CLI do you use?"
    jus_ui_note "$(jus_print_cli_provider_rows "$(jus_fetch_schema)")" >&2
    if [[ -n "$current" ]]; then
      jus_ui_note "Current: $current" >&2
    fi
    jus_ui_ask --quiet --under "Select [1-${#JUS_CLI_PROVIDERS[@]}]:"
    target="$(jus_cli_provider_for_choice "$JUS_UI_ANSWER")"
    if [[ -z "$target" ]]; then
      # No default to take: empty input is recorded as what it was (#4839 review).
      jus_ui_answer "${JUS_UI_ANSWER:-(nothing entered)}"
      jus_ui_fail "Invalid selection." >&2
      exit 1
    fi
    jus_ui_answer "$target"
  fi

  # Validate provider name
  local valid=false
  for p in "${valid_providers[@]}"; do
    if [[ "$p" == "$target" ]]; then
      valid=true
      break
    fi
  done
  if ! $valid; then
    jus_ui_fail "Error: unknown provider '$target'." >&2
    jus_ui_note "Valid providers: ${valid_providers[*]}" >&2
    exit 1
  fi

  # Validate binary exists
  local binary_name="$target"
  if ! command -v "$binary_name" &>/dev/null; then
    jus_ui_fail "Error: $binary_name not found in PATH." >&2
    case "$target" in
      claude) jus_ui_note "Install with: npm i -g @anthropic-ai/claude-code" >&2 ;;
      codex) jus_ui_note "Install with: npm i -g @openai/codex" >&2 ;;
      *) : ;;
    esac
    exit 1
  fi

  # Save
  mkdir -p "$(dirname "$cli_provider_file")"
  printf '%s' "$target" > "$cli_provider_file"
  jus_ui_done "Switched to: $target"

  # Warn if station is running
  if pgrep -f 'jus-dispatch' &>/dev/null; then
    jus_ui_warn "Warning: jus-dispatch is running. Restart it to use the new provider:"
    jus_ui_cmd "$PROG_NAME dispatch start"
  fi
}

# ---------------------------------------------------------------------------
# Subcommand: version
# ---------------------------------------------------------------------------

cmd_version() {
  local version
  version=$(resolve_client_version)
  if [[ -n "$version" ]]; then
    printf '%s\n' "$version"
  else
    jus_ui_fail "No VERSION file found" >&2
    exit 1
  fi
}

# The usage block, on stdout. `jus help` prints it as an answer; the bare and
# unknown-command replies below send it to stderr with exit 1 (#5080). It ends
# on the source line (#5256) — a plain line, not the star ask.
jus_print_usage() {
  jus_ui_warn "Usage: $PROG_NAME <command>"
  echo ""
  echo "Commands:"
  jus_ui_note "api METHOD /path [body]   REST API calls"
  jus_ui_note "download <url> <output>   Download attachments"
  jus_ui_note "login                     Sign in through the browser (--token to paste one)"
  jus_ui_note "whoami                    Show current user"
  jus_ui_note "init                      Interactive first-time setup"
  jus_ui_note "doctor                    Check the project's skills, token and workspace"
  jus_ui_note "refresh-hooks             Bring an installed hook manifest up to the bundle"
  jus_ui_note "remove-hooks              Take the Juscribe hooks out of your tool's config"
  jus_ui_note "hook <name>               Run a bundle enforcement hook (used by manifests)"
  jus_ui_note "switch [provider]         Change AI provider (requires multi-LLM enabled)"
  jus_ui_note "cleanup                   Remove all files from .jus/tmp/"
  jus_ui_note "dispatch <subcommand>     jus-dispatch: init, start, logs, setup-*, auth"
  jus_ui_note "version                   Show CLI version (also --version)"
  jus_ui_note "help                      Show this list"
  echo ""
  printf 'Source: %s\n' "$JUS_SOURCE_URL"
}

# ---------------------------------------------------------------------------
# Route subcommands (guarded so the script can be sourced for unit tests)
# ---------------------------------------------------------------------------

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
case "${1:-}" in
  api)
    shift
    cmd_api "$@"
    ;;
  download)
    shift
    cmd_download "$@"
    ;;
  login)
    shift
    cmd_login "$@"
    ;;
  whoami)
    cmd_whoami
    ;;
  doctor)
    cmd_doctor
    ;;
  refresh-hooks)
    cmd_refresh_hooks
    ;;
  remove-hooks)
    cmd_remove_hooks
    ;;
  hook)
    shift
    cmd_hook "$@"
    ;;
  init)
    cmd_init
    ;;
  # ⚠️ `version` STAYS BARE: scripts read it (spec/bin/install_jus_spec.rb, the
  # orb setup). `--version` is what a person types first (#5080), so it carries
  # the source line under the version (#5256).
  version)
    cmd_version
    ;;
  --version)
    cmd_version
    printf 'Source: %s\n' "$JUS_SOURCE_URL"
    ;;
  help | --help | -h)
    jus_print_usage
    ;;
  cleanup)
    cmd_cleanup
    ;;
  dispatch)
    shift
    cmd_dispatch "$@"
    ;;
  station)
    cmd_station
    ;;
  switch)
    shift
    cmd_switch "$@"
    ;;
  *)
    # #5080. A plugin calling a subcommand this CLI predates lands here, and
    # every adapter reads the exit 1 as permission — so the reply says what to
    # do about it before the usage block. A bare `jus` is not that case.
    # An unstamped CLI run inside a project resolves no version, hence `:+`.
    if [[ -n "${1:-}" ]]; then
      jus_have=$(resolve_client_version)
      jus_ui_warn "Unknown command: $1" >&2
      jus_ui_note "If a plugin ran it, it needs a newer ${PROG_NAME}${jus_have:+ than ${jus_have}}: brew upgrade jus" >&2
    fi
    jus_print_usage >&2
    exit 1
    ;;
esac
fi
