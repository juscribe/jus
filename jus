cmd_download() {
  local verbose=false
  local args=()

  for arg in "$@"; do
    case "$arg" in
      -v) verbose=true ;;
      *) args+=("$arg") ;;
    esac
  done

  if [[ ${#args[@]} -lt 2 ]]; then
    echo "Usage: $PROG_NAME download [flags] <url-path> <output-path>" >&2
    echo "       $PROG_NAME download /rails/active_storage/blobs/redirect/eyJ... .jus/tmp/screenshot.png" >&2
    exit 1
  fi

  local url_path="${args[0]}"
  local output_path="${args[1]}"

  local token
  token=$(resolve_token) || exit 1

  local url="${BASE_URL}${url_path}"

  if [[ "$verbose" == true ]]; then
    jus_ui_note ">>> GET $url" >&2
    jus_ui_note ">>> Output: $output_path" >&2
  fi

  local http_code
  http_code=$(curl -s -L \
    -K <(jus_curl_auth "$token") \
    -o "$output_path" \
    -w "%{http_code}" \
    "$url")

  if [[ "$http_code" -ge 400 ]]; then
    print_status "$http_code"
    jus_ui_fail "Error: Download failed" >&2
    rm -f "$output_path"
    exit 1
  fi

  print_status "$http_code"

  if [[ -f "$output_path" ]]; then
    local size
    size=$(wc -c < "$output_path" | tr -d ' ')
    jus_ui_done "Downloaded: $output_path ($size bytes)" >&2
  fi
}

# ---------------------------------------------------------------------------
# Browser sign-in (#4576)
# ---------------------------------------------------------------------------
#
# `jus login` signs in through the browser and saves a token, so nobody pastes
# one. The server's discovery document says where to start and where to swap
# the code (`GET /.well-known/oauth-authorization-server`); both are Juscribe's
# own, so the CLI holds no WorkOS address and no client id, and moving off
# WorkOS is a server change.
#
# Two ways back, decided before the browser opens, because the return address
# is fixed in the authorize request:
#
#   * SAME MACHINE: a one-shot listener on a loopback port. The browser lands
#     there and nothing is typed. bash cannot listen, so this is `nc`.
#   * ANOTHER MACHINE (SSH, a container, --no-browser, or no `nc` we know how
#     to drive): the server's /cli/callback page shows the code, and the person
#     pastes it here. A one-time code, never a token.
#
# ⚠️ PKCE IS WHAT MAKES A PASTED CODE SAFE. A code is worthless without the
# verifier only this process holds, so a code from someone else's sign-in
# cannot be swapped here.

# Base64url without padding, of stdin (RFC 7636 §4.2).
jus_b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# A PKCE pair, in two globals: 48 random bytes make a 64-character verifier.
jus_pkce_pair() {
  JUS_PKCE_VERIFIER="$(openssl rand 48 | jus_b64url)"
  JUS_PKCE_CHALLENGE="$(printf '%s' "$JUS_PKCE_VERIFIER" | openssl dgst -sha256 -binary | jus_b64url)"
}

jus_urlencode() {
  jq -rn --arg value "$1" '$value | @uri'
}

# The server's sign-in addresses, in two globals. Fails when the server
# publishes none, which is how a server without the CLI's WorkOS app says so.
jus_discover_sign_in() {
  local doc
  doc="$(curl -sS --max-time 10 -H "Accept: application/json" \
    -w "\n%{http_code}" "${BASE_URL}/.well-known/oauth-authorization-server" 2>/dev/null)" || return 1
  [[ "$(printf '%s' "$doc" | tail -1)" == "200" ]] || return 1
  doc="$(printf '%s' "$doc" | sed '$d')"
  JUS_AUTHORIZE_URL="$(printf '%s' "$doc" | jq -r '.authorization_endpoint // empty')"
  JUS_TOKEN_URL="$(printf '%s' "$doc" | jq -r '.token_endpoint // empty')"
  [[ -n "$JUS_AUTHORIZE_URL" && -n "$JUS_TOKEN_URL" ]]
}

# Which `nc` syntax listens on one loopback address, or nothing for an `nc`
# this does not know. macOS, OpenBSD's (Ubuntu's default) and Ncat take the
# address and port as words; the traditional and BusyBox ones take -s and -p.
jus_nc_flavor() {
  command -v nc >/dev/null 2>&1 || return 1
  local help
  help="$(nc -h 2>&1 || true)"
  if [[ "$(uname -s)" == "Darwin" ]] || grep -qiE 'openbsd|ncat' <<<"$help"; then
    printf 'words'
  elif grep -qiE 'busybox|v1\.10|gnu netcat' <<<"$help"; then
    printf 'flags'
  else
    return 1
  fi
}

# Opens a URL in the browser, or fails where there is none to open: over SSH,
# or on a Linux with no display.
jus_open_browser() {
  [[ -z "${SSH_CONNECTION:-}${SSH_TTY:-}" ]] || return 1
  if [[ "$(uname -s)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
    open "$1" >/dev/null 2>&1
  elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1
  else
    return 1
  fi
}

# Serves one page on 127.0.0.1:<port> and writes the request line that came
# with it to <file>. Listens again after a connection that was not the
# callback, because a browser may open one and send nothing on it.
#
# ⚠️ EACH `nc`'s PID GOES TO <file>.pid (#5727 finding 7). This runs in the
# background as a subshell, and killing the subshell leaves its `nc` running,
# reparented to PID 1 and listening, after every timeout and every fallback to
# pasting. `jus_await_loopback_code` kills the one recorded here as well.
#
# The browser is sent on to the app's `/cli/signed-in` (#5740) rather than shown
# a page drawn here, so it ends on Juscribe's own layout and can change with a
# deploy. The body is the fallback for a browser that does not follow.
jus_listen_once() { # <flavor> <port> <file>
  local flavor="$1" port="$2" file="$3" page="${BASE_URL}/cli/signed-in" body="" response="" tries=0
  body="<!doctype html><meta charset=\"utf-8\"><title>Back to your terminal</title><p><a href=\"${page}\">Continue</a></p>"
  response="$(printf 'HTTP/1.1 302 Found\r\nLocation: %s\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' \
    "$page" "${#body}" "$body")"
  while (( tries < 5 )); do
    tries=$(( tries + 1 ))
    if [[ "$flavor" == "words" ]]; then
      printf '%s' "$response" | nc -l 127.0.0.1 "$port" > "$file.raw" 2>/dev/null &
    else
      printf '%s' "$response" | nc -l -s 127.0.0.1 -p "$port" > "$file.raw" 2>/dev/null &
    fi
    printf '%s' "$!" > "$file.pid"
    wait "$!" || true
    if head -1 "$file.raw" | grep -q '^GET /callback?'; then
      head -1 "$file.raw" > "$file"
      return 0
    fi
  done
  return 1
}

# Stops the listener loop first, so it starts no other `nc`, then the `nc` it
# recorded, and removes the files they wrote.
jus_stop_listener() { # <loop pid> <file>
  kill "$1" 2>/dev/null || true
  if [[ -f "$2.pid" ]]; then
    kill "$(cat "$2.pid")" 2>/dev/null || true
  fi
  rm -f "$2" "$2.raw" "$2.pid"
}

# The value of one query parameter in a request line.
jus_query_param() { # <request line> <name>
  printf '%s' "$1" | sed -nE "s/.*[?&]$2=([^& ]*).*/\1/p" | head -1
}

# Waits for the browser to come back to the loopback port, and answers the code
# it brought, or fails on a timeout or on a state this process never sent.
# Answers 2 when there is no browser to open, so the caller falls back to
# pasting.
#
# ⚠️ IT RUNS IN `$(…)`, so its notes go to stderr, and the listener's stdout
# to /dev/null: a command substitution waits for every process holding its
# pipe, and a listener holding it would hang the sign-in until it timed out.
#
# ⚠️ BOTH WAITS ARE KNOBS, for the specs (#2510): JUS_LOGIN_TIMEOUT caps the
# whole wait and JUS_LOGIN_POLL is how often it looks.
jus_await_loopback_code() { # <flavor> <port> <state> <authorize url>
  local flavor="$1" port="$2" state="$3" url="$4" file="" pid="" deadline=0 line=""
  file="$(mktemp "${TMPDIR:-/tmp}/jus-login.XXXXXX")"
  jus_listen_once "$flavor" "$port" "$file" >/dev/null 2>&1 &
  pid=$!
  if ! jus_open_browser "$url"; then
    jus_stop_listener "$pid" "$file"
    return 2
  fi
  jus_ui_note "Waiting for the browser. If it did not open, visit:" >&2
  jus_ui_note "  $url" >&2
  deadline=$(( SECONDS + ${JUS_LOGIN_TIMEOUT:-300} ))
  while kill -0 "$pid" 2>/dev/null && (( SECONDS < deadline )); do
    sleep "${JUS_LOGIN_POLL:-1}"
  done
  line="$(cat "$file" 2>/dev/null || true)"
  jus_stop_listener "$pid" "$file"
  [[ -n "$line" ]] || return 1
  [[ "$(jus_query_param "$line" state)" == "$state" ]] || return 1
  jus_query_param "$line" code
}

# Swaps a code at the server's token endpoint, choosing an organization when
# there are several, and leaves the agent token in JUS_SIGNED_IN_TOKEN.
jus_swap_code() { # <code> <redirect_uri> <bot_provider>
  local code="$1" redirect_uri="$2" provider="$3" response="" http_code="" body="" continuation=""
  response="$(jus_post_cli_session \
    --data-urlencode "code=$code" --data-urlencode "code_verifier=$JUS_PKCE_VERIFIER" \
    --data-urlencode "redirect_uri=$redirect_uri" --data-urlencode "bot_provider=$provider")" || return 1
  http_code="$(printf '%s' "$response" | tail -1)"
  body="$(printf '%s' "$response" | sed '$d')"
  if [[ "$http_code" == "409" ]]; then
    continuation="$(printf '%s' "$body" | jq -r '.continuation')"
    jus_choose_organization "$body" || return 1
    response="$(jus_post_cli_session --data-urlencode "continuation=$continuation" \
      --data-urlencode "organization_id=$JUS_CHOSEN_ORGANIZATION" --data-urlencode "bot_provider=$provider")" || return 1
    http_code="$(printf '%s' "$response" | tail -1)"
    body="$(printf '%s' "$response" | sed '$d')"
  fi
  if [[ "$http_code" != "201" ]]; then
    jus_ui_fail "Error: $(printf '%s' "$body" | jq -r '.error // "the sign-in was refused"' 2>/dev/null)" >&2
    return 1
  fi
  JUS_SIGNED_IN_TOKEN="$(printf '%s' "$body" | jq -r '.access_token')"
}

# One POST to the token endpoint, as a form, naming this machine. Prints the
# body, then the status on its own line.
jus_post_cli_session() {
  curl -sS --max-time 20 -X POST -H "Accept: application/json" -w "\n%{http_code}" \
    --data-urlencode "device_info=$(hostname)" "$@" "$JUS_TOKEN_URL"
}

# The terminal asks which organization (stakeholder, 2026-10-08), from the list
# the server answered, and leaves the id in JUS_CHOSEN_ORGANIZATION.
jus_choose_organization() { # <409 body>
  local body="$1" count="" i=1 name=""
  count="$(printf '%s' "$body" | jq -r '.organizations | length')"
  jus_ui_note "You belong to ${count} organizations. A token reaches one of them."
  while (( i <= count )); do
    name="$(printf '%s' "$body" | jq -r ".organizations[$(( i - 1 ))].name")"
    jus_ui_note "  ${i}) ${name}"
    i=$(( i + 1 ))
  done
  jus_ui_ask "Which organization? [1-${count}]"
  if [[ ! "$JUS_UI_ANSWER" =~ ^[0-9]+$ ]] || (( JUS_UI_ANSWER < 1 || JUS_UI_ANSWER > count )); then
    jus_ui_fail "Invalid selection." >&2
    return 1
  fi
  JUS_CHOSEN_ORGANIZATION="$(printf '%s' "$body" | jq -r ".organizations[$(( JUS_UI_ANSWER - 1 ))].id")"
}

# #5741. Which AI tool the agent a sign-in makes is for, left in JUS_AGENT_TOOL
# as a brand slug. Every sign-in made a Claude agent until then, `jus init`'s
# token step included, which then read Claude back "from your token" as though
# the person had picked it.
#
# The menu is what the server may offer (#4761), without `jus init`'s
# "Other / skip": an agent is for a tool, so there is no skipping it. With one
# tool on offer, tool choice off or a single brand exposed, it asks nothing and
# says which (stakeholder, 2026-10-08). Answers 1 after a reply that is not on
# the menu, already reported.
jus_select_agent_tool() {
  local schema="" slug="" n=0
  local -a offered=()
  if jus_provider_selection_enabled; then
    schema="$(jus_fetch_schema)"
    while IFS= read -r slug; do
      [[ -n "$slug" ]] && offered+=("$slug")
    done < <(jus_visible_tool_slugs "$schema")
  else
    offered=(claude)
  fi
  if (( ${#offered[@]} == 1 )); then
    JUS_AGENT_TOOL="${offered[0]}"
    jus_ui_note "This agent is for $(jus_ai_tool_name "$JUS_AGENT_TOOL"), the only AI tool this server offers."
    return 0
  fi
  jus_ui_question "Which AI tool is this agent for?"
  for slug in "${offered[@]}"; do
    n=$((n + 1))
    jus_ui_note "$(printf '  %-22s%s' "${n}) $(jus_ai_tool_name "$slug")" "$(jus_provider_suffix "$slug" "$schema")")"
  done
  jus_ui_ask --quiet --under "Select [1-${n}]:"
  if [[ ! "$JUS_UI_ANSWER" =~ ^[0-9]+$ ]] || (( JUS_UI_ANSWER < 1 || JUS_UI_ANSWER > n )); then
    jus_ui_fail "Invalid selection." >&2
    return 1
  fi
  JUS_AGENT_TOOL="${offered[$((JUS_UI_ANSWER - 1))]}"
  jus_ui_answer "$(jus_ai_tool_name "$JUS_AGENT_TOOL")"
}

# The whole sign-in. Answers 0 with JUS_SIGNED_IN_TOKEN set, 3 when the server
# offers no browser sign-in (the caller asks for a token instead), and 1 on any
# other failure, already reported. Without a <bot_provider>, the person says
# which tool the agent is for, before the browser opens (#5741).
jus_browser_sign_in() { # [--no-browser] [<bot_provider>]
  local paste=0 provider="" flavor="" port="" state="" redirect_uri="" url="" code="" rc=0
  if [[ "${1:-}" == "--no-browser" ]]; then paste=1; shift; fi
  [[ -n "${1:-}" ]] && provider="$1"
  command -v jq >/dev/null 2>&1 && command -v openssl >/dev/null 2>&1 || return 3
  jus_discover_sign_in || return 3
  if [[ -z "$provider" ]]; then
    jus_select_agent_tool || return 1
    provider="$JUS_AGENT_TOOL"
  fi
  jus_pkce_pair
  state="$(openssl rand 24 | jus_b64url)"
  (( paste )) || flavor="$(jus_nc_flavor || true)"
  if [[ -n "$flavor" && -z "${SSH_CONNECTION:-}${SSH_TTY:-}" ]]; then
    port=$(( 49152 + RANDOM % 16000 ))
    redirect_uri="http://127.0.0.1:${port}/callback"
    url="${JUS_AUTHORIZE_URL}?redirect_uri=$(jus_urlencode "$redirect_uri")&code_challenge=${JUS_PKCE_CHALLENGE}&state=${state}"
    jus_ui_note "Opening your browser to sign in..."
    code="$(jus_await_loopback_code "$flavor" "$port" "$state" "$url")" || rc=$?
    if (( rc == 1 )); then
      jus_ui_fail "Error: The browser did not come back with a sign-in. Run jus login again." >&2
      return 1
    fi
  fi
  if [[ -z "$code" ]]; then
    redirect_uri="${BASE_URL}/cli/callback"
    url="${JUS_AUTHORIZE_URL}?redirect_uri=$(jus_urlencode "$redirect_uri")&code_challenge=${JUS_PKCE_CHALLENGE}&state=${state}"
    jus_ui_note "Open this link in any browser and sign in:"
    jus_ui_note "  $url"
    jus_ui_ask "Paste the code it shows:"
    code="$JUS_UI_ANSWER"
    [[ -n "$code" ]] || { jus_ui_fail "Error: No code entered." >&2; return 1; }
  fi
  jus_swap_code "$code" "$redirect_uri" "$provider"
}

# ---------------------------------------------------------------------------
# Subcommand: login
# ---------------------------------------------------------------------------

# Where a person gets an agent token, for the two prompts that ask for one:
# `jus login` and `jus init`. The page is the Agent Tokens section of the
# Security tab (#3835); both prompts called it by the retired name API Tokens until
# #4915, and .jus/bin/test-jus-whoami holds the wording.
agent_tokens_page() {
  printf '%s/settings/security → Agent Tokens\n' "$BASE_URL"
}

# #5742. The `.jus/` whose `config/` `jus login` saves into. The project the
# walk at the top of this file found, if any. Otherwise the nearest `.jus/` at or
# above $PWD, which is a project whose `config/` is missing (a fresh clone, or a
# config moved aside), and `config/` is made there (stakeholder, 2026-10-08).
#
# ⚠️ NEVER JUS_DIR'S FALLBACK. With no project found, JUS_DIR is the directory
# the CLI is installed in, the Homebrew keg, and login used to save there and
# print `.jus/config/api_token.txt` anyway. The next `brew upgrade jus` runs from
# a new keg, and the token is gone with nothing to say why.
#
# ⚠️ NOR $HOME's `.jus/`: the dispatch agent keeps its update-check cache there,
# so a home folder is not a project because it has one.
jus_login_jus_dir() {
  local dir="$PWD"
  if [[ "$JUS_PROJECT_FOUND" == 1 ]]; then
    printf '%s\n' "$JUS_DIR"
    return 0
  fi
  while :; do
    if [[ -d "$dir/.jus" && "$dir" != "$HOME" ]]; then
      printf '%s\n' "$dir/.jus"
      return 0
    fi
    [[ "$dir" == "/" ]] && return 1
    dir="$(dirname "$dir")"
  done
}

# #4576. Signs in through the browser unless asked not to: `--no-browser` for a
# pasted one-time code wherever the browser is, `--token` for a token made in
# Settings, which stays for CI and for a WorkOS outage. A server that offers no
# browser sign-in falls through to the token prompt.
cmd_login() {
  local mode="browser" arg="" token="" rc=0 login_dir="" token_file="" shown=""
  for arg in "$@"; do
    case "$arg" in
      --token) mode="token" ;;
      --no-browser) mode="paste" ;;
      *)
        jus_ui_fail "Usage: $PROG_NAME login [--no-browser | --token]" >&2
        exit 1
        ;;
    esac
  done

  # Before anything is asked or minted: a sign-in with nowhere to keep its
  # token would leave an agent on the server for nothing (#5742).
  if ! login_dir="$(jus_login_jus_dir)"; then
    jus_ui_fail "Error: No Juscribe project in $PWD or any folder above it, so there is nowhere to keep a token." >&2
    jus_ui_note "Run $PROG_NAME init to set this folder up, or cd into your project first." >&2
    exit 1
  fi
  token_file="${login_dir}/config/api_token.txt"

  if [[ "$mode" != "token" ]]; then
    if [[ "$mode" == "paste" ]]; then
      jus_browser_sign_in --no-browser || rc=$?
    else
      jus_browser_sign_in || rc=$?
    fi
    if (( rc == 0 )); then
      token="$JUS_SIGNED_IN_TOKEN"
    elif (( rc == 3 )); then
      jus_ui_note "This server offers no browser sign-in, so paste a token instead."
    else
      exit 1
    fi
  fi

  if [[ -z "$token" ]]; then
    jus_ui_note "Authenticate with your Juscribe API token."
    jus_ui_note "Get a token from: $(agent_tokens_page)"
    jus_ui_ask --secret "Paste your API token:"
    token="$JUS_UI_ANSWER"
  fi

  if [[ -z "$token" ]]; then
    jus_ui_fail "Error: No token provided." >&2
    exit 1
  fi

  jus_ui_note "Validating..."
  local user_json validate_status=0
  user_json=$(validate_token "$token") || validate_status=$?
  if (( validate_status == 2 )); then
    unreachable_message >&2
    exit 1
  elif (( validate_status != 0 )); then
    jus_ui_fail "Error: Invalid token — could not authenticate." >&2
    exit 1
  fi

  local user_name
  user_name=$(json_val "$user_json" '.user.name')

  mkdir -p "${login_dir}/config"
  printf '%s' "$token" > "$token_file"
  chmod 600 "$token_file"

  jus_ui_done "Authenticated as: $user_name"
  # What the token carries — the same lines jus init prints (#4839).
  jus_describe_token "$user_json"
  # The path written, relative where it is under this folder (#5742).
  shown="${token_file#"$PWD"/}"
  jus_ui_done "Token saved to: ${shown}"
}

# ---------------------------------------------------------------------------
# Subcommand: whoami
# ---------------------------------------------------------------------------

cmd_whoami() {
  local token
  token=$(resolve_token) || exit 1

  local user_json validate_status=0
  user_json=$(validate_token "$token") || validate_status=$?
  if (( validate_status == 2 )); then
    unreachable_message >&2
    exit 1
  elif (( validate_status != 0 )); then
    jus_ui_fail "Error: Stored token is invalid or expired." >&2
    exit 1
  fi

  format_whoami "$user_json"

  # The profile already names the token's workspace, so a stale saved number is
  # corrected here at no extra cost (#5047). Nothing failed, so no re-run.
  jus_check_saved_workspace "$user_json" || printf 'jus: %s\n' "$JUS_WORKSPACE_NOTICE" >&2
}

# Renders the whoami block from a /api/v1/profile payload (#2014). Pure text in,
# text out, so it is unit-testable without a server — see test-jus-whoami.
#
# Every line past the first comes from `token_scope`, which the server omits
# under session auth and fills only as far as the token is actually pinned: a
# legacy org-wide token has no workspace, and a server older than #2014 sends
# ids with no names. A fact the server did not send is DROPPED rather than
# printed as an empty label.
format_whoami() {
  local body="$1"

  if command -v jq &>/dev/null; then
    echo "$body" | jq -r '
      def named($name; $id): if ($name // "") == "" then ($id | tostring) else "\($name) (id: \($id))" end;
      def row($label; $value): if ($value // "") == "" then empty else "\($label)\($value)" end;
      .user as $u | (.token_scope // {}) as $t
      | [ "Logged in as: \($u.name) (\($u.email_address))" ]
        + [ row("Username:     "; $u.username) ]
        + [ row("Organization: "; if ($t.organization_id // "") == "" then null else named($t.organization_name; $t.organization_id) end) ]
        + [ row("Workspace:    "; if ($t.workspace_id // "") == "" then null else named($t.workspace_name; $t.workspace_id) end) ]
        + [ row("Role:         "; $t.role) ]
      | .[]'
  elif command -v python3 &>/dev/null; then
    echo "$body" | python3 -c '
import sys, json
d = json.load(sys.stdin)
u = d.get("user") or {}
t = d.get("token_scope") or {}

def named(name, ident):
    return "%s (id: %s)" % (name, ident) if name else str(ident)

rows = [("Logged in as: ", "%s (%s)" % (u.get("name"), u.get("email_address"))),
        ("Username:     ", u.get("username")),
        ("Organization: ", named(t.get("organization_name"), t["organization_id"]) if t.get("organization_id") else None),
        ("Workspace:    ", named(t.get("workspace_name"), t["workspace_id"]) if t.get("workspace_id") else None),
        ("Role:         ", t.get("role"))]
for label, value in rows:
    if value:
        print(label + str(value))
'
  else
    echo "$body"
  fi
}

# ---------------------------------------------------------------------------
# SOP install helpers (used by `init` step 4; unit-tested by test-jus-init-sop)
# ---------------------------------------------------------------------------

# Echo which AI tool `jus init` sets up for, as a brand slug (#4760).
#
# The menu is a provider-selection surface exactly like `jus switch`'s CLI
# picker, so it gates on the same flag (#1996). Gating that picker alone missed
# the point: the nine-item list is the one users actually see, and with
# provider_selection off the product is Claude-only — offering nine tools
# advertises support that does not exist. Flag off, then, answers Claude Code
# without asking, as Step 5 always does since #4802; flipping the flag on
# restores the menu.
# JUS_MULTI_LLM still overrides locally, since the predicate is shared.
#
# The menu prints to stderr so stdout carries only the choice. When the flag is
# off nothing is read, so a later prompt keeps its own input.
# ⚠️ THE ONLY PLACE THE MENU'S SHAPE IS WRITTEN DOWN (#4760). Order is the
# printed order; the displayed number is generated from this and mapped straight
# back, so hiding a brand cannot re-point the ones that remain.
#
# ⚠️ POSITION 4 IS GEMINI CLI, NOT ANTIGRAVITY (#4419), and it is not sunset:
# `latest` 0.60.0 with a nightly cut the same morning, measured 2026-09-19.
#
# ⚠️ CODEX IS SECOND (#4809, stakeholder 2026-09-22). Moving a row is safe for
# every live path; the one reader of old menu NUMBERS uses the frozen array
# below instead.
#
# ⚠️ ANTIGRAVITY IS LAST (#4804), after Qwen, and it is a separate product from
# Gemini CLI at position 4 (#4419). Being last moves nobody else's number.
JUS_TOOL_SLUGS=(claude codex cursor gemini copilot windsurf kimi qwen antigravity)

# The menu exactly as it was printed before #4760, when `.jus/config/ai_tool`
# held a number. FROZEN: a stored `2` means Cursor for as long as such a file
# exists, whatever order the menu is in today.
JUS_LEGACY_MENU_ORDER=(claude cursor codex gemini copilot windsurf kimi qwen)

# `jus switch`'s CLI-provider picker is a SECOND position-keyed menu, shorter and with
# its own vocabulary — which CLI runs a dispatch, not which editor you use. Same
# treatment for the same reason (#4760).
JUS_CLI_PROVIDERS=(claude codex)

jus_cli_provider_for_choice() {
  local n="${1-}"
  if [[ ! "$n" =~ ^[0-9]+$ ]] || (( n < 1 || n > ${#JUS_CLI_PROVIDERS[@]} )); then
    printf '\n'
    return 0
  fi
  printf '%s\n' "${JUS_CLI_PROVIDERS[$((n - 1))]}"
}

# A displayed menu number to the brand it names, or `other` for the escape hatch
# and for anything unparseable. ⚠️ THE RANGE GUARD IS NOT OPTIONAL: this file
# runs under `set -u`, where an out-of-range array index is fatal.
# The brands the server says this caller may be offered (#4761), one per line,
# or nothing at all when the key is absent.
#
# ⚠️ AN ABSENT KEY IS AN OLDER SERVER, NOT A RESTRICTION. Reading its silence
# as "nothing is exposed" would empty the menu against every deployment that
# predates this key, which is the opposite of degrading gracefully.
jus_exposed_slugs() {
  local body="${1-}" list
  list="$(grep -o '"exposed_providers"[[:space:]]*:[[:space:]]*\[[^]]*\]' <<<"$body" | head -1 || true)"
  [[ -n "$list" ]] || return 0
  grep -o '"[a-z][a-z0-9_-]*"' <<<"${list#*[}" | tr -d '"'
}

# The canonical list narrowed to what may be offered, in CANONICAL order — the
# server's order is not the menu's.
jus_visible_tool_slugs() {
  local body="${1-}" exposed slug
  exposed="$(jus_exposed_slugs "$body")"
  if [[ -z "$exposed" ]]; then
    printf '%s\n' "${JUS_TOOL_SLUGS[@]}"
    return 0
  fi
  for slug in "${JUS_TOOL_SLUGS[@]}"; do
    if grep -qx -- "$slug" <<<"$exposed"; then
      printf '%s\n' "$slug"
    fi
  done
}

# A displayed position within a list passed as the remaining arguments. The
# caller says which list: the menu ON SCREEN NOW, or JUS_LEGACY_MENU_ORDER for a
# number recorded before #4760. Those are different lists since #4809.
jus_menu_slug_at() {
  local n="${1-}"
  shift || true
  if [[ ! "$n" =~ ^[0-9]+$ ]] || (( n < 1 || n > $# )); then
    printf 'other\n'
    return 0
  fi
  printf '%s\n' "${!n}"
}

jus_select_ai_tool() {
  if ! jus_provider_selection_enabled; then
    jus_ui_done "Setting up for Claude Code (the server has tool choice off)." >&2
    # ⚠️ A SLUG (#4821). This said "1" after #4760 keyed everything on slugs,
    # so with the menu off `jus init` found no context file and no plugin.
    echo "claude"
    return 0
  fi

  # One fetch for the whole menu, in this function's own shell. See
  # jus_provider_maturity for why it cannot be cached inside the suffix call.
  local schema
  schema="$(jus_fetch_schema)"

  # ⚠️ THE MENU IS THE VISIBLE SUBSET (#4761), and the answer is mapped over
  # the same array it was printed from. Mapping it over the canonical list would
  # name the wrong brand the moment anything is hidden.
  local -a visible=()
  local slug
  while IFS= read -r slug; do
    [[ -n "$slug" ]] && visible+=("$slug")
  done < <(jus_visible_tool_slugs "$schema")

  {
    jus_ui_question "Which AI tool do you use?"
    # The maturity mark comes from the server's provider catalog (#4225); it was
    # a literal (Preview) on seven of these rows until then (#3503). Enforcement
    # hooks ship for every tool in this menu (jus_manifest_source is the list),
    # though what each can BLOCK differs and each adapter's README says how. The
    # mark is what tells the user how proven a tool is before they pick. It said "outside Claude Code"
    # until #4257, which had been wrong since #4208 and #4234.
    #
    # ⚠️ THE ORDER IS THE PRINTED ORDER AND NOTHING ELSE KEYS ON IT (#4760).
    # Every consumer takes a brand slug now, so reordering this list changes what
    # the user sees and re-points nothing. It was the opposite until #4760.
    #
    # "Other / skip" is deliberately unmarked and carries no slug: it is an
    # escape hatch, not a tool, and a preview of nothing is not a claim worth
    # making.
    local n=0 slug
    for slug in "${visible[@]}"; do
      n=$((n + 1))
      jus_ui_note "$(printf '  %-22s%s' "${n}) $(jus_ai_tool_name "$slug")" "$(jus_provider_suffix "$slug" "$schema")")"
    done
    jus_ui_note "  $((n + 1))) Other / skip"
  } >&2

  # The number is mapped here, so the answer line can say the name it meant.
  local picked
  jus_ui_ask --quiet --under "Select [1-$(( ${#visible[@]} + 1 ))]:"
  picked="$(jus_menu_slug_at "$JUS_UI_ANSWER" "${visible[@]}")"
  if [[ "$picked" == "other" ]]; then
    jus_ui_answer "Other / skip"
  else
    jus_ui_answer "$(jus_ai_tool_name "$picked")"
  fi
  printf '%s\n' "$picked"
}

# Step 4's answer (#4814). The agent token already says which tool it is for
# when that tool was PICKED at mint (#4813), so asking again is a question the
# person has answered. $1 is the /profile body Step 1 fetched to validate the
# token. Answers the token's provider, without prompting, only when all hold:
#
#   - the profile is a bot's       a person's token has no provider to choose
#   - ai_provider_chosen is true   a Claude-only mint writes `claude` by default
#   - the provider is on the menu  a brand this CLI cannot set up
#
# Anything less runs the menu exactly as before. Parsed with grep rather than
# jq, like `jus_fetch_provider_selection`, because jq is optional here.
jus_choose_ai_tool() {
  local profile="${1-}" provider slug
  if grep -q '"bot"[[:space:]]*:[[:space:]]*true' <<<"$profile" &&
    grep -q '"ai_provider_chosen"[[:space:]]*:[[:space:]]*true' <<<"$profile"; then
    provider="$(grep -o '"ai_provider"[[:space:]]*:[[:space:]]*"[a-z]*"' <<<"$profile" | head -1 | sed 's/.*"\([a-z]*\)"$/\1/')"
    for slug in "${JUS_TOOL_SLUGS[@]}"; do
      if [[ "$slug" == "$provider" ]]; then
        jus_ui_done "Setting up for $(jus_ai_tool_name "$slug") (from your token)." >&2
        printf '%s\n' "$slug"
        return 0
      fi
    done
  fi
  jus_select_ai_tool
}

# Where `jus init` records which tool it set the project up for (#4508).
#
# ⚠️ IT WAS COMPUTED AND THROWN AWAY. `jus_select_ai_tool` returns a brand,
# `cmd_init` uses it for the context file and the install method, and nothing
# kept it — so no later check could tell an unwired Cursor project from a Claude
# project whose plugin is missing, and a check that cannot tell those apart
# either nags the wrong user or says nothing at all.
#
# ⚠️ NOT `.jus/config/cli_provider`, WHICH LOOKS LIKE THIS AND IS NOT. That
# records the *dispatch* CLI, and `jus init` writes `claude` there without
# asking (#4802) — so reading it as the tool choice would report "Claude Code"
# for every project that `jus switch` never touched.
AI_TOOL_FILE="${CONFIG_DIR}/ai_tool"

# The recorded brand slug, or nothing.
#
# ⚠️ ANYTHING THAT NAMES NO BRAND READS AS NOTHING, deliberately. Everything
# downstream switches on the slug; a value this build does not understand is
# corruption or a newer format, and guessing at it is how a check nags the wrong
# person. A legacy 1-9 record is the one exception, mapped below.
jus_recorded_ai_tool() {
  local recorded
  [[ -f "$AI_TOOL_FILE" ]] || return 0
  recorded="$(tr -d "[:space:]" < "$AI_TOOL_FILE")"
  # ⚠️ A FILE WRITTEN BEFORE #4760 HOLDS A MENU NUMBER. Refusing it would
  # silently un-configure every project already initialised, so a legacy value is
  # mapped through the menu order it was written against.
  local slug
  case "$recorded" in
    [1-9]) jus_menu_slug_at "$recorded" "${JUS_LEGACY_MENU_ORDER[@]}" ;;
    other) printf 'other\n' ;;
    *)
      for slug in "${JUS_TOOL_SLUGS[@]}"; do
        if [[ "$slug" == "$recorded" ]]; then
          printf '%s\n' "$recorded"
          return 0
        fi
      done
      ;;
  esac
}

# The human name for a brand slug. Extracted from cmd_init's inline case so
# `jus doctor` names the tool the same way the wizard did (#4508).
jus_ai_tool_name() {
  case "$1" in
    claude) echo "Claude Code" ;;
    cursor) echo "Cursor" ;;
    codex) echo "ChatGPT / Codex" ;;
    gemini) echo "Gemini CLI" ;;
    copilot) echo "GitHub Copilot" ;;
    windsurf) echo "Windsurf" ;;
    kimi) echo "Kimi Code" ;;
    qwen) echo "Qwen Code" ;;
    antigravity) echo "Antigravity" ;;
    *) echo "Other / skip" ;;
  esac
}

# ── Claude Code's context file is AGENTS.md (#4866) ─────────────────────────
#
# The legacy append writes Claude Code's SOP to AGENTS.md, the file it shares
# with Codex, Kimi and Antigravity. Claude Code reads it by itself only while
# the project has none of JUS_CLAUDE_NAMES (#4514, claude-instruction-files.md):
# creating a CLAUDE.md does not add a context file, it removes one. So beside a
# CLAUDE.md family file, jus_claude_import_agents_md adds one line to that file
# importing AGENTS.md, which Claude Code expands.
#
# ⚠️ NOT THE `instructionFiles` SETTING. Measured on 2.1.280 by running it
# (#4866): it is a plugin option under pluginConfigs["agents-md@builtin"].options,
# read from user, --settings or managed settings only. A project's
# .claude/settings.json never carries it, and the top-level key this script
# used to recommend is inert. The import line needs no setting and no remote
# flag, and travels with the repository.
#
# ⚠️ `CLAUDE.local.md` SUPPRESSES TOO — a personal, gitignored file switches
# AGENTS.md off for one user alone — so it is in the family and gets the import
# when it is the only one. ⚠️ AND CLAUDE CODE LOOKS UP THE TREE, NOT AT THE
# PROJECT ROOT: a family file in any folder above suppresses a child AGENTS.md
# — a monorepo's root CLAUDE.md, when `jus init` runs in a package — so
# jus_claude_parent_carrier looks there too (#4957).
JUS_AGENTS_NAMES=("AGENTS.md" ".claude/AGENTS.md")
JUS_CLAUDE_NAMES=("CLAUDE.md" ".claude/CLAUDE.md" "CLAUDE.local.md")

# The first name from a list that exists in the project, or nothing.
jus_first_existing() { # <project_root> <name...>
  local project_root="$1" name
  shift
  for name in "$@"; do
    [[ -f "${project_root}/${name}" ]] && { printf '%s\n' "$name"; return 0; }
  done
  return 1
}

# The context file `jus init` writes for a tool, in a given project.
#
# ⚠️ CLAUDE IS DECIDED AT RUN TIME, NOT BY THE MAP. The map stays the documented
# default — three surfaces are held against it — but a project may already keep
# its AGENTS.md under .claude/, and that is the one to append to. ⚠️ Keyed on
# the SLUG (#4821): this compared the choice against "1" inline in cmd_init and
# never fired after #4760.
# Say how big the SOP is before the legacy path writes all of it into a
# context file (#5387). Silent inside JUS_CONTEXT_BUDGET_BYTES.
#
# ⚠️ ALL OF IT, EVERY SECTION, ~80 KB. Two of the tools this menu names cap
# what they read: Codex reads project docs up to `project_doc_max_bytes`, 32 KiB
# by default, and cuts the rest; Kimi warns on every session above 32 KB. The
# bundle carries the same SOP as skills that load on demand.
#
# A warning, not a refusal: the person chose this, and for a tool that reads
# no skills it is the only way the SOP arrives.
#
# ⚠️ PURE BASH, NO `wc`: jus init runs on a PATH that may hold nothing but the
# tools it names (jus_init_transcript_spec.rb runs it on one), and a missing
# `tr` there ended the whole wizard. LC_ALL=C makes ${#…} count bytes.
JUS_CONTEXT_BUDGET_BYTES=32768

jus_warn_sop_size() { # <sop_path> <choice> <context_file>
  local sop_path="$1" choice="$2" context_file="$3" sop bytes LC_ALL=C
  [[ -r "$sop_path" ]] || return 0
  sop="$(<"$sop_path")"
  bytes=${#sop}
  (( bytes > JUS_CONTEXT_BUDGET_BYTES )) || return 0
  jus_ui_warn "The SOP is $(( (bytes + 1023) / 1024 )) KB, and all of it goes into ${context_file}."
  case "$choice" in
    codex)
      jus_ui_note $'Codex reads 32 KiB of project docs by default\n(project_doc_max_bytes) and cuts the rest, so most of it never loads.'
      ;;
    kimi) jus_ui_note "Kimi warns on every session when the file is over 32 KB." ;;
    *)
      jus_ui_note $'A tool that caps its context file loads only the start of it, and\none that does not pays for all of it on every turn.'
      ;;
  esac
  if [[ "$(jus_sop_method "$choice")" == "fallback" ]]; then
    jus_ui_note $'If your tool reads skills, run \''"${PROG_NAME}"$' init\' again and pick it:\nthe bundle loads the same SOP on demand.'
  else
    jus_ui_note $'The bundle loads the same SOP on demand. To switch, run\n\''"${PROG_NAME}"$' init\' again and choose "Install the bundle".'
  fi
}

jus_init_context_file() {
  local choice="$1" project_root="$2"
  if [[ "$choice" == "claude" ]]; then
    jus_claude_context_file "$project_root"
  else
    jus_ai_tool_context_file "$choice"
  fi
}

# Which AGENTS.md `jus init` appends to for Claude Code: the one the project
# already has, else the root one. Its stdout IS the filename, read by a command
# substitution, so nothing else may be printed here — and nothing is asked: the
# "Put the SOP in AGENTS.md instead?" question (#4514, #4832) had nothing left
# to protect once AGENTS.md became the answer.
jus_claude_context_file() {
  local project_root="$1"
  jus_first_existing "$project_root" "${JUS_AGENTS_NAMES[@]}" || printf '%s\n' "AGENTS.md"
}

# The line that makes Claude Code read AGENTS.md beside a CLAUDE.md family
# file: an @import, with the path relative to the IMPORTING file —
# `@../AGENTS.md` from .claude/CLAUDE.md. Measured in all four shapes on
# 2.1.280 (#4866); a wrong relative path is ignored without a word, which is
# why this is computed rather than fixed.
jus_agents_import_line() { # <carrier> <agents_file>
  local carrier="$1" agents="$2"
  if [[ "$carrier" == .claude/* ]]; then
    if [[ "$agents" == .claude/* ]]; then
      agents="${agents#.claude/}"
    else
      agents="../${agents}"
    fi
  fi
  printf '@%s\n' "$agents"
}

# Whether a file carries an import line outside a code block — Claude Code does
# not expand an @import inside one — allowing `@./`, trailing blanks and CRLF.
jus_imports_line() { # <file> <import line>
  awk -v want="$2" '
    /^[ \t]*(```|~~~)/ { fenced = !fenced; next }
    fenced { next }
    { sub(/\r$/, ""); sub(/[ \t]+$/, ""); sub(/^@\.\//, "@") }
    $0 == want { found = 1; exit }
    END { exit !found }
  ' "$1"
}

# The nearest CLAUDE.md family file in a folder ABOVE the project, as a path.
#
# ⚠️ CLAUDE CODE LOOKS ALL THE WAY UP (#4957). Measured on 2.1.281 by running
# it: a family file in any folder above hides the project's AGENTS.md — past
# the git root, and along the PHYSICAL path, so a folder reached through a
# symlink is judged by where it really is. Read from the binary, not run: the
# walk stops short of `/`, and the one file it skips is the user memory file,
# ${CLAUDE_CONFIG_DIR:-~/.claude}/CLAUDE.md, which is loaded as user memory
# instead. Counting that one would create a CLAUDE.md in every project under
# the home folder of anyone who has it.
#
# <test>, when given, is a function the file must also pass: with
# jus_sop_block_present, the nearest file above carrying the SOP (#4970).
# ⚠️ THAT CAN BE FURTHER UP THAN THE NEAREST FILE, which may lack it, and
# Claude Code reads every one of them — measured on 2.1.281, a grandparent and
# a parent both load.
jus_claude_parent_carrier() { # <project_root> [<test>]
  local dir name path test="${2:-}" user_memory="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}/CLAUDE.md"
  dir="$(cd "$1" && pwd -P)"
  while dir="$(dirname "$dir")" && [[ "$dir" != "/" ]]; do
    for name in "${JUS_CLAUDE_NAMES[@]}"; do
      path="${dir}/${name}"
      if [[ -f "$path" ]] && [[ ! "$path" -ef "$user_memory" ]] &&
        { [[ -z "$test" ]] || "$test" "$path"; }; then
        printf '%s\n' "$path"
        return 0
      fi
    done
  done
  return 1
}

# Whether Claude Code reads a project's AGENTS.md: it does with no CLAUDE.md
# family file in the project or above it, and beside one in the project only
# through an import (#4514, #4866, #4957).
jus_claude_reads_agents_md() { # <project_root> <agents_file>
  local project_root="$1" agents="$2" name path family=0
  for name in "${JUS_CLAUDE_NAMES[@]}"; do
    path="${project_root}/${name}"
    [[ -f "$path" ]] || continue
    family=1
    if [[ "$path" -ef "${project_root}/${agents}" ]] ||
      jus_imports_line "$path" "$(jus_agents_import_line "$name" "$agents")"; then
      return 0
    fi
  done
  (( family == 0 )) && ! jus_claude_parent_carrier "$project_root" >/dev/null
}

# Creates a CLAUDE.md holding only the import, for a project whose AGENTS.md a
# family file in a folder above hides (#4957). Claude Code reads the CLAUDE.md
# in the folder it starts in, and the import brings the SOP with it — measured
# on 2.1.281. The stakeholder chose this over a warning alone (23 Sep): the
# rule against creating a CLAUDE.md is for a project with none above it.
jus_claude_create_import() { # <project_root> <agents_file> <file_above>
  local project_root="$1" agents="$2" shown line
  shown="$(jus_tilde_path "$3")"
  line="$(jus_agents_import_line CLAUDE.md "$agents")"
  jus_ui_warn "${shown}, in a folder above, stops Claude Code reading ${agents},"
  # Under `set -e` a refused `>` would end the wizard after the claim below.
  if [[ ! -w "$project_root" ]]; then
    jus_ui_note "and this folder is not writable. Create a CLAUDE.md here holding:"
    jus_ui_cmd "$line"
    jus_record_needs_you "Create CLAUDE.md holding the line ${line}, so Claude Code reads the SOP in ${agents} under ${shown}"
    return 0
  fi
  jus_ui_note "so a CLAUDE.md here now imports it."
  printf '%s\n' "$line" > "${project_root}/CLAUDE.md"
  jus_ui_done "Created CLAUDE.md, which imports ${agents}."
  jus_record_setup_action "Created CLAUDE.md holding the line ${line},"$'\n'"so Claude Code reads the SOP in ${agents} under ${shown} — undo with: rm CLAUDE.md"
}

# Whether a CLAUDE.md family file in a folder above carries the SOP, saying so
# when one does (#4970). Claude Code reads that copy here too, so importing
# AGENTS.md as well would load the SOP twice — the rule #4866 applies to a
# family file inside the project, extended up the tree.
jus_claude_sop_above() { # <project_root> <agents_file>
  local above
  above="$(jus_claude_parent_carrier "$1" jus_sop_block_present)" || return 1
  jus_ui_done "$(jus_tilde_path "$above"), in a folder above, carries the Juscribe SOP,"
  jus_ui_note "so ${2} is not imported."
}

# Adds the import line to the CLAUDE.md family file a project already has, so
# the SOP in AGENTS.md is read (#4866). An import already there is left alone.
#
# ⚠️ WITHOUT ONE, NOTHING IS CREATED — Claude Code reads AGENTS.md by itself —
# BUT A CLAUDE.md MADE LATER SWITCHES THAT OFF, and Claude Code's own `/init`
# makes one. So the person is told what it will need (stakeholder, 23 Sep).
# ⚠️ UNLESS ONE IN A FOLDER ABOVE HAS SWITCHED IT OFF ALREADY (#4957).
# ⚠️ AND NOTHING IS IMPORTED WHILE ONE ABOVE CARRIES THE SOP (#4970).
jus_claude_import_agents_md() { # <project_root> <agents_file>
  local project_root="$1" agents="$2" carrier line path name above
  if ! carrier="$(jus_first_existing "$project_root" "${JUS_CLAUDE_NAMES[@]}")"; then
    jus_claude_sop_above "$project_root" "$agents" && return 0
    if above="$(jus_claude_parent_carrier "$project_root")"; then
      jus_claude_create_import "$project_root" "$agents" "$above"
      return 0
    fi
    jus_ui_warn "Claude Code stops reading ${agents} once the project has a CLAUDE.md."
    jus_ui_note "Add the line $(jus_agents_import_line CLAUDE.md "$agents") to any CLAUDE.md you create later."
    return 0
  fi
  path="${project_root}/${carrier}"
  # A CLAUDE.md that IS the AGENTS.md, through a link either way, is read
  # already, and the import would land in AGENTS.md itself.
  if [[ "$path" -ef "${project_root}/${agents}" ]]; then
    jus_ui_done "${carrier} is ${agents}, so Claude Code already reads it."
    return 0
  fi
  # A pre-#4866 append left the SOP in the family itself. That copy is read,
  # and importing the AGENTS.md one as well would load the SOP twice.
  for name in "${JUS_CLAUDE_NAMES[@]}"; do
    if jus_sop_block_present "${project_root}/${name}"; then
      jus_ui_done "${name} carries the Juscribe SOP itself, so ${agents} is not imported."
      return 0
    fi
  done
  line="$(jus_agents_import_line "$carrier" "$agents")"
  if jus_imports_line "$path" "$line"; then
    jus_ui_done "${carrier} already imports ${agents}."
    return 0
  fi
  # After the check above, which would otherwise be reported as not imported.
  jus_claude_sop_above "$project_root" "$agents" && return 0
  # Under `set -e` a refused `>>` would end the wizard after the claim below.
  if [[ ! -w "$path" ]]; then
    jus_ui_warn "${carrier} is not writable, so Claude Code will not read ${agents}."
    jus_ui_note "Add this line to it:"
    jus_ui_cmd "$line"
    jus_record_needs_you "Add the line ${line} to ${carrier}, so Claude Code reads the SOP in ${agents}"
    return 0
  fi
  jus_ui_warn "Claude Code reads ${agents} only when a project has no ${carrier}, so"
  jus_ui_note "${carrier} now imports it and both are read."
  # Onto a line of its own: a file that does not end in a newline gets one first.
  if [[ -s "$path" ]] && [[ -n "$(tail -c 1 "$path")" ]]; then
    printf '\n' >> "$path"
  fi
  printf '\n%s\n' "$line" >> "$path"
  jus_ui_done "Added an import of ${agents} to ${carrier}."
  jus_record_setup_action "Added the line ${line} to ${carrier},"$'\n'"so Claude Code reads the SOP in ${agents} beside it — undo by removing that line from ${carrier}"
}

# The context file a brand slug appends to. Same extraction, same reason.
jus_ai_tool_context_file() {
  case "$1" in
    claude) echo "AGENTS.md" ;;
    cursor) echo ".cursorrules" ;;
    # `agy` reads GEMINI.md AND AGENTS.md (claude-instruction-files.md); the
    # shared one is what a mixed-tool repo already has.
    codex | kimi | antigravity) echo "AGENTS.md" ;;
    gemini) echo "GEMINI.md" ;;
    copilot) echo ".github/copilot-instructions.md" ;;
    windsurf) echo ".windsurfrules" ;;
    qwen) echo "QWEN.md" ;;
    *) : ;;
  esac
}

# Map a `jus init` brand slug to how it should load the SOP:
#   plugin   — Claude Code marketplace plugin (skills + enforcement hooks)
#   skills   — link the bundle into the tool's skills dir(s) (see below)
#   fallback — append the SOP to the tool's context file (no skills surface)
# Mirrors the per-tool guidance in .jus/docs/installing-the-bundle.md, and
# spec/project/sop_install_routing_parity_spec.rb holds the two together.
#
# ⚠️ EVERY TOOL IN THE MENU READS SKILLS. Only choice 9 ("Other / skip") falls
# through to the append now (#4257). Copilot and Qwen were on `fallback` for
# seven weeks after both shipped a skills surface, which left them carrying the
# whole SOP permanently instead of loading it on demand.
#
# ⚠️ HOOKS ARE NOT CLAUDE-ONLY, AND THIS COMMENT SAID THEY WERE. Enforcement
# hooks ship for eight tools today, and since #4420 `jus init` OFFERS every one
# of them — the list below describes what the installer does, which is what it
# only appeared to do before:
#
#   Claude Code  the marketplace plugin
#   Codex        jus/hooks/codex/      (#4234, via jus_install_tool_hooks)
#   Kimi Code    jus/hooks/kimi-code/  (#4208, carried by its own plugin)
#   Copilot      jus/hooks/copilot/    (#4260, copied to .github/hooks/)
#   Cursor       jus/hooks/cursor/     (#4261, copied to .cursor/hooks.json)
#   Gemini CLI   jus/hooks/gemini/     (#4419, merged into .gemini/settings.json)
#   Antigravity  jus/hooks/antigravity/ (#4262, merged into ~/.gemini/config/hooks.json)
#                — a SEPARATE product, not Gemini CLI's successor; menu choice 4
#                  is Gemini CLI, and Antigravity has its own row since #4804
#   Qwen Code    jus/hooks/qwen/       (#4263, merged into .qwen/settings.json)
#   Windsurf     jus/hooks/windsurf/   (#4264, copied to .windsurf/hooks.json)
#
# ⚠️ THE LAST SIX ARE NOT LIVE-VERIFIED, and each README says so in its first
# paragraph — neither tool is installed on the authoring machine, so nothing has
# been watched refusing anything. Do not promote them in a menu, a doc or a
# support matrix without reading that box first.
#
# The parity spec reads jus/hooks/*/README.md, so an adapter landing without this
# list naming it fails rather than drifting. That is not hypothetical: it fired
# on #4261 the first time the gate ran.
jus_sop_method() {
  case "$1" in
    claude) echo "plugin" ;;
    cursor | codex | gemini | copilot | windsurf | kimi | qwen | antigravity) echo "skills" ;;
    *) echo "fallback" ;;      # the Other / skip escape hatch
  esac
}

# ── Qwen takes its skills from its own extension system (#4833) ─────────────
#
# `qwen extensions install <repo>:<plugin>` reads our Claude marketplace in the
# public repository and installs the plugin as a Gemini-format extension, from
# gemini-extension.json. What arrives: the three skills, as `jus:<name>`, and
# GEMINI.md as context, and since #4834 Qwen's own hooks. The fallback, for a
# machine with no `qwen`, is the .agents/skills/ links every other tool takes.
#
# ⚠️ `--scope project` DOES NOT PUT THE FILES IN THE PROJECT. They land in
# ~/.qwen/extensions/jus whatever the scope; what it scopes is where the
# extension is ENABLED. Measured on qwen 0.24.0 (#4833), which is also why a
# second project has to enable rather than install — see below.
JUS_QWEN_EXTENSION_SOURCE="https://github.com/juscribe/jus-skills:jus"

jus_qwen_extension_command() {
  printf 'qwen extensions install %s --consent --scope project --auto-update\n' "$JUS_QWEN_EXTENSION_SOURCE"
}

# Installs the extension for this project, or enables one already installed.
# Returns 1 when neither happened, and the caller links the skills instead.
#
# ⚠️ A SECOND PROJECT CANNOT INSTALL, IT HAS TO ENABLE. `install` answers
# `Extension "jus" is already installed. Please uninstall it first.`, exit 1,
# because the files are machine-wide; `enable --scope workspace` adds this
# project and is idempotent. It is tried after ANY install failure rather than
# on that sentence, so nothing here depends on Qwen's wording: with nothing
# installed, enable fails too, and the install's own message is what is shown.
#
# ⚠️ THE UNDO IS `disable`, NOT `uninstall`, which would take the extension away
# from every project on the machine.
#
# ⚠️ STDIN IS /dev/null. A bare local path, rather than `<path>:jus`, opens an
# interactive plugin picker, exits 0 and installs nothing — measured on #4833.
jus_qwen_install_extension() {
  local project_root="$1" output
  if ! command -v qwen &>/dev/null; then
    jus_ui_warn "No qwen command on your PATH, so the skills are linked instead. Once Qwen"
    jus_ui_note "is installed, re-run '${PROG_NAME} init' to switch to its extension:"
    jus_ui_cmd "$(jus_qwen_extension_command)"
    jus_record_skipped "The Qwen extension install: the qwen CLI is not on your PATH"
    return 1
  fi

  jus_ui_note $'Installing the jus extension for Qwen Code\n(enabled for this project, auto-updating)...'
  if output="$(cd "$project_root" && qwen extensions install "$JUS_QWEN_EXTENSION_SOURCE" \
    --consent --scope project --auto-update 2>&1 </dev/null)"; then
    jus_ui_done "Installed the jus extension."
  elif (cd "$project_root" && qwen extensions enable --scope workspace jus &>/dev/null </dev/null); then
    jus_ui_done "The jus extension was already installed; enabled it for this project."
  else
    jus_ui_fail "Qwen could not install it, so the skills are linked instead:"
    jus_ui_note "$(sed 's/^/  /' <<<"$output")"
    return 1
  fi
  jus_record_setup_action "Enabled the jus extension for Qwen Code in this project — undo with: qwen extensions disable --scope workspace jus"
  jus_ui_note "The skills load from the next Qwen session, named jus:<name>."
  return 0
}

# The hooks file the installed jus extension registers, or exit 1.
#
# ⚠️ THE MANIFEST'S FIELD, NOT THE FILE. Qwen copies the whole bundle into the
# extension, so hooks/qwen/settings.json is present in every one of them. What
# wires it is `hooks` in the qwen-extension.json the bundle ships since #4834.
# An older bundle's extension carries a qwen-extension.json Qwen generated,
# with no such field, and runs Claude Code's hooks/hooks.json instead.
#
# ⚠️ NO `jq`: the doctor path reads this, and it degrades without jq.
jus_qwen_extension_hooks() {
  jus_plugin_hooks_file "${HOME}/.qwen/extensions/jus" "qwen-extension.json"
}

# The file a plugin manifest's string `hooks` field names, resolved against the
# plugin root, or exit 1 when the field is absent or the file is not there.
# $1 = plugin root, $2 = manifest path relative to it.
jus_plugin_hooks_file() {
  local root="$1" manifest="$1/$2" pointer
  [[ -f "$manifest" ]] || return 1
  pointer="$(grep -oE '"hooks"[[:space:]]*:[[:space:]]*"[^"]+"' "$manifest" \
    | sed -E 's/.*"([^"]+)"$/\1/' || true)"
  [[ -n "$pointer" && -f "${root}/${pointer#./}" ]] || return 1
  printf '%s\n' "${root}/${pointer#./}"
}

# Removes the jus hooks an earlier `jus init` merged into a tool's config, once
# its plugin registers the same hooks itself. Both load, and every hook fires
# twice — measured on #4833 before Qwen's extension carried Qwen's file.
jus_retire_merged_hooks() {
  local choice="$1" project_root="$2" location
  while IFS= read -r location; do
    [[ -f "$location" && -n "$(jus_manifest_jus_commands "$location")" ]] || continue
    if jus_remove_hooks_from "$location"; then
      jus_record_setup_action "Removed the hooks merged into $(jus_tilde_path "$location") — undo by nothing: the $(jus_tool_plugin_kind "$choice") registers them now, and both would fire each hook twice"
    else
      jus_ui_warn "Could not remove them from ${location} (jq is needed): run '${PROG_NAME} remove-hooks'."
    fi
  done < <(jus_manifest_locations "$choice" "$project_root")
  return 0
}

# ── Codex takes its skills from its own plugin system (#4836) ───────────────
#
# The bundle installs from our marketplace unmodified, and the skills arrive as
# `jus:<name>`. Both commands are idempotent, so a second project runs the same
# two. Measured on codex-cli 0.145.0.
#
# ⚠️ MACHINE-WIDE, AND THERE IS NO OTHER SCOPE. The plugin is enabled in
# $CODEX_HOME/config.toml, so its skills load in every project on the machine;
# the hooks are guarded to do nothing outside a jus project.
JUS_CODEX_MARKETPLACE_SOURCE="https://github.com/juscribe/jus-skills.git"

jus_codex_plugin_commands() {
  printf 'codex plugin marketplace add %s\n' "$JUS_CODEX_MARKETPLACE_SOURCE"
  printf 'codex plugin add jus@jus-skills\n'
}

# Installs the plugin. Returns 1 when it did not, and the caller links instead.
jus_codex_install_plugin() {
  local project_root="$1" output
  if ! command -v codex &>/dev/null; then
    jus_ui_warn "No codex command on your PATH, so the skills are linked instead. Once Codex"
    jus_ui_note "is installed, re-run '${PROG_NAME} init' to switch to its plugin:"
    local command
    while IFS= read -r command; do
      jus_ui_cmd "$command"
    done < <(jus_codex_plugin_commands)
    jus_record_skipped "The Codex plugin install: the codex CLI is not on your PATH"
    return 1
  fi

  jus_ui_note "Installing the jus plugin for Codex..."
  if ! output="$(cd "$project_root" && codex plugin marketplace add "$JUS_CODEX_MARKETPLACE_SOURCE" 2>&1 </dev/null \
    && codex plugin add jus@jus-skills 2>&1 </dev/null)"; then
    jus_ui_fail "Codex could not install it, so the skills are linked instead:"
    jus_ui_note "$(sed 's/^/  /' <<<"$output")"
    return 1
  fi
  jus_ui_done "Installed the jus plugin."
  jus_ui_note $'Codex plugins load in every project on this machine; the enforcement hooks do\nnothing outside a jus project. The skills load from the next Codex session.'
  jus_record_setup_action $'Installed the jus plugin for Codex,\nwhich loads in every project on this machine — undo with: codex plugin remove jus@jus-skills'
  return 0
}

# Is the jus plugin installed and enabled? 0 yes, 1 no, 2 cannot tell. Codex's
# own listing, one row per plugin: `jus@jus-skills  installed, enabled  …`.
jus_codex_plugin_enabled() {
  local listing
  command -v codex &>/dev/null || return 2
  listing="$(codex plugin list 2>/dev/null </dev/null)" || return 2
  if grep -qE '^jus@jus-skills[[:space:]]+installed, enabled' <<<"$listing"; then
    return 0
  fi
  return 1
}

# The hooks file the installed plugin registers, or exit 1. The newest cached
# version is the one Codex runs; an older bundle has no .codex-plugin/ at all.
jus_codex_plugin_hooks() {
  local cache="${CODEX_HOME:-${HOME}/.codex}/plugins/cache/jus-skills/jus" newest
  newest="$(printf '%s\n' "$cache"/*/ | sort -V | tail -1)"
  jus_plugin_hooks_file "${newest%/}" ".codex-plugin/plugin.json"
}

# ── the tool's own plugin, where `jus init` uses one (#4833, #4836) ──────────
#
# One dispatch per question, so the installer and `jus doctor` cannot disagree
# about which tools take a plugin. A tool not listed has no plugin route.

jus_tool_plugin_install() {
  case "$1" in
    qwen) jus_qwen_install_extension "$2" ;;
    codex) jus_codex_install_plugin "$2" ;;
    *) return 1 ;;
  esac
}

# 0 serves this project, 1 does not, 2 cannot tell.
jus_tool_plugin_enabled() {
  case "$1" in
    qwen) jus_qwen_extension_enabled "$2" ;;
    codex) jus_codex_plugin_enabled ;;
    *) return 1 ;;
  esac
}

jus_tool_plugin_hooks() {
  case "$1" in
    qwen) jus_qwen_extension_hooks ;;
    codex) jus_codex_plugin_hooks ;;
    *) return 1 ;;
  esac
}

# What the tool calls it, and the tool's short name, for messages.
jus_tool_plugin_kind() {
  case "$1" in
    qwen) echo "extension" ;;
    *) echo "plugin" ;;
  esac
}

jus_tool_plugin_brand() {
  case "$1" in
    qwen) echo "Qwen" ;;
    codex) echo "Codex" ;;
    *) jus_ai_tool_name "$1" ;;
  esac
}

# The skills roots whose clone links the plugin would load a second time, one
# per line. Qwen reads both of its roots, so the extension doubles either
# (#4833 measured .qwen/skills, #5189 .agents/skills, both on qwen).
jus_tool_plugin_shadowed_roots() {
  case "$1" in
    qwen) printf '%s\n' ".qwen/skills" ".agents/skills" ;;
    codex) echo ".agents/skills" ;;
    *) : ;;
  esac
}

# `rm <root>/<name> …` for the clone links under a project root, or nothing.
jus_clone_links_rm_line() {
  local project_root="$1" root="$2" names
  names="$(jus_clone_skill_links "${project_root}/${root}")"
  [[ -n "$names" ]] || return 0
  printf 'rm %s\n' "$(sed "s|^|${root}/|" <<<"$names" | tr '\n' ' ' | sed 's/ $//')"
}

# Is the jus extension enabled for this project? 0 yes, 1 no, 2 cannot tell.
#
# ⚠️ QWEN'S OWN LISTING, NOT ITS FILES. Enablement is a list of ordered path
# rules in ~/.qwen/extensions/extension-enablement.json, and on 0.24.0 that file
# is a projection of a store Qwen keeps elsewhere, so reading it here would
# reimplement Qwen's precedence. `extensions list`, run in the project, prints
# `✓ jus (<version>)` for an extension active here and `✗` for one that is not.
# 0.4 s, measured on #4833.
jus_qwen_extension_enabled() {
  local project_root="$1" listing
  command -v qwen &>/dev/null || return 2
  listing="$(cd "$project_root" && qwen extensions list 2>/dev/null </dev/null)" || return 2
  if grep -q '^✓ jus (' <<<"$listing"; then
    return 0
  fi
  return 1
}

# Where the shared skills-bundle clone lives (#4241): ~/.jus-skills unless
# JUS_SKILLS_DIR says otherwise.
#
# ⚠️ EVERY SITE CALLS THIS, OR THE OVERRIDE IS WORSE THAN NONE. Seven places
# used to build the path inline, and they do not all install: the bridge
# remover decides whether a symlink under .claude/skills/ is ours to retire by
# testing its target against this path. Honoured by the installer and not by the
# remover, the bridge links are never retired and the skills are then served
# twice — the #1846 duplication that #2197's handoff exists to prevent, and it
# reports nothing, because "nothing to retire" is that function's silent no-op.
#
# ⚠️ A function rather than a constant, so HOME is read when it is called. The
# spec harness sources this file once and runs each case under its own fake
# HOME, which a value frozen at source time would defeat.
#
# ⚠️ `:-` rather than `-`, so an exported-but-empty JUS_SKILLS_DIR falls back
# instead of resolving the clone to `/.jus-skills` — an empty environment
# variable is how a shell wrapper passes "unset", and rooting a git clone at /
# is not a failure worth being clever about.
#
# An environment variable rather than .jus/config/: the clone is machine-level,
# so a per-project config file would let one repo set a path every other repo on
# the machine also uses.
jus_bundle_clone_dir() {
  printf '%s' "${JUS_SKILLS_DIR:-${HOME}/.jus-skills}"
}

# ── resolving the bundle at run time (#4759) ─────────────────────────────────
#
# ⚠️ A FALLBACK CHAIN, NOT A PRECEDENCE ORDER. First one found wins. It is not
# layering overrides the way git config or eslint do — those run
# most-specific-first — so this order looks inverted to anyone who reads it as
# precedence, and will be "fixed" to project-first by someone who does.
#
# ⚠️ AND A PROJECT COPY IS DELIBERATELY NOT IN IT. Five of the eight manifests
# are committed project files — Cursor, Codex, Gemini, Windsurf and Qwen. Today
# a committed manifest can NAME a guard script and can never SUPPLY one. Let a
# working-directory `hooks/` tree win and a hostile repository ships both the
# manifest and the scripts, and opening the clone runs its code. These are the
# guards; the thing being constrained does not get to choose which ones run.
#
# Echoes "<source>\t<path>". Exit 1 means that path is not there — the path is
# still echoed, because naming what is missing is the whole point.
jus_bundle_resolve() {
  local prefix

  # An explicit act by the user wins outright, present or not: a typo should
  # fail where it was made rather than quietly resolve to a different bundle.
  if [[ -n "${JUS_SKILLS_DIR:-}" ]]; then
    printf 'JUS_SKILLS_DIR\t%s\n' "$JUS_SKILLS_DIR"
    if [[ -d "$JUS_SKILLS_DIR" ]]; then return 0; else return 1; fi
  fi

  # ⚠️ THE PREFIXES ARE LISTED, NOT ASKED FOR. `brew --prefix` is a subprocess
  # and this runs on every hook of every turn; three `-d` tests cost nothing.
  # The three are brew's own: Apple Silicon, Intel, and Linuxbrew.
  # JUS_BREW_PREFIX REPLACES the list rather than extending it, so a spec can
  # say "no brew here" and not depend on the machine it runs on.
  for prefix in ${JUS_BREW_PREFIX:-/opt/homebrew /usr/local /home/linuxbrew/.linuxbrew}; do
    [[ -d "${prefix}/share/jus/hooks" ]] || continue
    printf 'the Homebrew prefix\t%s\n' "${prefix}/share/jus"
    return 0
  done

  printf 'the ~/.jus-skills clone\t%s\n' "${HOME}/.jus-skills"
  if [[ -d "${HOME}/.jus-skills" ]]; then return 0; else return 1; fi
}

# The resolved bundle directory, or exit 1 with nothing on stdout.
jus_bundle_dir() {
  local line
  line="$(jus_bundle_resolve)" || return 1
  printf '%s' "${line#*$'\t'}"
}

# ── measuring bundle-vs-CLI skew (#4776) ────────────────────────────────────
#
# The case for moving the bundle into the Homebrew prefix rests on one claim:
# that the bundle and the CLI drift apart, because the CLI comes from the tap
# and the bundle from a clone the user pulls by hand. These two are what make
# that claim measurable rather than arguable.
#
# ⚠️ OFFLINE, ALWAYS. `jus doctor` is the wiring check and runs on every
# session-start probe; a version comparison that reaches the network turns a
# fast local answer into one that hangs behind a captive portal.

# The bundle's own version, from the manifest already inside it.
#
# ⚠️ NO `jq`. Every other jq-dependent path in this CLI degrades with a
# message; this is a diagnostic line, and needing jq would make it the one
# check that silently disappears on a machine without it.
jus_bundle_version() {
  local manifest="${1}/.claude-plugin/plugin.json"
  [[ -f "$manifest" ]] || return 1
  grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$manifest" \
    | head -1 \
    | sed -E 's/.*"([^"]*)"$/\1/' \
    | grep . || return 1
}

# How many days since the bundle clone's last commit, or exit 1 when the
# bundle is not a clone.
#
# ⚠️ "NOT A CLONE" IS AN ANSWER, NOT A ZERO. A brew-installed bundle has no git
# history — which is the whole point of #4776 — and a zero there would read as
# "pulled today", making the drift measurement say the opposite of the truth on
# exactly the machines the change is for.
#
# ⚠️ AND THE TOPLEVEL HAS TO MATCH. `git -C` walks up, so a bundle sitting
# inside another repository would otherwise report that repository's age.
jus_bundle_age_days() {
  local dir="$1" toplevel committed
  toplevel="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$toplevel" == "$(cd "$dir" && pwd -P)" ]] || return 1
  committed="$(git -C "$dir" log -1 --format=%ct 2>/dev/null)" || return 1
  [[ -n "$committed" ]] || return 1
  printf '%s\n' "$(( ( $(date +%s) - committed ) / 86400 ))"
}

# ⚠️ AN EXPLICIT MAP, NOT A GLOB OF `*-adapt.sh`. A glob answers whatever is in
# the directory, so a bundle carrying two adapters — or none — resolves to
# something arbitrary and runs it. The tool names are the manifest directories;
# only Kimi's file is not named after its directory.
jus_hook_adapter_file() {
  case "$1" in
    cursor) printf 'jus-cursor-adapt.sh\n' ;;
    codex) printf 'jus-codex-adapt.sh\n' ;;
    gemini) printf 'jus-gemini-adapt.sh\n' ;;
    copilot) printf 'jus-copilot-adapt.sh\n' ;;
    windsurf) printf 'jus-windsurf-adapt.sh\n' ;;
    qwen) printf 'jus-qwen-adapt.sh\n' ;;
    antigravity) printf 'jus-antigravity-adapt.sh\n' ;;
    kimi-code) printf 'jus-kimi-adapt.sh\n' ;;
    *) return 1 ;;
  esac
}

# `~/…` for a path under HOME, verbatim otherwise — so every message and printed
# recipe about the clone reads exactly as it did before #4241 while the default
# is in force, and shows the real directory when it is not.
jus_tilde_path() {
  local path="$1"
  if [[ -n "${HOME:-}" && "$path" == "${HOME}/"* ]]; then
    # ⚠️ The tilde is a literal for DISPLAY and must not expand — which is the
    # one thing SC2088 exists to warn about, so `printf '~/%s'` is rejected and
    # no inline suppression may silence it. Built from a variable instead: the
    # warning fires on a quoted word that LOOKS like a path, and a bare `~` in
    # an assignment does not.
    local tilde='~'
    printf '%s/%s' "$tilde" "${path#"${HOME}/"}"
  else
    printf '%s' "$path"
  fi
}

# The canonical bundle-install commands (#1972) — one shared machine-level clone
# plus per-skill symlinks in the standard .agents/skills/<name> layout. Every
# surface that prints the recipe goes through here so it can't drift.
#
# $1 = brand slug, optional: Qwen and Codex print their own plugin instead.
#
# ⚠️ QWEN'S RECIPE IS ITS EXTENSION, THEN THE CLONE (#4833). The clone is still
# needed, because the enforcement hooks run from it. Links beside the extension
# would make Qwen declare every skill twice.
jus_print_bundle_link_hint() {
  local clone_dir
  clone_dir="$(jus_tilde_path "$(jus_bundle_clone_dir)")"
  if [[ "${1:-}" == "qwen" ]]; then
    jus_ui_cmd "$(jus_qwen_extension_command)"
    jus_ui_cmd "git clone https://github.com/juscribe/jus-skills.git ${clone_dir}"
    return 0
  fi
  # ⚠️ CODEX'S IS ITS PLUGIN, THEN THE CLONE (#4836), for the same reason.
  if [[ "${1:-}" == "codex" ]]; then
    local command
    while IFS= read -r command; do
      jus_ui_cmd "$command"
    done < <(jus_codex_plugin_commands)
    jus_ui_cmd "git clone https://github.com/juscribe/jus-skills.git ${clone_dir}"
    return 0
  fi
  jus_ui_cmd "git clone https://github.com/juscribe/jus-skills.git ${clone_dir}"
  jus_ui_cmd "mkdir -p .agents/skills && ln -sfn ${clone_dir}/skills/* .agents/skills/"
}

# Print the bundle-install instructions for a skills-capable choice.
# $1 = brand slug, $2 = human tool name. ⚠️ A SLUG: passing the displayed
# menu POSITION routes to `fallback` and prints the wrong recipe (#4877).
jus_print_bundle_install() {
  local choice="$1" tool="$2"
  jus_ui_warn "Load the Juscribe workflow into ${tool} (the SOP as on-demand skills):"
  if [[ "$(jus_sop_method "$choice")" == "plugin" ]]; then
    jus_ui_note "Run these inside Claude Code:"
    jus_ui_cmd "/plugin marketplace add juscribe/jus-skills"
    jus_ui_cmd "/plugin install jus@jus-skills"
    jus_ui_note $'Installs the skills plus the enforcement hooks (Claude Code only).\nThe install ASKS WHICH SCOPE. Pick:'
    jus_ui_note "  Install for all collaborators on this repository (project scope)"
    jus_ui_note $'\'Install for you (user scope)\' is listed first and is the wrong one\nhere: it loads the skills and fires the hooks in every project on\nthis machine, including ones with no .jus directory.\nNon-interactive form, the only one that takes the scope as a flag:'
    jus_ui_cmd "claude plugin install -s project jus@jus-skills"
    jus_ui_note $'Heed the install summary: \'Plugin is now active.\' means done, but\n\'Run /reload-plugins to activate.\' means the skills wait for that\ncommand (Claude Code before v2.1.221 always needs it). Hooks from a\nnewly installed plugin need /reload-plugins either way.\nRe-run \'jus init\' afterwards to verify the install.'
    jus_record_needs_you "Run the two /plugin commands inside Claude Code, then re-run 'jus init'."
  elif [[ "$choice" == "qwen" ]]; then
    jus_ui_note $'Install the jus extension for this project (the skills), and clone the\nbundle once per machine (the enforcement hooks run from it):'
    jus_print_bundle_link_hint "$choice"
    jus_ui_note $'The skills arrive as jus:<name> and update on their own. jus init\noffers the hooks; hooks/qwen/README.md says what they block.'
  elif [[ "$choice" == "codex" ]]; then
    jus_ui_note $'Install the jus plugin for Codex (the skills, in every project on this\nmachine), and clone the bundle once per machine (the hooks run from it):'
    jus_print_bundle_link_hint "$choice"
    jus_ui_note $'The skills arrive as jus:<name>. Trust the hooks with /hooks inside Codex;\nhooks/codex/README.md says what they block.'
  else
    jus_ui_note "Install the bundle once per machine, then link it into the project:"
    jus_print_bundle_link_hint "$choice"
    jus_ui_note $'Loads the SOP as skills in the standard .agents/skills/<name> layout.\nEnforcement hooks ship for every tool in this menu, and jus init\noffers to install yours. What each one can BLOCK differs — read\nhooks/<tool>/README.md for where yours is weaker.'
  fi
}

# The top level of the git repository a folder is in; fails when it is in none,
# or when git is not installed. Asked of git rather than read off the folder
# (#4967): a monorepo package has no `.git` of its own, and a linked worktree
# or a submodule has a `.git` FILE, so `[[ -d .git ]]` answered "not a
# repository" for all three. The path is physical, as git prints it — compare
# it against `pwd -P`, not `$PWD`.
jus_git_toplevel() {
  git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

# Ensures the project is a git repository before anything else (#1907). The
# whole workflow is commit-shaped — agent commits, the enforcement hooks,
# dispatch worktrees, and the .jus/config token guard (#1924) all assume git —
# and a missing repo otherwise only surfaces at first-commit time. Prompted,
# never silent; refused outright in $HOME, where a stray `git init` makes
# every subdirectory look tracked. Declining warns and continues — jus stays
# usable for pure ticket/API work.
#
# ⚠️ GIT DECIDES, NOT A `.git` FOLDER (#4967). A package in a monorepo has
# none of its own, so the old test offered a nested repository there, with Yes
# the default, and accepting hid the package from the monorepo's git. The one
# enclosing repository that does not count is one rooted at $HOME — a dotfiles
# setup — which is never the project's (stakeholder decision, 23 Sep).
jus_offer_git_init() {
  local project_root="$1" toplevel home
  if toplevel="$(jus_git_toplevel "$project_root")"; then
    home="$(cd "$HOME" 2>/dev/null && pwd -P)"
    if [[ "$toplevel" == "$(cd "$project_root" && pwd -P)" ]]; then
      jus_ui_done "Already a git repository."
      return 0
    elif [[ "$toplevel" != "$home" ]]; then
      jus_ui_done "Inside the git repository at $(jus_tilde_path "$toplevel")."
      return 0
    fi
    jus_ui_note "Your home folder is a git repository, but not this project's."
  fi

  if [[ "$project_root" == "$HOME" ]]; then
    jus_ui_warn "Warning: this is your home directory — not offering 'git init' here."
    jus_ui_note "Run 'jus init' from a project directory to get the full workflow."
    jus_record_skipped "Initializing git: this is your home directory"
    return 0
  fi

  # "This folder" rather than the path: the one question re-worded, because
  # the path ran it past column 80 (#4838).
  jus_ui_ask --default Yes "This folder is not a git repository. Initialize one? [Y/n]"
  if [[ "$JUS_UI_ANSWER" =~ ^[Nn] ]]; then
    jus_ui_warn "Skipped. Without git: agent commits, the enforcement hooks, dispatch, and"
    jus_ui_note "the .jus/config token gitignore guard will not function until you 'git init'."
    jus_record_skipped "Initializing git: declined"
    return 0
  fi

  if git -C "$project_root" init -q; then
    jus_ui_done "Initialized git repository in ${project_root}."
    jus_record_setup_action "Initialized git repository in this folder — undo by deleting the new .git folder, before you commit anything"
  else
    jus_ui_warn "Warning: 'git init' failed — continuing without a repository."
  fi
  return 0
}

# Appends one exact line to the project .gitignore unless already present.
# Returns 0 when it appended, 1 when the line was already there; a quiet
# success outside a git repo (nothing to protect). In a monorepo package the
# file is the package's own, which git applies to the paths under it (#4967).
jus_add_gitignore_entry() {
  local project_root="$1" entry="$2"
  local gitignore="${project_root}/.gitignore"
  jus_git_toplevel "$project_root" >/dev/null || return 0
  if [[ ! -f "$gitignore" ]] || ! grep -qxF "$entry" "$gitignore"; then
    printf '%s\n' "$entry" >> "$gitignore"
    return 0
  fi
  return 1
}

# Removes exactly one line from the project .gitignore — a fixed full-line
# match, so a broader pattern a user wrote themselves is never touched.
jus_remove_gitignore_entry() {
  local project_root="$1" entry="$2"
  local gitignore="${project_root}/.gitignore"
  [[ -f "$gitignore" ]] || return 0
  grep -qxF "$entry" "$gitignore" || return 0
  # grep -v exits 1 when nothing survives the filter — an empty result is a
  # legitimate outcome here (the entry was the last line), not a failure.
  grep -vxF "$entry" "$gitignore" > "${gitignore}.tmp" || true
  mv "${gitignore}.tmp" "$gitignore"
}

# Keeps the token out of version control (#1924): .jus/config/ holds the
# bearer token and .jus/tmp/ holds downloads — neither may be committed.
# Idempotent (appends only missing lines); a no-op outside a git repo.
jus_ensure_gitignore() {
  local project_root="$1"
  jus_git_toplevel "$project_root" >/dev/null || return 0

  local entry added=0
  for entry in ".jus/config/" ".jus/tmp/"; do
    if jus_add_gitignore_entry "$project_root" "$entry"; then
      added=1
    fi
  done
  if (( added )); then
    jus_ui_done "Added .jus/config/ and .jus/tmp/ to .gitignore (token stays out of git)."
  fi
  return 0
}

# Declares the jus-skills marketplace and enables the plugin in the project's
# .claude/settings.json (#1923) — the checked-in team-config pattern, so the
# marketplace resolves for everyone who clones the repo.
#
# ⚠️ THIS IS A DECLARATION, NOT AN INSTALL (#3565). It used to be documented as
# one: "Claude Code resolves and installs jus@jus-skills on the next trusted
# launch, no /plugin commands needed." Only the first half is true. Measured on
# 2.1.259 with a trusted project over two launches, extraKnownMarketplaces IS
# honoured while enabledPlugins installs nothing — installed_plugins.json stays
# empty and no skill loads. jus_claude_cli_install_plugin does the install.
# Deep-merges so sibling keys, marketplaces, and plugins survive; idempotent.
# Returns 1 without jq or when the existing file isn't valid JSON — callers
# fall back to the printed /plugin instructions.
jus_write_claude_plugin_settings() {
  local project_root="$1"
  local settings_dir="${project_root}/.claude"
  local settings_file="${settings_dir}/settings.json"
  # autoUpdate is the field that keeps the bundle current (#3194). Claude Code
  # defaults it to OFF for every third-party marketplace, so writing the
  # declaration without it opted every user we set up out of updates — measured
  # 19 days of drift against the official marketplace on one daily-driven Mac.
  # ⚠️ It only takes effect once the folder is TRUSTED: an untrusted project's
  # settings are ignored for this and the value never reaches
  # known_marketplaces.json. That is the same prompt the user answers on their
  # first launch here, so it costs nothing — but it is why a scratch project
  # that was never trusted shows no autoUpdate key and looks like a no-op.
  local desired='{"extraKnownMarketplaces":{"jus-skills":{"source":{"source":"github","repo":"juscribe/jus-skills"},"autoUpdate":true}},"enabledPlugins":{"jus@jus-skills":true}}'

  command -v jq &>/dev/null || return 1

  local current="{}"
  if [[ -s "$settings_file" ]]; then
    current=$(cat "$settings_file")
    jq -e . <<<"$current" >/dev/null 2>&1 || return 1
  fi

  local merged
  merged=$(jq -n --argjson cur "$current" --argjson want "$desired" '$cur * $want')
  if [[ "$(jq -S . <<<"$current")" == "$(jq -S . <<<"$merged")" ]]; then
    jus_ui_done ".claude/settings.json already declares the jus-skills marketplace + plugin."
    return 0
  fi

  mkdir -p "$settings_dir"
  printf '%s\n' "$merged" > "${settings_file}.tmp" && mv "${settings_file}.tmp" "$settings_file"
  jus_ui_done $'Declared the jus-skills marketplace + enabled jus@jus-skills\nin .claude/settings.json.'
  jus_record_setup_action $'Declared the jus@jus-skills plugin in .claude/settings.json,\nso teammates get it too — undo by removing its marketplace and enabledPlugins entries'
  jus_ui_note $'Checked in, this travels with the repo, so teammates resolve\nthe marketplace too.'
}

# Installs the plugin through the Claude Code CLI (#3565) — the step `jus init`
# used to only describe.
#
# ⚠️ WRITING enabledPlugins IS NOT AN INSTALL, and the halves fail apart in the
# most convincing possible way. Measured on Claude Code 2.1.259, a trusted
# project, two launches: `extraKnownMarketplaces` IS honoured — the marketplace
# clones and `autoUpdate: true` lands in known_marketplaces.json — while
# `installed_plugins.json` stays `{"version":2,"plugins":{}}` and not one `jus:`
# skill loads. So everything a user checks says wired up, and nothing is.
#
# That is why this shells out. The alternative was leaving `jus init` to print
# instructions, and in the cold start this came from the thing reading `jus
# init`'s output was an AGENT, not a person — instructions there are one relay
# away from being lost, which is exactly what happened.
#
# -s project, never the user-scope default: a user-scope install would put the
# plugin into every checkout on the machine, including the repo that PRODUCES
# the bundle, where both copies then register and every hook fires twice
# (#2348).
#
# ⚠️ Branch on the EXIT CODE. `claude plugin install` prints its failure to
# stdout ("✘ Failed to install plugin …") and a pipeline reading that output
# masks the status; the real exit is 1 on failure, 0 on success. Marketplace-add
# is idempotent — "already on disk" is a 0 — so its status says nothing about
# whether we are set up, and the install is the only thing worth testing.
jus_claude_cli_install_plugin() {
  local project_root="$1"
  command -v claude &>/dev/null || return 1

  jus_ui_note "Installing the jus@jus-skills plugin for Claude Code..."
  claude plugin marketplace add juscribe/jus-skills >/dev/null 2>&1 || true

  # Capture rather than discard: the CLI's own message is the only thing that
  # says WHY, and the caller's fallback ("run these /plugin commands") reads as
  # a choice we made rather than a failure we hit without it.
  local install_output
  if ! install_output=$(cd "$project_root" && claude plugin install -s project jus@jus-skills 2>&1); then
    jus_ui_fail "The Claude Code CLI could not install it:"
    jus_ui_note "$(sed 's/^/  /' <<<"$install_output")"
    return 1
  fi

  jus_ui_done "Installed jus@jus-skills (scope: project)."
  jus_record_setup_action "Installed the jus@jus-skills plugin for Claude Code (project scope) — undo with: claude plugin uninstall -s project jus@jus-skills"
  jus_ui_warn "Restart Claude Code, or run /reload-plugins, before the workflow is live."
  jus_ui_note "A session already running has neither the skills nor the enforcement hooks."
  jus_record_needs_you "Restart Claude Code, or run /reload-plugins, before the workflow is live."
  return 0
}

# Asks before installing (#3567, stakeholder request following #3565), and
# presents the alternative: run the /plugin steps yourself.
#
# A decline returns nonzero, which is all it takes — the caller's fallback
# branch already prints the /plugin commands, bridges .claude/skills/ so the SOP
# is usable meanwhile, and offers the reminder chore. "They would run the steps
# themselves" needed no new code; it needed a way to reach that branch on
# purpose rather than only by jq being absent.
#
# ⚠️ NO TTY INSTALLS ANYWAY, WHICH IS THE OPPOSITE OF jus_ensure_bundle_clone
# TEN LINES AWAY — deliberately, not by oversight. That one reads EOF as a
# decline because cloning into someone's $HOME unasked is the surprising act.
# Here the surprising act is the reverse: `jus init` is commonly run BY AN AGENT
# through a Bash tool with no terminal attached — the cold start #3565 came from
# — so treating "nobody answered" as "no" would leave exactly the motivating
# case with no plugin and no hooks. It says which default it took and why.
#
# The read's exit status is the signal rather than [[ -t 0 ]]: a closed or empty
# stdin fails the read either way, and gating on the terminal test would make
# every piped-answer test unreachable — which is how this suite already drives
# jus_offer_plugin_chore.
jus_offer_plugin_install() {
  local project_root="$1"
  # Nothing to install with. The caller prints the /plugin commands.
  if ! command -v claude &>/dev/null; then
    jus_record_skipped $'The Claude plugin install: the claude CLI is not on your PATH\n— run the /plugin commands shown above instead'
    return 1
  fi

  jus_ui_note "The jus@jus-skills plugin carries the SOP skills and the enforcement hooks."
  jus_claude_cli_install_plugin "$project_root"
}

# The reminder-chore request body, extracted so the reload-to-activate guidance
# is testable (#2194): the chore is the surface the stakeholder actually
# follows, and a plugin install is not always active in the running session.
jus_plugin_chore_body() {
  printf '%s' '{"ticket":{"title":"Install the jus skills plugin in Claude Code","ticket_type":"chore","points":0,"description":"Run these inside Claude Code, in this project:\n\n```\n/plugin marketplace add juscribe/jus-skills\n/plugin install jus@jus-skills\n```\n\n**At the scope prompt pick `Install for all collaborators on this repository (project scope)`.** `Install for you (user scope)` is listed first and is the wrong one here: it loads the skills and fires the enforcement hooks in every project on this machine, including ones with no `.jus` directory.\n\nIf the install summary says `Run /reload-plugins to activate.`, run that too — the skills are not active until you do, and hooks from a newly installed plugin always need it.\n\nThen **accept this ticket** — or re-run `jus init`, which verifies the install and closes this chore automatically."}}'
}

# Files a board chore reminding the user to install the Claude Code plugin
# (#1925). Offered right when the instructions print — before any interactive
# hand-off — so a killed terminal can't lose the reminder; the board carries
# it. Idempotent via the .jus/config/plugin_ticket_id marker. Best-effort:
# an API failure warns and continues, never blocking init.
jus_offer_plugin_chore() {
  local config_dir="$1" token="$2" ws_id="$3"
  local marker="${config_dir}/plugin_ticket_id"
  if [[ -f "$marker" ]]; then
    jus_ui_done "Reminder chore already filed (ticket #$(cat "$marker"))."
    return 0
  fi

  jus_ui_ask --default Yes "File a reminder chore on your board for the plugin install? [Y/n]"
  [[ "$JUS_UI_ANSWER" =~ ^[Nn] ]] && return 0

  local body response ticket_id
  body=$(jus_plugin_chore_body)
  response=$(curl -s -X POST \
    -K <(jus_curl_auth "$token") \
    -H "Content-Type: application/json" \
    -H "Accept: application/json" \
    -d "$body" \
    "${BASE_URL}/api/v1/workspaces/${ws_id}/tickets")
  ticket_id=$(json_val "$response" '.ticket.id')
  if [[ -n "$ticket_id" && "$ticket_id" != "null" ]]; then
    printf '%s' "$ticket_id" > "$marker"
    jus_ui_done "Filed reminder chore #${ticket_id} on your board."
    jus_record_setup_action "Filed ticket #${ticket_id} on your board as a reminder to install the Claude plugin — undo by cancelling #${ticket_id} on the board"
  else
    jus_ui_warn "Could not file the reminder chore — continuing without it."
  fi
  return 0
}

# Closes the plugin-install chore once jus init verifies the install (#1925):
# comments, then walks the state chain to delivered (accepting stays with the
# human), and clears the marker. Each step is best-effort — the stakeholder
# may have moved or closed the ticket already.
jus_close_plugin_chore() {
  local config_dir="$1" token="$2" ws_id="$3"
  local marker="${config_dir}/plugin_ticket_id"
  [[ -f "$marker" ]] || return 0

  local ticket_id base state
  ticket_id=$(cat "$marker")
  base="${BASE_URL}/api/v1/workspaces/${ws_id}/tickets/${ticket_id}"
  curl -s -X POST \
    -K <(jus_curl_auth "$token") \
    -H "Content-Type: application/json" \
    -d '{"comment":{"body":"✓ Verified: `jus init` detected the jus@jus-skills plugin installed."}}' \
    "${base}/comments" >/dev/null 2>&1
  for state in prioritized started finished delivered; do
    curl -s -X PATCH \
      -K <(jus_curl_auth "$token") \
      -H "Content-Type: application/json" \
      -d "{\"state\":\"${state}\"}" \
      "${base}/transition" >/dev/null 2>&1
  done
  rm -f "$marker"
  jus_ui_done "Closed reminder chore #${ticket_id} (plugin verified installed)."
  jus_record_setup_action "Closed reminder ticket #${ticket_id}: the Claude plugin is installed — undo by reopening #${ticket_id} on the board"
}

# Whether the repo carries the bundle as a committed copy (#2195): a bundle
# skill under .claude/skills/ that is git-TRACKED. Tracked is the load-bearing
# word — a committed copy travels with the repo and already serves the skills
# (and, via committed settings, the hooks), so declaring the plugin on top
# double-registers both; commit 88d3a56a (#1846) did exactly that to the
# repository that produces the bundle. An untracked entry is the opposite
# case: the bridge links `jus init` itself creates to tide a project over
# until the plugin installs must never suppress that install. Outside a git
# repo, git fails → false.
jus_committed_bundle_present() {
  local project_root="$1" name
  for name in ticket-workflow hard-rules; do
    if git -C "$project_root" ls-files --error-unmatch ".claude/skills/${name}" &>/dev/null; then
      return 0
    fi
  done
  return 1
}

# The committed-copy skip explanation, extracted for testability (#2195).
jus_print_committed_copy_skip() {
  jus_ui_done $'Juscribe bundle already wired via a committed copy\n(.claude/skills/ tracked in git).'
  jus_ui_note $'Skipping the marketplace/plugin declaration — installing the plugin\non top would double-register every skill and hook. See jus/README.md,\nOption H.'
}

# Whether the jus@jus-skills Claude Code plugin is actually installed (#1922).
# Two registries matter: enabledPlugins in the settings files (the declarative
# path), and ~/.claude/plugins/installed_plugins.json — where a manual
# /plugin install and the next-launch auto-install record the fact. On a
# machine where no settings file carries the string, the registry is the ONLY
# trace, and missing it left the #2197 bridge unretired and the #1925 chore
# unclosed. A heuristic grep, not a contract — good enough to verify instead
# of blindly re-printing install instructions.
jus_plugin_installed() {
  local project_root="$1" f
  for f in "$HOME/.claude/settings.json" \
           "$project_root/.claude/settings.json" \
           "$project_root/.claude/settings.local.json"; do
    [[ -f "$f" ]] && grep -q '"jus@jus-skills"' "$f" && return 0
  done
  jus_plugin_registry_installed "$project_root"
}

# The installed_plugins.json half of the check (#2197). With jq the check is
# scope-aware — a user-wide entry counts everywhere, a project-scoped entry
# only for THIS project (a bridge elsewhere must not be retired by someone
# else's install). Without jq, a plain grep: over-detection beats the
# never-detection that strands the bridge.
#
# ⚠️ THE SCOPE-AWARE HALF KEYS ON `projectPath`, NOT ON THE SCOPE STRING, AND
# THAT IS THE WHOLE FIX (#4005). It read `.scope != "project"` — a value Claude
# Code never writes. The two it does write are `user` (machine-wide, no
# `projectPath`) and **`local`** (one project, with a `projectPath`), so the
# guard excluded nothing and the jq branch collapsed into the no-jq fallback
# below it: "is jus@jus-skills mentioned anywhere on this machine".
#
# The blast radius was not a stray prompt. `jus init` treats a true here as
# "already installed", which sets `do_append=0` — so a brand-new project on a
# machine that had ever installed the plugin ANYWHERE got no plugin
# declaration, no bridge and no appended SOP, and finished clean. Reported from
# a second computer on #3999, then reproduced against a `mktemp -d` repo here.
#
# ⚠️ A present-but-empty `projectPath` reads as machine-wide, deliberately —
# an entry that names no project cannot be excluded from one. Keying on the
# field rather than the vocabulary is what keeps this correct if Claude Code
# adds or renames a scope, which is exactly how it broke the first time.
#
# ⚠️ `projectPath` IS PHYSICAL; PROJECT_ROOT IS NOT (#5405). Claude Code
# records its working directory with symlinks resolved, while PROJECT_ROOT
# keeps the path the user `cd`'d through. Measured: a `--scope local` install
# from a folder reached through a link recorded the real folder, and this
# answered "not installed" there. So BOTH sides are resolved before comparing
# — an entry spelled through a link, by hand or by a Claude Code that stops
# resolving, is not the next miss. jq cannot resolve a path, hence the loop.
# An entry whose folder is gone resolves to nothing and matches only verbatim.
jus_plugin_registry_installed() {
  local project_root="$1" physical path
  local registry="$HOME/.claude/plugins/installed_plugins.json"
  [[ -f "$registry" ]] || return 1
  grep -q '"jus@jus-skills"' "$registry" || return 1
  if command -v jq &>/dev/null; then
    physical="$(cd "$project_root" 2>/dev/null && pwd -P)" || physical="$project_root"
    while IFS= read -r path; do
      [[ -z "$path" || "$path" == "$project_root" ]] && return 0
      [[ "$(cd "$path" 2>/dev/null && pwd -P)" == "$physical" ]] && return 0
    done < <(jq -r '.plugins["jus@jus-skills"] // [] | .[] | .projectPath // ""' "$registry" 2>/dev/null)
    return 1
  else
    return 0
  fi
}

# Whether the plugin is installed MACHINE-WIDE — an entry carrying no
# `projectPath` (#4403). Deliberately NARROWER than the check above, which
# counts such an entry as installed *here* and is right to: the plugin really
# is active in this project. What nothing said is that it is equally active in
# every OTHER project on this computer, including ones never wired to Juscribe.
#
# ⚠️ DO NOT FOLD THIS INTO jus_plugin_registry_installed. Narrowing what counts
# as installed is the #4005 regression — a project-scoped install elsewhere
# leaving a new project with no declaration, no bridge and no appended SOP —
# and the two questions genuinely differ: "is it active here" versus "is it
# active everywhere".
#
# Keyed on `projectPath` rather than the scope string, for the same reason
# #4005 gives: an absent or empty field is what marks a machine-wide entry, and
# the scope vocabulary has already been renamed underneath us once.
#
# Returns 1 without jq — a warning we cannot substantiate is worse than
# silence, and the grep fallback below the jq branch above cannot tell the two
# shapes apart at all.
jus_plugin_installed_machine_wide() {
  local registry="$HOME/.claude/plugins/installed_plugins.json"
  [[ -f "$registry" ]] || return 1
  command -v jq &>/dev/null || return 1
  jq -e '.plugins["jus@jus-skills"] // [] | map(select((.projectPath // "") == "")) | length > 0' \
    "$registry" >/dev/null 2>&1
}

# Says so when the install serving this project is the machine-wide one, and
# names the way to narrow it (#4403). Prints nothing otherwise, so it is safe
# to call unconditionally from the already-installed branch of `jus init`.
#
# ⚠️ A NOTE, NOT A PROMPT. `jus init` has already established the plugin is
# installed and working; the scope is a preference the user may hold on
# purpose. Offering to uninstall would put a destructive choice behind an
# answer nobody asked for.
jus_warn_machine_wide_plugin() {
  jus_plugin_installed_machine_wide || return 0
  jus_ui_warn "Note: that install is MACHINE-WIDE — its registry entry names no"
  jus_ui_note $'project, so the skills load and the enforcement hooks fire in\nevery project on this computer, including ones with no .jus dir.\nTo narrow it, run inside Claude Code:'
  jus_ui_cmd "/plugin uninstall jus@jus-skills"
  jus_ui_note "then install again and pick:"
  jus_ui_note "  Install for all collaborators on this repository (project scope)"
  jus_ui_note "Or non-interactively:"
  jus_ui_cmd "claude plugin install -s project jus@jus-skills"
}

# Whether a legacy appended SOP block sits in the tool's context file. With
# the plugin installed too, the frozen context-file copy shadows/duplicates
# the versioned skills — worth a warning (#1922).
jus_sop_block_present() {
  [[ -f "$1" ]] && grep -q "# Juscribe Workflow SOP" "$1"
}

# The file carrying an appended SOP for this tool, or nothing: its target, and
# for Claude Code the CLAUDE.md family a pre-#4866 `jus init` wrote to. That
# copy is still read, so it is left where it is and never appended a second
# time.
#
# ⚠️ FOR CLAUDE CODE, A FOLDER ABOVE TOO (#4970) — a monorepo's root CLAUDE.md
# with an old append. Claude Code reads it in the package, so it counts, and is
# printed as an ABSOLUTE path where the project's own are relative names: that
# is how a caller tells a file this project does not own. The project is
# checked first, so a project with no copy above behaves as it did (#4866).
jus_legacy_sop_carrier() { # <slug> <project_root> <context_file>
  local slug="$1" project_root="$2" name
  shift 2
  if [[ "$slug" == "claude" ]]; then
    set -- "$@" "${JUS_CLAUDE_NAMES[@]}"
  fi
  for name in "$@"; do
    if jus_sop_block_present "${project_root}/${name}"; then
      printf '%s\n' "$name"
      return 0
    fi
  done
  [[ "$slug" == "claude" ]] && jus_claude_parent_carrier "$project_root" jus_sop_block_present
}

# A pre-#1972 install cloned the whole repo to .agents/skills/jus, nesting
# SKILL.md one level too deep for tools with non-recursive skill discovery.
# Offers to convert it to the standard layout: the clone moves to the shared
# clone directory when that slot is free, else the nested copy is just removed
# (it is a plain clone of the public repo — nothing user-authored lives inside).
# $2 = brand slug, optional, so the printed manual recipe is the tool's own —
# Qwen's extension and Codex's plugin print instead of the links.
jus_migrate_legacy_bundle() {
  local legacy="${1}/.agents/skills/jus"
  local clone_dir display
  clone_dir="$(jus_bundle_clone_dir)"
  display="$(jus_tilde_path "$clone_dir")"
  jus_ui_warn "Legacy bundle clone detected at .agents/skills/jus (nested layout)."
  jus_ui_ask --default Yes "Migrate it to the standard .agents/skills/<name> layout? [Y/n]"
  if [[ "$JUS_UI_ANSWER" =~ ^[Nn] ]]; then
    jus_ui_note "Leaving it in place. To migrate manually:"
    jus_print_bundle_link_hint "${2:-}"
    jus_ui_cmd "rm -rf .agents/skills/jus"
    return 1
  fi
  if [[ -d "$clone_dir" ]]; then
    rm -rf "$legacy"
    jus_ui_done "Removed the legacy nested clone (shared clone already at ${display})."
  else
    mv "$legacy" "$clone_dir"
    jus_ui_done "Migrated the legacy clone to ${display}."
  fi
}

# Makes sure the shared clone (#4241) exists and carries a skills/
# directory. Returns 0 when usable; 1 when the clone failed or is hollow —
# callers print their own recovery hint (the .agents/skills recipe and the
# .claude/skills bridge recover differently). It reads no input (#4824).
#
# ⚠️ THE EXPLANATION IS KEPT (#4756) THOUGH THE QUESTION IS GONE (#4824). It
# was written for a person about to answer; it now tells them what just
# happened to their home directory and why, which they are still owed.
#
# ⚠️ AND THE REASON FOR THE HOME DIRECTORY IS COPILOT AND KIMI, NOT SHARING
# (stakeholder ruling, 2026-09-21). Their hook config is ~/.copilot/settings.json
# and ~/.kimi-code/config.toml, both read in every project. Two of the eight
# tools have no other option — the convenience argument is true and is not the
# binding one.
#
# ⚠️ THE MECHANISM CLAUSE CHANGED WITH #4759 AND THE RULING DID NOT (#4790). This
# used to end "so a path written there has to be valid machine-wide", and after
# the launcher there is no path written there at all — every command in those
# files is `jus hook <name>`. What still makes one clone per machine the answer
# is jus_bundle_resolve: JUS_SKILLS_DIR, the Homebrew prefixes and ~/.jus-skills
# are all machine-wide, and a project copy is deliberately NOT in that chain, so
# a per-project clone is not something any of the eight could find.
#
# $2 = what a failed clone costs, optional. Qwen's skills come from its
# extension (#4833), so there a failed clone costs the hooks alone, and the
# default sentence would say the skills were missing when they were not.
jus_ensure_bundle_clone() {
  local tool="$1" cost="${2:-neither the skills nor the hooks are in place}"
  local clone_dir display
  clone_dir="$(jus_bundle_clone_dir)"
  display="$(jus_tilde_path "$clone_dir")"

  # ⚠️ NOT ASKED SINCE #4824 (stakeholder, 2026-09-22). Every caller runs only
  # after the person chose "Install the bundle", and a second yes/no could only
  # undo that choice. The explanation #4756 asked for is still printed, as the
  # clone happens, and the clone is logged under "Setup Complete".
  if [[ ! -d "$clone_dir" ]]; then
    jus_ui_note "Cloning the Juscribe skills bundle to ${display} for ${tool} —"
    jus_ui_note $'github.com/juscribe/jus-skills, public and read-only; nothing in it\nruns at clone time. One clone per machine, not per project: Copilot and\nKimi read their hook config from your home directory in every project,\nand jus only ever looks for the bundle in machine-wide places —\nJUS_SKILLS_DIR, or this one — never inside a project.'
    if ! git clone https://github.com/juscribe/jus-skills.git "$clone_dir"; then
      jus_ui_fail "The clone failed, so ${cost}."
      return 1
    fi
    jus_ui_done "Done. Undo it any time with: rm -rf ${display}"
    jus_record_setup_action "Cloned the skills bundle to ${display} — undo with: rm -rf ${display}"
  else
    jus_ui_done "Skills bundle clone present at ${display}."
    jus_ui_note "Update it with: git -C ${display} pull"
  fi

  [[ -d "${clone_dir}/skills" ]] || return 1
  return 0
}

# Symlinks every skill in the clone into one destination directory, creating it
# if needed. Split out of jus_install_bundle (#4257) because a tool can need the
# same links in two places.
jus_link_bundle_skills() {
  local clone_dir="$1" dest="$2"
  mkdir -p "$dest"
  local skill_dir
  for skill_dir in "${clone_dir}"/skills/*/; do
    [[ -d "$skill_dir" ]] || continue
    ln -sfn "${skill_dir%/}" "${dest}/$(basename "$skill_dir")"
  done
}

# Actually installs the cross-tool skills bundle for non-Claude tools (#1922),
# in the standard .agents/skills/<name>/SKILL.md layout (#1972): one shared
# clone (~/.jus-skills, or JUS_SKILLS_DIR) plus per-skill symlinks. Never a nested clone inside
# the skills dir — that layout only loads on tools whose skill discovery
# happens to recurse (openai/codex#22275 asks for exactly that to be removed).
# Idempotent: an existing clone is left alone (suggest pull) and links are
# re-pointed; a failed clone falls back to printed instructions.
#
# $3 = brand slug, optional. Only .agents/skills/ is written, whatever the tool:
# every one this CLI routes to skills reads it. Qwen had a second root here,
# .qwen/skills/, on the belief that it did not (#4257); it has since 0.13.0,
# and de-duplicates a skill found in both (#5189, measured on 0.24.3). Kimi
# 2.0.2 reads it too (#4764). ⚠️ A SECOND ROOT NEEDS A MEASUREMENT, NOT A DOC
# READ — a speculative one writes symlinks into a directory nobody opens. Qwen
# reaches this only as the fallback, when its extension could not go in (#4833).
jus_install_bundle() {
  local project_root="$1" tool="$2" choice="${3:-}"
  local clone_dir
  clone_dir="$(jus_bundle_clone_dir)"
  local dest="${project_root}/.agents/skills"

  if [[ -d "${dest}/jus" ]]; then
    jus_migrate_legacy_bundle "$project_root" "$choice" || return 0
  fi

  if ! jus_ensure_bundle_clone "$tool"; then
    jus_ui_note "Install it later with:"
    jus_print_bundle_link_hint "$choice"
    return 0
  fi

  jus_link_bundle_skills "$clone_dir" "$dest"
  jus_ui_done "Linked the bundle skills into .agents/skills/ (standard layout)."
  jus_record_setup_action "Linked the Juscribe skills into .agents/skills/ — undo by removing the links there that point into $(jus_tilde_path "$clone_dir")"
}

# Bridge-installs the bundle skills into .claude/skills/ (#2197) so the SOP is
# usable before the plugin install lands. Claude Code watches skill
# directories, so links into an existing .claude/skills/ go live in the
# running session; a directory created just now is only watched from the next
# session — hence the one-time restart note.
#
# Reached whenever the CLI install did not happen — no `claude` on PATH, or it
# failed. The retirement moment is the `jus init` re-run those paths instruct,
# which is why the bridge is never laid on a path that DID install: it would
# sit beside the plugin's own copies with nothing to retire it, and that is the
# #1846 duplication again. ⚠️ Before #3565 this branch was gated on the
# settings write FAILING, so it ran only when jq was missing — the machines
# best equipped to install got no bridge, no chore and no instructions.
#
# Links are symlinks into the shared clone (never committed —
# absolute per-user targets): exact .gitignore lines are added here and
# removed by the handoff in jus_remove_claude_bridge.
jus_install_claude_bridge() {
  local project_root="$1"
  local clone_dir
  clone_dir="$(jus_bundle_clone_dir)"
  local dest="${project_root}/.claude/skills"

  if ! jus_ensure_bundle_clone "Claude Code"; then
    jus_ui_note "Bridge skipped — the skills arrive when the plugin install lands."
    return 0
  fi

  local created_dir=0
  [[ -d "$dest" ]] || created_dir=1
  mkdir -p "$dest"

  local skill_dir name target
  for skill_dir in "${clone_dir}"/skills/*/; do
    [[ -d "$skill_dir" ]] || continue
    name="$(basename "$skill_dir")"
    target="${dest}/${name}"
    if [[ -e "$target" && ! -L "$target" ]]; then
      jus_ui_note "Skipping ${name} — a local copy already exists in .claude/skills/."
      continue
    fi
    ln -sfn "${skill_dir%/}" "$target"
    jus_add_gitignore_entry "$project_root" ".claude/skills/${name}" || true
  done

  jus_ui_done $'Bridged the bundle skills into .claude/skills/\nuntil the plugin install lands.'
  jus_record_setup_action $'Linked the skills into .claude/skills/ until the plugin is installed\n— jus init removes them once it sees the plugin'" — undo by removing the links there that point into $(jus_tilde_path "$clone_dir")"
  if [[ "$created_dir" -eq 1 ]]; then
    jus_ui_warn ".claude/skills/ was just created — restart Claude Code once so it watches the"
    jus_ui_note "directory; from then on the skills stay live, updates included."
    jus_record_needs_you "Restart Claude Code once, so it watches the new .claude/skills/ directory."
  else
    jus_ui_note "Claude Code watches .claude/skills/, so they are live in the running session."
  fi
  jus_ui_note "'jus init' retires the bridge automatically once it verifies the plugin."
}

# The handoff (#2197): once the plugin is verified installed, the bridge links
# are pure duplication — remove exactly them. A bridge link is a symlink under
# .claude/skills/ whose target points into the shared clone; local copies and
# foreign symlinks are never touched, and each removed link takes its exact
# .gitignore line with it.
jus_remove_claude_bridge() {
  local project_root="$1" name removed=0
  while IFS= read -r name; do
    rm -f "${project_root}/.claude/skills/${name}"
    jus_remove_gitignore_entry "$project_root" ".claude/skills/${name}"
    removed=1
  done < <(jus_clone_skill_links "${project_root}/.claude/skills")
  if (( removed )); then
    jus_ui_done "Retired the .claude/skills/ bridge — the plugin serves the skills now."
  fi
  return 0
}

# The names of the symlinks directly under $1 that point into the shared clone,
# one per line — the links a jus install made. A local copy or a link pointing
# anywhere else is someone else's, and is never listed.
#
# ⚠️ THE SAME RESOLVER AS THE INSTALLER, AND THIS IS THE SITE THAT FAILS
# SILENTLY IF IT IS NOT (#4241). The prefix test below is what decides a link
# is ours; left on ${HOME} while the installer honours JUS_SKILLS_DIR, it
# matches nothing, retires nothing and prints nothing.
jus_clone_skill_links() {
  local dir="$1" clone_dir link
  clone_dir="$(jus_bundle_clone_dir)"
  for link in "$dir"/*; do
    [[ -L "$link" ]] || continue
    [[ "$(readlink "$link")" == "${clone_dir}/"* ]] || continue
    basename "$link"
  done
  return 0
}

# Removes the .qwen/skills/ links an earlier `jus init` made, once the extension
# serves the same skills. Measured on #4833: the extension plus those links
# declares every skill twice, once as `jus:<name>` and once plain.
#
# ⚠️ .agents/skills/ IS LEFT ALONE. Qwen reads it too, so links there double
# the skills as well (#5189), but another tool in the same repository may read
# them — jus_settle_shadowed_links warns instead, as it does for Codex.
jus_retire_qwen_skill_links() {
  local project_root="$1" name removed=0
  while IFS= read -r name; do
    rm -f "${project_root}/.qwen/skills/${name}"
    removed=1
  done < <(jus_clone_skill_links "${project_root}/.qwen/skills")
  [[ "$removed" -eq 1 ]] || return 0
  jus_ui_done "Removed the .qwen/skills/ links — the extension serves those skills now."
  jus_record_setup_action "Removed the old skill links from .qwen/skills/, which the extension replaces — undo by nothing: the extension serves the same skills, and both would list each twice"
}

# The clone links a plugin would load a second time. Qwen's own .qwen/skills
# are removed first; the cross-tool .agents/skills, which another tool in the
# repository may read, are named with the command that removes them and left
# alone — for Codex (#4836) and Qwen (#5189) alike.
jus_settle_shadowed_links() {
  local choice="$1" project_root="$2" tool="$3" root rm_line
  if [[ "$choice" == "qwen" ]]; then
    jus_retire_qwen_skill_links "$project_root"
  fi
  while IFS= read -r root; do
    rm_line="$(jus_clone_links_rm_line "$project_root" "$root")"
    [[ -n "$rm_line" ]] || continue
    jus_ui_warn "Warning: ${root}/ still links the bundle, so ${tool} loads every skill"
    jus_ui_note $'twice, plain and as jus:<name>. Unless another tool here reads them,\nremove them:'
    jus_ui_cmd "${rm_line}"
  done < <(jus_tool_plugin_shadowed_roots "$choice")
}

# A context file still carrying the SOP a legacy `jus init` appended, next to
# skills that now carry the same SOP. $3 names what serves the skills; $4 is the
# brand slug, so Claude Code's CLAUDE.md family is checked as well (#4866).
#
# ⚠️ FOR CLAUDE CODE, ONLY A BLOCK IT READS. An AGENTS.md beside a CLAUDE.md
# that does not import it is never read by Claude Code, so its block duplicates
# nothing: it is another tool's SOP, typically Codex's, and deleting it on this
# advice would break that tool (#4866 review).
#
# ⚠️ A COPY IN A FOLDER ABOVE IS NAMED TOO (#4970), and the advice names its
# owner: that file is outside the project, may be another team's, and other
# packages may still rely on its copy.
jus_warn_legacy_sop_block() {
  local project_root="$1" context_file="$2" server="$3" slug="${4:-}" carrier advice="delete that block."
  carrier="$(jus_legacy_sop_carrier "$slug" "$project_root" "$context_file")" || return 0
  if [[ "$slug" == "claude" ]] && [[ "$carrier" == "$context_file" ]] &&
    ! jus_claude_reads_agents_md "$project_root" "$context_file"; then
    # The family alone: a pre-#4866 copy there is read, and still warned about.
    carrier="$(jus_legacy_sop_carrier "$slug" "$project_root")" || return 0
  fi
  if [[ "$carrier" == /* ]]; then
    carrier="$(jus_tilde_path "$carrier"), in a folder above,"
    advice="delete it, or ask its owner to."
  fi
  jus_ui_warn "Warning: ${carrier} still carries a legacy appended SOP block"
  jus_ui_note "(\"# Juscribe Workflow SOP\"). With ${server} installed it duplicates"
  jus_ui_note "(and can shadow) the versioned skills — ${advice}"
}

# The "Install the bundle" answer for every tool but Claude Code.
#
# ⚠️ QWEN AND CODEX FIRST TRY THEIR OWN PLUGIN (#4833, #4836), and fall back
# to the links when the CLI is missing or the install fails.
#
# ⚠️ AND THE PLUGIN DECIDES WHERE THE HOOKS GO. One from a bundle carrying the
# tool's own manifest (#4834) registers the tool's own hooks, so merging them
# into its config as well would fire each one twice — and an earlier merge is
# retired. One from an older bundle registers Claude Code's file instead, which
# on these tools refuses nothing or not everything, so the merge stays. Asking the installed extension rather than the CLI's version
# keeps this right whichever of the CLI and the bundle is released first.
# The clone is needed either way: `jus hook` runs the scripts from it.
jus_install_tool_skills() {
  local choice="$1" project_root="$2" tool="$3" context_file="$4" kind
  kind="$(jus_tool_plugin_kind "$choice")"
  if jus_tool_plugin_install "$choice" "$project_root"; then
    jus_settle_shadowed_links "$choice" "$project_root" "$tool"
    jus_warn_legacy_sop_block "$project_root" "$context_file" "the ${kind}" "$choice"
    jus_ensure_bundle_clone "$tool" "the enforcement hooks are not in place" || return 0
    if jus_tool_plugin_hooks "$choice" >/dev/null; then
      jus_ui_done "The ${kind} registers the enforcement hooks itself, so nothing is merged"
      jus_ui_note "into ${tool}'s config."
      jus_hook_install_note "$choice"
      jus_retire_merged_hooks "$choice" "$project_root"
    else
      jus_offer_tool_hooks "$choice" "$project_root" "$tool"
    fi
    return 0
  fi
  jus_install_bundle "$project_root" "$tool" "$choice"
  jus_offer_tool_hooks "$choice" "$project_root" "$tool"
}

# Echo "true" when the server reports the provider_selection feature flag on,
# "false" otherwise — including every failure path. /api/v1/schema is
# unauthenticated (allow_unauthenticated_access), so this needs no token and
# works before one is configured.
#
# Parsed with grep rather than json_val: the flag appears exactly once in the
# payload, and json_val degrades to "(install jq for formatted output)" when
# neither jq nor python3 is present, which would read as a value rather than a
# failure. --max-time keeps a slow or unreachable server from stalling init for
# what is only a prompt.
jus_fetch_schema() {
  local response http_code
  response=$(curl -s --max-time 5 -w "\n%{http_code}" \
    -H "Accept: application/json" \
    "${BASE_URL}/api/v1/schema" 2>/dev/null) || { echo ""; return 0; }

  http_code=$(echo "$response" | tail -1)
  if [[ "$http_code" != "200" ]]; then
    echo ""
    return 0
  fi
  echo "$response" | sed '$d'
}

jus_fetch_provider_selection() {
  if grep -qo '"provider_selection"[[:space:]]*:[[:space:]]*true' <<<"$(jus_fetch_schema)"; then
    echo "true"
  else
    echo "false"
  fi
}

# Echo a provider's maturity — ga, beta or preview — reading the `providers`
# catalog out of a /schema body (#4225). $1 is the slug, $2 the body.
#
# ⚠️ THE BODY IS AN ARGUMENT, NOT SOMETHING THIS FETCHES OR CACHES. Every caller
# renders several rows, and each suffix is read inside `$(...)` — a subshell — so
# a cache written here would be discarded and every row would fetch again. The
# calling surface fetches once, in its own shell, and passes the body down.
#
# ⚠️ THE OBJECT MATCH IS `[^{}]*` ON BOTH SIDES DELIBERATELY. It confines the
# match to one catalog entry, so a slug that is a substring of another's JSON —
# `ai` inside `"claude"` — cannot pick up the wrong object's maturity.
jus_provider_maturity() {
  local slug="$1" body="${2-}" entry maturity
  entry=$(grep -o "{[^{}]*\"value\"[[:space:]]*:[[:space:]]*\"${slug}\"[^{}]*}" <<<"$body" | head -1 || true)
  maturity=$(sed -n 's/.*"maturity"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' <<<"$entry")

  if [[ -n "$maturity" ]]; then
    echo "$maturity"
  elif [[ "$slug" == "claude" ]]; then
    # ⚠️ NOT SYMMETRIC WITH THE LINE BELOW, AND MUST NOT BE. No catalog means an
    # old server or no network, and the answer then has to be Claude settled and
    # everything else at the floor. A blanket floor default would mark Claude
    # Code itself.
    echo "ga"
  else
    # ⚠️ THE FLOOR IS `beta` SINCE #4238 AND WAS `preview` BEFORE IT. The tiers
    # were inverted — preview now sits just below GA — so this changed value to
    # keep its meaning. Offline, an unknown brand must not read as nearly
    # shipped.
    echo "beta"
  fi
}

# Echo the display suffix for a provider: "(Preview)", "(Beta)" or nothing.
#
# ⚠️ THE CATCH-ALL IS THE FLOOR, WHICH IS `(Beta)` SINCE #4238. It answers for a
# maturity string this build does not recognise — a newer server naming a tier
# added after this tarball was cut — and the cautious answer for that is the
# least mature label, not the one below GA. It read `(Preview)` when preview WAS
# the floor; the tiers inverted, so the branch moved with them.
# Whether a provider's maturity should be RENDERED (#4757). Separate from what
# the maturity is: the catalog keeps every brand's tier and this says whether to
# show it.
#
# ⚠️ ABSENT MEANS SHOW. A server older than #4757 sends no `badge` key, and
# reading its absence as "hide" would silently drop every badge against one.
# Only an explicit `false` hides.
jus_provider_badge() {
  local slug="$1" body="${2-}" entry
  entry=$(grep -o "{[^{}]*\"value\"[[:space:]]*:[[:space:]]*\"${slug}\"[^{}]*}" <<<"$body" | head -1 || true)
  if grep -q '"badge"[[:space:]]*:[[:space:]]*false' <<<"$entry"; then
    echo "false"
  else
    echo "true"
  fi
}

jus_provider_suffix() {
  # ⚠️ An explicit `if`, not `[[ … ]] && cmd` — this file runs under
  # `set -euo pipefail`, where that form aborts the caller when it does not match.
  if [[ "$(jus_provider_badge "$1" "${2-}")" == "false" ]]; then
    echo ""
    return 0
  fi
  case "$(jus_provider_maturity "$1" "${2-}")" in
    ga) echo "" ;;
    preview) echo "(Preview)" ;;
    *) echo "(Beta)" ;;
  esac
}

# The two-row CLI picker that `jus switch` prints with no argument. `jus init`
# step 5 printed it too until #4802 removed that prompt. Shared since #4225: both carried the same
# literal `(Preview)` on the Codex row, so a maturity change had to be made in
# two places and could be made in one.
#
# $1 is a /schema body; absent, both rows fall back to the built-in answer.
jus_print_cli_provider_rows() {
  local schema="${1-}" claude_mark codex_mark
  claude_mark="$(jus_provider_suffix claude "$schema")"
  codex_mark="$(jus_provider_suffix codex "$schema")"
  echo "  1) Claude Code  (claude)${claude_mark:+     $claude_mark}"
  echo "  2) Codex CLI    (codex)${codex_mark:+     $codex_mark}"
}

# Whether `jus init` offers the CLI-provider choice. The server's
# provider_selection flag is the source of truth — the same one gating the
# picker in Settings and Onboarding — so flipping it now reaches the CLI instead
# of stopping at the web app (#1996). JUS_MULTI_LLM stays as a local override
# for development and short-circuits before any request is made.
jus_provider_selection_enabled() {
  [[ -n "${JUS_MULTI_LLM:-}" ]] && return 0
  [[ "$(jus_fetch_provider_selection)" == "true" ]]
}

# What `jus init` did on the person's behalf without asking (#4824), listed
# under "Setup Complete" so an action taken for them is still on the record.
# Since #4838 the summary is the full record, in three lists: what was done
# (each with its revert), what was skipped and why, and what needs the person.
JUS_SETUP_ACTIONS=()
JUS_SETUP_SKIPPED=()
JUS_SETUP_NEEDS_YOU=()

jus_record_setup_action() {
  JUS_SETUP_ACTIONS+=("$1")
}

jus_record_skipped() {
  JUS_SETUP_SKIPPED+=("$1")
}

jus_record_needs_you() {
  JUS_SETUP_NEEDS_YOU+=("$1")
}

# A JSON field as text, with null and a missing key as the empty string —
# json_val prints the word "null" for both, and `//` would swallow a false.
#
# ⚠️ NOT THROUGH json_val WITHOUT jq (#4838 review). Its python fallback echoes
# the whole input when a step of the path is null, and prints `None` and `True`,
# so a person's unscoped token saved its entire /profile body as the workspace
# id. Without python either, the answer is empty: the unscoped path, which
# lists and asks.
jus_json_field() { # <json> <jq path>
  if command -v jq &>/dev/null; then
    jq -r "$2 | if . == null then \"\" else . end" <<<"$1" 2>/dev/null || true
  elif command -v python3 &>/dev/null; then
    python3 -c '
import json, sys
try:
    value = json.loads(sys.argv[1])
    for key in sys.argv[2].lstrip(".").split("."):
        value = value.get(key) if isinstance(value, dict) else None
except ValueError:
    value = None
if isinstance(value, bool):
    print("true" if value else "false")
elif value is not None:
    print(value)
' "$1" "$2" 2>/dev/null || true
  fi
}

# "deepseek" → "Deepseek", for a slug this CLI cannot set up. bash 3.2 has no
# ${var^}.
jus_capitalize() {
  printf '%s%s' "$(tr '[:lower:]' '[:upper:]' <<<"${1:0:1}")" "${1:1}"
}

# What the token carries, right after "Authenticated as" on both token paths
# (#4838, stakeholder): its workspace and its AI tool, read from the /profile
# body Step 2 already fetched, so it costs no extra call. On the existing-token
# path this comes before "Use this token?", so the decision is made knowing
# what the token is for.
#
# ⚠️ `ai_provider_chosen` IS READ AS ABSENT, TRUE OR FALSE. Production did not
# send it for a bot token on 22 Sep (#4813 adds it); an absent key means "not
# known", never "picked".
jus_describe_token() { # <profile_json>
  local profile="$1" ws_name org_name provider chosen tool line said=0
  ws_name="$(jus_json_field "$profile" '.token_scope.workspace_name')"
  org_name="$(jus_json_field "$profile" '.token_scope.organization_name')"
  if [[ -n "$ws_name" ]]; then
    line="Workspace on this token: ${ws_name}"
    if [[ -n "$org_name" ]]; then
      line+=" (${org_name})"
    fi
    jus_ui_note "$line"
    said=1
  fi
  provider="$(jus_json_field "$profile" '.user.ai_provider')"
  if [[ -n "$provider" ]]; then
    tool="$(jus_ai_tool_name "$provider")"
    if [[ "$tool" == "Other / skip" ]]; then
      tool="$(jus_capitalize "$provider") (jus init cannot set this one up)"
    fi
    chosen="$(jus_json_field "$profile" '.user.ai_provider_chosen')"
    case "$chosen" in
      true) tool+=" (picked when the token was made)" ;;
      false) tool+=" (the default)" ;;
      *) : ;;
    esac
    jus_ui_note "AI tool on this token: ${tool}"
    said=1
  fi
  if (( said == 0 )); then
    jus_ui_note "This token is not tied to a workspace or an AI tool."
  fi
}

# The "Setup Complete" quick start.
#
# ⚠️ THE DISPATCH LINES ARE GONE (#3987), AND SO IS THE BRANCH THAT PRINTED
# THEM. This block used to end by offering `dispatch start` whenever the binary
# was on PATH, which made every `jus init` on a machine that had it an
# advertisement for a feature that is now switched off across every surface. The
# subcommands still work for whoever has the binary; nothing points at them.
#
# The #3827 rejection that shaped the old wording still holds and is worth
# keeping: it offered `dispatch init` as a setup step when `jus init` had
# already written everything it configures, which sent people through the whole
# wizard a second time. Both lines left together.
#
# $1 = the project's .jus/config directory: the tickets example needs its
# workspace_id.
jus_print_quick_start() {
  echo ""
  jus_ui_banner "Setup Complete"
  echo ""
  local item
  if (( ${#JUS_SETUP_ACTIONS[@]} > 0 )); then
    echo "Done during setup:"
    for item in "${JUS_SETUP_ACTIONS[@]}"; do
      jus_print_setup_action "$item"
    done
    echo ""
  fi
  if (( ${#JUS_SETUP_SKIPPED[@]} > 0 )); then
    echo "Skipped:"
    for item in "${JUS_SETUP_SKIPPED[@]}"; do
      jus_ui_skipped "$item"
    done
    echo ""
  fi
  if (( ${#JUS_SETUP_NEEDS_YOU[@]} > 0 )); then
    echo "Needs you:"
    for item in "${JUS_SETUP_NEEDS_YOU[@]}"; do
      jus_ui_warn "$item"
    done
    echo ""
  fi
  # ⚠️ NO WORKSPACE PREFIX AND NO QUOTES ON THE FIRST COMMAND (#4838): #4729 adds
  # the saved workspace to a bare path, and nothing in it needs quoting. An
  # example carrying a query string keeps its quotes — zsh reads a bare `?` as
  # a pattern and `&` sends the command to the background.
  echo "Quick start:"
  jus_ui_note "Verify authentication:"
  jus_ui_cmd "$PROG_NAME whoami"
  # Only with a workspace saved: #4729 resolves a bare path against it, and
  # without one the command fails (#4838 review).
  if [[ -s "${1:-}/workspace_id" ]]; then
    jus_ui_note "List this workspace's tickets:"
    jus_ui_cmd "$PROG_NAME api GET tickets"
  fi
  # #5256. On success only — every failure exits before this block — and
  # never read: it is the last line, not a question.
  echo ""
  printf '%s\n' "$JUS_STAR_ASK"
}

# Scaffold the project docs directory (#2288): the SOP tells agents to write
# discoveries into .jus/docs/, but nothing ever created it — other workspaces
# were pointed at a directory that did not exist. Seeds an INDEX.md explaining
# the convention; never touches an existing one.
# Argument: $1 = project root.
jus_scaffold_docs_dir() {
  local project_root="$1"
  local index_file="${project_root}/.jus/docs/INDEX.md"
  [[ -f "$index_file" ]] && return 0
  mkdir -p "${project_root}/.jus/docs"
  cat > "$index_file" <<'DOCS_INDEX'
# Documentation Index

> Topical deep-dive docs for this project, loaded by agents on demand. Keep
> one line per doc so an agent can decide what to read from this file alone:
>
>     - [name.md](name.md) — When to read: <the task situations that call for it>

No docs yet. When you hit a gotcha, decode a subsystem, or find a fix that
will recur, write it up as a doc in this directory and add its line above —
see the SOP's "Document Discoveries" section. Before debugging a subsystem,
check this index first: a documented gotcha you re-derive from scratch is
time somebody already spent for you.
DOCS_INDEX
}

