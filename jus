#!/usr/bin/env bash
#
# .jus/bin/jus — Juscribe CLI
# Canonical location: .jus/bin/jus (symlinked from bin/jus)
#
# Usage:
#   bin/jus api METHOD /path [body]       REST API wrapper (replaces bin/api)
#   bin/jus api METHOD /path @file.json   Body from file
#   bin/jus api METHOD /path <<'EOF'      Body from heredoc/stdin
#   bin/jus download <url-path> <output>  Download ActiveStorage attachments
#   bin/jus login [--no-browser|--token]  Sign in through the browser, or paste a token
#   bin/jus whoami                        Show currently authenticated user
#   bin/jus init                          Interactive first-time setup
#   bin/jus doctor                        Check this project's setup, non-interactively
#   bin/jus refresh-hooks                 Bring an installed hook manifest up to the bundle
#   bin/jus remove-hooks                  Take the Juscribe hooks back out of your tool's config
#   bin/jus cleanup                       Remove all files from .jus/tmp/
#   bin/jus help                          This list, ending on the source repository
#   bin/jus dispatch init [flags]         Interactive jus-dispatch setup
#   bin/jus dispatch start [flags]        Start jus-dispatch with auto-configured token/server
#
# API options:
#   --raw         Print raw response (skip jq formatting)
#   -v            Verbose mode (show request details)

set -euo pipefail

# Embedded version — stamped by script/dev/release-dispatch during builds.
# In development, falls back to .jus/VERSION file.
JUS_EMBEDDED_VERSION="0.8.32"

# Program name for usage strings — adapts to however the script was invoked
PROG_NAME="$(basename "$0")"

# ---------------------------------------------------------------------------
# Shared: resolve paths, base URL, token
# ---------------------------------------------------------------------------

# Resolve symlinks to find .jus/ directory
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
JUS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PROJECT_ROOT="$(cd "$JUS_DIR/.." && pwd)"

# Walk up from $PWD for the nearest project, the way git, npm and cargo resolve
# project config. Echoes the .jus directory; exits non-zero when there is none.
#
# ⚠️ This used to test `$PWD` alone (#2593), so `jus` found its token ONLY when
# the terminal sat exactly at a project root. One `cd` into a subdirectory — or
# any git worktree, whose `.jus/config/` is gitignored and therefore absent by
# design (#1924) — and JUS_DIR stayed at the Homebrew Cellar prefix, whose
# config/api_token.txt has never existed. The failure surfaced as
# `No token available. Run 'jus login'`, which reads like an expired credential
# and is not one.
#
# ⚠️ NEAREST WINS, not outermost. A project checked out inside another must use
# its own token; walking to the outermost would silently authenticate as the
# wrong account, which is the failure mode this whole resolution exists to
# prevent.
#
# ⚠️ IT TAKES NO ARGUMENT, deliberately (#2819). It used to accept a starting
# directory defaulting to $PWD, and nothing ever passed one — so shellcheck
# flagged it SC2120 and this file failed `script/dev/lint-shell` from #2593 until
# 2026-08-24, unnoticed because nothing lints an unstaged script. A parameter
# no caller uses is not free either: one passed later would have been accepted
# and silently ignored. Give it one again when a caller actually needs it.
jus_find_project_jus_dir() {
  local dir="$PWD"
  while :; do
    if [[ -d "$dir/.jus/config" ]]; then
      printf '%s\n' "$dir/.jus"
      return 0
    fi
    # Checked AFTER the test so a project at / is still found, and before the
    # dirname so the loop cannot spin: `dirname /` is `/`.
    [[ "$dir" == "/" ]] && return 1
    dir="$(dirname "$dir")"
  done
}

# When installed via Homebrew, JUS_DIR points to the brew prefix. Prefer the
# project the caller is standing in — or under.
#
# JUS_PROJECT_FOUND records whether the walk found one, so resolve_token can
# tell "no project here" from "a project with no token": the first is fixed by
# running from the project, the second by logging in.
JUS_PROJECT_FOUND=0
if _found_jus_dir="$(jus_find_project_jus_dir)"; then
  JUS_PROJECT_FOUND=1
  if [[ "$JUS_DIR" != "$_found_jus_dir" ]]; then
    JUS_DIR="$_found_jus_dir"
    # From the FOUND directory, not from $PWD. Those coincided only because the
    # old test required $PWD to be the root; with a walk they diverge, and
    # PROJECT_ROOT is what `jus dispatch start --project` is handed.
    PROJECT_ROOT="$(cd "$JUS_DIR/.." && pwd)"
  fi
fi
unset _found_jus_dir

CONFIG_DIR="${JUS_DIR}/config"
TOKEN_FILE="${CONFIG_DIR}/api_token.txt"
WORKSPACE_FILE="${CONFIG_DIR}/workspace_id"

# Backward compat: migrate config files from .jus/tmp/ → .jus/config/
migrate_config_file() {
  local name="$1"
  local new_path="${CONFIG_DIR}/${name}"
  local old_path="${JUS_DIR}/tmp/${name}"
  if [[ ! -f "$new_path" ]] && [[ -f "$old_path" ]]; then
    mkdir -p "$CONFIG_DIR"
    mv "$old_path" "$new_path"
  fi
}
migrate_config_file "api_token.txt"
migrate_config_file "workspace_id"
migrate_config_file "base_url"

# Base URL resolution: env var → local config file → production default
# Override locally with JUSCRIBE_BASE_URL env var or .jus/config/base_url file
BASE_URL_FILE="${CONFIG_DIR}/base_url"
if [[ -n "${JUSCRIBE_BASE_URL:-}" ]]; then
  BASE_URL="$JUSCRIBE_BASE_URL"
elif [[ -f "$BASE_URL_FILE" ]]; then
  BASE_URL=$(cat "$BASE_URL_FILE")
else
  BASE_URL="https://app.juscribe.ai"
fi

# How long to wait for the first byte of a stdin request body before concluding
# there is none (#4413). Overridable so a test can set it low, and WHOLE SECONDS
# by default because macOS ships bash 3.2, where `read -t` rejects a fraction.
JUS_STDIN_TIMEOUT="${JUS_STDIN_TIMEOUT:-10}"

# The CLI's public source (#5256), which `jus help` and `jus --version` name,
# and the one line a successful `jus init` ends on: an ask, never a prompt.
# Every star on that repository moves jus toward Homebrew's main tap (#5073).
# One assignment each; spec/project/jus_source_line_spec.rb reads them here.
JUS_SOURCE_URL="https://github.com/juscribe/jus"
JUS_STAR_ASK="Star jus on GitHub: ${JUS_SOURCE_URL} - every star helps."

resolve_token() {
  if [[ -n "${JUSCRIBE_API_TOKEN:-}" ]]; then
    echo "$JUSCRIBE_API_TOKEN"
  elif [[ -f "$TOKEN_FILE" ]]; then
    cat "$TOKEN_FILE"
  elif [[ "$JUS_PROJECT_FOUND" != 1 ]]; then
    # ⚠️ NOT a login problem, and saying "No token available. Run login" sent
    # agents to re-authenticate over it. A worktree outside the checkout holds
    # no .jus/config (it is gitignored), and neither does a temp directory.
    jus_ui_fail "Error: No Juscribe project found in $PWD or any directory above it (no .jus/config)." >&2
    jus_ui_note "Run $PROG_NAME from inside your project, or export JUSCRIBE_API_TOKEN." >&2
    return 1
  else
    jus_ui_fail "Error: No token available. Run '$PROG_NAME login' or set JUSCRIBE_API_TOKEN." >&2
    return 1
  fi
}

# The version this CLI reports — to `jus version`, and as the X-Jus-Version header
# on every `jus api` call.
#
# Embedded first, file second, because the two ship from different builds and only
# the embedded value describes the script that is actually running:
#   * script/dev/release-dispatch stamps JUS_EMBEDDED_VERSION and ships NO VERSION file.
#     That is the Homebrew install.
#   * bin/publish-cli ships an UNSTAMPED script alongside .jus/VERSION. That is the
#     curl-installer tarball, and a development checkout.
# They collide only when a Homebrew CLI is called from inside a tarball-installed
# project, where JUS_DIR resolves to that project's .jus/ — and there the file is
# the PROJECT's payload version, not the CLI's.
#
# Echoes nothing when neither is present, which callers treat as "no version to
# report" rather than an error (#3193).
resolve_client_version() {
  if [[ -n "${JUS_EMBEDDED_VERSION:-}" ]]; then
    printf '%s\n' "$JUS_EMBEDDED_VERSION"
  elif [[ -f "${JUS_DIR}/VERSION" ]]; then
    cat "${JUS_DIR}/VERSION"
  fi
}

# Each vendor's own signal that it is running this CLI, for when neither
# JUS_AGENT nor AI_AGENT names the agent (#4908). Ported from std-env 4.2.0's
# `detectAgent` (dist/index.mjs), in its order, with three entries it lacks taken
# from gh's internal/agents/detect.go (trunk 561d9f919c, 2026-06-25):
#   amp          `AGENT=amp`, and FIRST, because Amp also sets CLAUDECODE
#   copilot      COPILOT_CLI
#   antigravity  ANTIGRAVITY_AGENT
#
# One line per agent: its name, then the variables that signal it, any one of
# which is enough. `VAR` means set and non-empty, `VAR=value` exactly that value,
# and `VAR~text` a value containing that text.
JUS_AGENT_SIGNALS=(
  "amp AGENT=amp"
  "copilot COPILOT_CLI"
  "antigravity ANTIGRAVITY_AGENT"
  "claude CLAUDECODE CLAUDE_CODE"
  "replit REPL_ID"
  "gemini GEMINI_CLI"
  "codex CODEX_SANDBOX CODEX_THREAD_ID"
  "opencode OPENCODE"
  "pi PATH~/.pi/agent PATH~\\.pi\\agent"
  "auggie AUGMENT_AGENT"
  "goose GOOSE_PROVIDER"
  "junie JUNIE_DATA JUNIE_SHIM_PATH"
  "devin EDITOR~devin"
  "cursor CURSOR_AGENT"
  "kiro TERM_PROGRAM~kiro"
)

# The agents in JUS_AGENT_SIGNALS whose signal only their OWN commands carry
# (#5661). One of these present beside Claude Code's signals means it was started
# inside Claude Code's shell, so it is the agent running this CLI.
#
# ⚠️ LEFT OUT DELIBERATELY: replit, pi, goose, junie, devin and kiro. Theirs mark
# a whole terminal or profile (REPL_ID, PATH, GOOSE_PROVIDER, EDITOR,
# TERM_PROGRAM), which is exactly where people run Claude Code.
#
# ⚠️ THE ONE THIS GETS WRONG, AND WHY IT IS ACCEPTED: Claude Code started inside
# one of these reports as that agent. The two orders leave the same variables
# set, and the process tree cannot settle it because Codex's sandbox refuses
# `ps`, `pgrep` and `sysctl` alike (measured on codex-cli 0.160.1). Starting
# another agent from Claude Code's shell works out of the box; Claude Code inside
# Codex's sandboxed shell has, by default, no network.
JUS_AGENT_OWN_COMMANDS=" codex cursor gemini copilot antigravity opencode auggie "

# True when one JUS_AGENT_SIGNALS token holds in this environment.
jus_agent_signalled() { # <token>
  local token="$1" var value
  case "$token" in
    *=*)
      var="${token%%=*}"
      [[ "${!var:-}" == "${token#*=}" ]]
      ;;
    *~*)
      var="${token%%~*}"
      value="${!var:-}"
      [[ -n "$value" && "$value" == *"${token#*~}"* ]]
      ;;
    *) [[ -n "${!token:-}" ]] ;;
  esac
}

# The first agent in JUS_AGENT_SIGNALS whose signal holds. Fails when none does.
jus_detect_agent_by_signal() {
  local entry token
  local -a parts
  for entry in "${JUS_AGENT_SIGNALS[@]}"; do
    read -r -a parts <<<"$entry"
    for token in "${parts[@]:1}"; do
      jus_agent_signalled "$token" || continue
      # std-env's `noTTY`: Kiro's terminal is also where a person types, so it
      # counts only when nobody is at one. Stdout is this function's pipe, so
      # stderr is the stream that can still tell.
      [[ "${parts[0]}" == kiro && -t 2 ]] && continue
      printf '%s\n' "${parts[0]}"
      return 0
    done
  done
  return 1
}

# A version an agent reported, if it reads as one: it starts with a digit and
# stays inside what a header value can carry safely.
jus_agent_version_ok() { # <version>
  [[ "$1" =~ ^[0-9][0-9A-Za-z.+-]{0,39}$ ]]
}

# Reads one agent value leniently, as `name` or `name/version`: `name@1.2.3`,
# `name/1.2.3`, a bare `name`, or gh's `name_1-2-3_agent`. That last is the form
# Claude Code writes into AI_AGENT, because gh accepts only [A-Za-z0-9_-], so its
# dashes are read back as dots. A version that does not read as one is dropped
# and the name kept. Fails when there is no usable name, so the caller moves on
# to its next source.
jus_parse_agent() { # <value>
  local value="$1" name version=""
  [[ -n "$value" ]] || return 1
  case "$value" in
    *@*) name="${value%%@*}" version="${value#*@}" ;;
    */*) name="${value%%/*}" version="${value#*/}" ;;
    *_*)
      name="${value%%_*}"
      version="${value#*_}"
      version="${version%%_*}"
      [[ "$version" =~ ^[0-9]+(-[0-9]+)+$ ]] && version="${version//-/.}"
      ;;
    *) name="$value" ;;
  esac
  name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
  [[ "$name" =~ ^[a-z0-9][a-z0-9._-]{0,39}$ ]] || return 1
  if [[ -n "$version" ]] && jus_agent_version_ok "$version"; then
    printf '%s/%s\n' "$name" "$version"
  else
    printf '%s\n' "$name"
  fi
}

# The first agent in JUS_AGENT_OWN_COMMANDS whose signal holds, other than the
# one named (#5661). Fails when there is none.
jus_nested_agent() { # <outer agent name>
  local outer="$1" entry token
  local -a parts
  for entry in "${JUS_AGENT_SIGNALS[@]}"; do
    read -r -a parts <<<"$entry"
    [[ "$JUS_AGENT_OWN_COMMANDS" == *" ${parts[0]} "* && "$outer" != "${parts[0]}"* ]] || continue
    for token in "${parts[@]:1}"; do
      jus_agent_signalled "$token" || continue
      printf '%s\n' "${parts[0]}"
      return 0
    done
  done
  return 1
}

# A detected name with the version its agent exports separately. Codex alone
# does, as CODEX_VERSION.
jus_agent_with_version() { # <name>
  if [[ "$1" == codex ]] && jus_agent_version_ok "${CODEX_VERSION:-}"; then
    printf 'codex/%s\n' "$CODEX_VERSION"
  else
    printf '%s\n' "$1"
  fi
}

# The AI agent running this CLI, for the X-Jus-Agent header on every `jus api`
# call (#4908): `name`, or `name/version` when the agent says which. Echoes
# nothing when none is found, and the request then goes out without the header.
#
# JUS_AGENT comes first because it is the user's own word, and the only way to
# name an agent that sets nothing at all (Kimi). AI_AGENT is next: the
# cross-vendor convention Claude Code and pi write. Then each vendor's own
# variable.
#
# ⚠️ AN AGENT STARTED INSIDE ANOTHER INHERITS ITS AI_AGENT (#5661). Codex does not
# write one, so Codex run from Claude Code's shell still carried Claude Code's,
# and was reported as it. So a signal from JUS_AGENT_OWN_COMMANDS outranks
# AI_AGENT, and outranks Claude Code's own variables in the table.
#
# ⚠️ DISPLAY ONLY. Any token holder can send any value, so the server lets it
# decide nothing: not access, not rate limits, not billing.
resolve_reported_agent() {
  local reported name inner
  if reported=$(jus_parse_agent "${JUS_AGENT:-}"); then
    printf '%s\n' "$reported"
    return 0
  fi
  if reported=$(jus_parse_agent "${AI_AGENT:-}"); then
    if inner=$(jus_nested_agent "${reported%%/*}"); then
      jus_agent_with_version "$inner"
    else
      printf '%s\n' "$reported"
    fi
    return 0
  fi
  name=$(jus_detect_agent_by_signal) || return 0
  if [[ "$name" == claude ]] && inner=$(jus_nested_agent claude); then
    name="$inner"
  fi
  jus_agent_with_version "$name"
}

# The first value that matches an extended regex. Fails when none does.
jus_first_matching() { # <regex> <value...>
  local pattern="$1" value
  shift
  for value in "$@"; do
    if [[ "$value" =~ $pattern ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done
  return 1
}

# Where a Claude Code session's name is kept between calls (#4909), one file per
# session id. A per-user temp directory: the name is a convenience, and losing
# it costs one lookup.
jus_session_cache_dir() {
  printf '%s\n' "${JUS_SESSION_CACHE_DIR:-${TMPDIR:-/tmp}/jus-session-names-$(id -u)}"
}

# A Claude Code session's name, as `claude agents --json` lists it: the default
# `my-project-2e` until someone renames it. Asking costs about 130 ms, so the
# answer is cached per session and asked again only after
# JUS_SESSION_NAME_TTL_MIN minutes, which is how a rename reaches the board. A
# session it does not list is cached as having no name. Fails when there is no
# name, or no `claude` or `jq` to ask.
#
# ⚠️ NEVER the status line's `session_name`. With no custom name it falls back
# to an AI-written title of the conversation, which would put what was said in
# a private session on a shared board.
jus_claude_session_name() { # <session id>
  local id="$1" dir cache name="" printable='^[ -~]{1,60}$'
  command -v claude >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 1
  dir=$(jus_session_cache_dir)
  cache="$dir/$id"
  if [[ -f "$cache" && -n "$(find "$cache" -mmin "-${JUS_SESSION_NAME_TTL_MIN:-10}" 2>/dev/null)" ]]; then
    name=$(cat "$cache")
  else
    name=$(claude agents --json 2>/dev/null |
      jq -r --arg id "$id" 'first(.[] | select(.sessionId == $id) | .name) // empty' 2>/dev/null) || name=""
    [[ "$name" =~ $printable ]] || name=""
    mkdir -p "$dir" 2>/dev/null && printf '%s' "$name" >"$cache" 2>/dev/null
  fi
  [[ -n "$name" ]] || return 1
  printf '%s\n' "$name"
}

# Where the jus hooks keep each session's model (#4910), one file per session
# id. ⚠️ Under $HOME, never $TMPDIR: hooks run outside Claude Code's Bash
# sandbox, which gives the commands inside it their own $TMPDIR. This must
# match `juscribe_sop_model_dir` in jus/hooks/scripts/lib/state.sh, which ships
# on the skills bundle rather than with this file; test-jus-api runs that hook
# and this reader against one $HOME to hold them together.
jus_session_model_dir() {
  if [[ -n "${JUS_SESSION_MODEL_DIR:-}" ]]; then
    printf '%s\n' "$JUS_SESSION_MODEL_DIR"
  elif [[ -n "${XDG_CACHE_HOME:-}" ]]; then
    printf '%s\n' "$XDG_CACHE_HOME/jus/session-models"
  elif [[ -n "${HOME:-}" ]]; then
    printf '%s\n' "$HOME/.cache/jus/session-models"
  else
    return 1
  fi
}

# The model a jus hook saved for this session, as the agent's own hook payload
# named it (#4910). No agent puts the model in the environment of the commands
# it runs, so this file is the only way the CLI can know it. Fails when there
# is no file, or when what it holds is not a shape the server keeps.
jus_session_model() { # <session id>
  local dir model printable='^[ -~]{1,80}$'
  dir=$(jus_session_model_dir) || return 1
  [[ -f "$dir/$1" ]] || return 1
  model=$(head -c 200 "$dir/$1" 2>/dev/null) || return 1
  [[ "$model" =~ $printable ]] || return 1
  printf '%s\n' "$model"
}

# True when this Claude Code session runs inside another one (#5661): an
# ancestor of CLAUDE_PID is a session `claude agents --json` lists. A nested
# session sets its own CLAUDE_PID and session id but inherits the outer one's
# Remote Control link always, and its effort when it has none of its own
# (measured on 2.1.291), so neither can be trusted to be this session's.
#
# The answer never changes for a session, so it is kept in the session cache
# once found. Fails when it cannot tell: no CLAUDE_PID, no `claude` or `jq`, or a
# `ps` that will not answer, which a sandbox can refuse. Failing keeps today's
# behaviour rather than guessing.
jus_claude_session_nested() { # <session id>
  local id="$1" cache sessions pid verdict=0
  [[ "${CLAUDE_PID:-}" =~ ^[0-9]+$ ]] || return 1
  command -v claude >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 1
  cache="$(jus_session_cache_dir)/$id.nested"
  if [[ -f "$cache" ]]; then
    [[ "$(cat "$cache" 2>/dev/null)" == 1 ]]
    return
  fi
  sessions=$(claude agents --json 2>/dev/null |
    jq -r --argjson self "$CLAUDE_PID" '.[] | select(.pid != $self) | .pid // empty' 2>/dev/null) || return 1
  pid="$CLAUDE_PID"
  for _ in {1..32}; do
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    (( pid > 1 )) || break
    if grep -qx "$pid" <<<"$sessions"; then
      verdict=1
      break
    fi
  done
  mkdir -p "${cache%/*}" 2>/dev/null && printf '%s' "$verdict" >"$cache" 2>/dev/null
  (( verdict == 1 ))
}

# The headers that say which session of the agent made a call (#4909), one
# `Name: value` per line: its id, its effort, its model (#4910), its Remote
# Control link and its name. Each is dropped on its own when its value does not
# read as one. The caller sends them only beside X-Jus-Agent, because a session
# belongs to an agent and the server ignores one that arrives alone.
#
# ⚠️ EACH VALUE COMES ONLY FROM THE AGENT BEING REPORTED (#5661). An agent
# started inside Claude Code's shell inherits Claude Code's session id, effort
# and link, so taking the first variable present sent another agent's session
# under Codex's name. Cursor's conversation id is its session (#4910): it is
# what Cursor's hooks name the conversation, so it is the key the saved model
# is filed under.
#
# The link is the id only; the server builds the claude.ai URL from it, so
# nothing here can point the board somewhere else.
jus_session_headers() { # <reported agent, as resolve_reported_agent prints it>
  local agent="${1%%/*}" source="" id="" effort="" model="" link="" name="" nested=""
  case "$agent" in
    claude*) source="${CLAUDE_CODE_SESSION_ID:-}" ;;
    codex*) source="${CODEX_SESSION_ID:-}" ;;
    *copilot*) source="${COPILOT_AGENT_SESSION_ID:-}" ;;
    cursor*) source="${CURSOR_CONVERSATION_ID:-}" ;;
  esac
  if id=$(jus_first_matching '^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$' "$source"); then
    printf 'X-Jus-Session: %s\n' "$id"
  fi
  [[ "$agent" == claude* && -n "$id" ]] && jus_claude_session_nested "$id" && nested=1
  if [[ "$agent" == claude* && -z "$nested" ]] &&
    effort=$(jus_first_matching '^[a-z]{1,20}$' "${CLAUDE_EFFORT:-}"); then
    printf 'X-Jus-Effort: %s\n' "$effort"
  fi
  if [[ -n "$id" ]] && model=$(jus_session_model "$id"); then
    printf 'X-Jus-Model: %s\n' "$model"
  fi
  if [[ "$agent" == claude* && -z "$nested" ]] && link=$(jus_first_matching '^[A-Za-z0-9_-]{1,100}$' \
    "${CLAUDE_CODE_BRIDGE_SESSION_ID:-}" "${CLAUDE_CODE_REMOTE_SESSION_ID:-}"); then
    printf 'X-Jus-Session-Link: %s\n' "$link"
  fi
  # Only Claude Code can name a session, so only its id is looked up.
  if [[ "$agent" == claude* && -n "$id" ]] && name=$(jus_claude_session_name "$id"); then
    printf 'X-Jus-Session-Name: %s\n' "$name"
  fi
}

# True when a curl call never got a reply at all — a refused connection, a DNS
# failure, a timeout, a sandbox denying the socket. Both halves are needed:
#
#   * curl exits 0 on an HTTP error, so the status code alone cannot tell a 401
#     from a dead socket — but curl writes `000` there, which is not a status.
#   * a curl that dies before writing the -w output leaves no status line to
#     read, so its exit code is what catches that one.
#
# The distinction exists because everything downstream of it used to be a claim
# about the credential (#4520).
transport_failed() {
  local curl_status="$1" http_code="$2"

  if (( curl_status != 0 )); then
    return 0
  fi
  if [[ ! "$http_code" =~ ^[0-9]{3}$ ]] || [[ "$http_code" == "000" ]]; then
    return 0
  fi
  return 1
}

# ── Codex's sandbox and the network (#4982) ───────────────────────────────────
#
# Codex runs every command in a sandbox that denies outbound connections unless
# workspace-write's network_access is on, and exports this variable to each
# command it runs that way. Measured on codex-cli 0.154.0 with `codex sandbox`:
# `1` under the default policy, absent once the key is set, and curl reached the
# board only then. So when it is set, the cause of a dead socket is known.
jus_codex_network_off() {
  [[ "${CODEX_SANDBOX_NETWORK_DISABLED:-}" == "1" ]]
}

jus_codex_config_file() {
  printf '%s\n' "${CODEX_HOME:-${HOME}/.codex}/config.toml"
}

# The head of every awk program that reads a Codex config. The user's file is
# owner-only and holds credentials, so each check matches one named key and
# prints nothing else. This skips comments and keeps `table` set to the [table]
# the line sits in, "" above the first header, whitespace removed.
JUS_CODEX_TOML_TABLES='
  /^[[:space:]]*#/ { next }
  /^[[:space:]]*\[/ {
    table = $0
    sub(/^[[:space:]]*\[+/, "", table); sub(/\].*$/, "", table); gsub(/[[:space:]]/, "", table)
    next
  }
'

# The fix, under whichever line introduced the problem. ⚠️ It applies to
# workspace-write only — in read-only mode the key does nothing. That is the
# mode `codex debug prompt-input` reports for a trusted project; an untrusted
# one gets read-only.
jus_codex_network_fix() {
  jus_ui_note "Turn it on in $(jus_tilde_path "$(jus_codex_config_file)"), then start a new Codex session:"
  jus_ui_cmd "[sandbox_workspace_write]"
  jus_ui_cmd "network_access = true"
}

# Does any Codex config let sandboxed commands reach the network? The user's
# config, and the project's own, which Codex layers on top once the project is
# trusted. Recognised: the table, the top-level dotted key, the inline table,
# and danger-full-access, which has no sandbox to deny anything. A profile is
# not read, which is why doctor only warns on a miss.
jus_codex_network_enabled() {
  local project_root="$1" file
  for file in "$(jus_codex_config_file)" "${project_root}/.codex/config.toml"; do
    [[ -f "$file" ]] || continue
    awk "$JUS_CODEX_TOML_TABLES"'
      table == "sandbox_workspace_write" && /^[[:space:]]*network_access[[:space:]]*=[[:space:]]*true([[:space:]#]|$)/ { found = 1 }
      table == "" && /^[[:space:]]*sandbox_workspace_write\.network_access[[:space:]]*=[[:space:]]*true([[:space:]#]|$)/ { found = 1 }
      table == "" && /^[[:space:]]*sandbox_workspace_write[[:space:]]*=[[:space:]]*\{.*network_access[[:space:]]*=[[:space:]]*true/ { found = 1 }
      table == "" && /^[[:space:]]*sandbox_mode[[:space:]]*=[[:space:]]*"danger-full-access"/ { found = 1 }
      END { exit !found }
    ' "$file" && return 0
  done
  return 1
}

# ── Codex's AGENTS.md byte budget (#5563) ─────────────────────────────────────
#
# Codex reads only the first project_doc_max_bytes of a project's AGENTS.md and
# drops the rest, with nothing on the screen. Measured on codex-cli 0.160.0;
# the arms behind every rule here are in .jus/docs/codex-agents-md-budget.md.

# DEFAULT_PROJECT_DOC_MAX_BYTES in codex-rs/config/src/config_toml.rs.
JUS_CODEX_DOC_LIMIT_DEFAULT=32768

# A top-level project_doc_max_bytes in <file>, or a failure. The same key under
# a [table] is that table's, not the setting. TOML allows 65_536.
jus_codex_doc_limit_in() { # <file>
  [[ -f "$1" ]] || return 1
  awk "$JUS_CODEX_TOML_TABLES"'
    table == "" && /^[[:space:]]*project_doc_max_bytes[[:space:]]*=/ {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value); sub(/[[:space:]#].*$/, "", value); gsub(/_/, "", value)
      if (value ~ /^[0-9]+$/) { print value; found = 1; exit }
    }
    END { exit !found }
  ' "$1"
}

# What the user's Codex config says about trusting <dir>: trusted, untrusted,
# or nothing. Codex writes it as a [projects."<dir>"] table.
jus_codex_trust_level() { # <dir>
  local file
  file="$(jus_codex_config_file)"
  [[ -f "$file" ]] || return 0
  JUS_CODEX_TRUST_DIR="$1" awk "$JUS_CODEX_TOML_TABLES"'
    BEGIN { want = "projects.\"" ENVIRON["JUS_CODEX_TRUST_DIR"] "\""; gsub(/[[:space:]]/, "", want) }
    table == want && /^[[:space:]]*trust_level[[:space:]]*=/ {
      level = $0
      sub(/^[^=]*=[[:space:]]*"/, "", level); sub(/".*$/, "", level)
      print level; exit
    }
  ' "$file"
}

# Codex keys trust on the git root's real path, and a worktree takes its main
# checkout's when it has no decision of its own. So the root comes from git,
# which resolves symlinks, never from the path doctor was reached by.
jus_codex_project_trust() { # <project_root>
  local top common level
  top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || return 0
  level="$(jus_codex_trust_level "$top")"
  if [[ -z "$level" ]] && common="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    level="$(jus_codex_trust_level "$(dirname "$common")")"
  fi
  printf '%s\n' "$level"
}

# ── Qwen Code's and Gemini CLI's macOS sandbox (#5000) ────────────────────────
#
# Both re-run themselves under sandbox-exec with a seatbelt profile, export
# SANDBOX=sandbox-exec and SEATBELT_PROFILE to every command, and have their
# shell tools add QWEN_CODE=1 or GEMINI_CLI=1. A profile ending -closed denies
# outbound connections; one ending -proxied allows only localhost:8877, where a
# proxy may or may not be listening. Read in Qwen Code 0.24.0's bundle and
# Gemini CLI v0.60.0's source — Gemini ships no -closed profile at all.
#
# ⚠️ ONLY THE SEATBELT PATH. Their container sandboxes set SANDBOX to the
# container's name and switch the network by a setting no command can see.
jus_seatbelt_network_limited() {
  [[ "${SANDBOX:-}" == "sandbox-exec" ]] || return 1
  case "${SEATBELT_PROFILE:-}" in
    *-closed | *-proxied) return 0 ;;
  esac
  return 1
}

# The tool whose sandbox this is, or nothing when neither marker is set.
jus_seatbelt_tool() {
  if [[ "${QWEN_CODE:-}" == "1" ]]; then
    printf 'Qwen Code\n'
  elif [[ "${GEMINI_CLI:-}" == "1" ]]; then
    printf 'Gemini CLI\n'
  fi
}

# The same profile with the network open, so its file rules stay as chosen.
# A custom profile has no known twin, so it gets both tools' default.
jus_seatbelt_open_profile() {
  case "$SEATBELT_PROFILE" in
    permissive-* | restrictive-* | strict-*) printf '%s-open\n' "${SEATBELT_PROFILE%-*}" ;;
    *) printf 'permissive-open\n' ;;
  esac
}

jus_seatbelt_explain() {
  local tool where profile="$SEATBELT_PROFILE" launcher
  local -a launchers
  tool="$(jus_seatbelt_tool)"
  case "$tool" in
    "Qwen Code") where="Qwen Code's macOS sandbox" launchers=(qwen) ;;
    "Gemini CLI") where="Gemini CLI's macOS sandbox" launchers=(gemini) ;;
    *) where="a macOS sandbox" launchers=(qwen gemini) ;;
  esac
  jus_ui_note "This ran inside ${where}."
  case "$profile" in
    *-closed) jus_ui_note "Its profile, ${profile}, denies the network." ;;
    *) jus_ui_note "Its profile, ${profile}, reaches the network only through"$'\n'"a proxy on localhost:8877." ;;
  esac
  jus_ui_note "Start ${tool:-the tool} again with a profile that allows the network:"
  for launcher in "${launchers[@]}"; do
    jus_ui_cmd "SEATBELT_PROFILE=$(jus_seatbelt_open_profile) ${launcher}"
  done
}

# ── Cursor's sandbox (#5006) ──────────────────────────────────────────────────
#
# Cursor exports CURSOR_SANDBOX to every command its agent runs sandboxed —
# `seatbelt` on the Mac, measured with cursor-agent 2026.09.18; `native` in its
# Linux build — and points HTTPS_PROXY at a local proxy that refuses any host
# ~/.cursor/sandbox.json does not allow, so curl gets no status at all. The
# variable is set whether or not the board is allowed, hence "may".
#
# ⚠️ RESTART, NOT RETRY. The policy is read when the agent starts: measured, a
# running agent kept refusing the board after the file allowed it, and the next
# start let it through, even resuming the same chat.
jus_cursor_sandboxed() {
  [[ -n "${CURSOR_SANDBOX:-}" ]]
}

# BASE_URL's host as sandbox.json names one: no scheme, user, port or path.
jus_base_url_host() {
  local host="${BASE_URL#*://}"
  host="${host%%/*}"
  host="${host##*@}"
  printf '%s\n' "${host%:*}"
}

jus_cursor_explain() {
  local host
  host="$(jus_base_url_host)"
  jus_ui_note "This ran inside Cursor's sandbox, which may be blocking ${host}."
  jus_ui_note "Allow it in $(jus_tilde_path "${HOME}/.cursor/sandbox.json"), or add it to"$'\n'"networkPolicy.allow there if the file already exists:"
  jus_ui_cmd "{\"networkPolicy\":{\"allow\":[\"${host}\"]}}"
  jus_ui_note "Then restart Cursor. Its agent reads the file when it starts, so a retry"$'\n'"in the same session is still refused."
}

# A sandbox that says it is one but not whether the board is reachable. Codex's
# variable is not here because it does say (#4982).
jus_sandbox_marked() {
  jus_seatbelt_network_limited || jus_cursor_sandboxed
}

# Why the board may be unreachable from this sandbox, and the fix.
jus_sandbox_explain() {
  if jus_seatbelt_network_limited; then
    jus_seatbelt_explain
  else
    jus_cursor_explain
  fi
}

# Does anything answer at BASE_URL? Any HTTP status counts: the socket is what
# is in question, not the credential. Only doctor asks, and only inside a
# sandbox that cannot say for itself (#5000).
jus_board_answers() {
  local http_code curl_status=0
  http_code=$(curl -s -o /dev/null -w '%{http_code}' \
    --max-time "${JUS_BOARD_PROBE_TIMEOUT:-5}" "${BASE_URL}/up" 2>/dev/null) || curl_status=$?
  ! transport_failed "$curl_status" "$http_code"
}

# What every caller prints when `transport_failed` is true. One message, because
# the remedies are the same wherever it happens and none of them is "rotate your
# token" — an hour went on #4519 rotating a credential that was fine, while the
# real cause was codex's sandbox with the network switched off.
#
# It names BASE_URL because a wrong JUSCRIBE_BASE_URL is the other way into this
# branch, and nothing else on screen says which host was tried. Inside Codex's
# offline sandbox the cause is known, so it names that instead (#4982), and
# inside another tool's sandbox it names that as the likely one (#5000).
unreachable_message() {
  jus_ui_fail "Error: Could not reach the Juscribe server at ${BASE_URL}"
  if jus_codex_network_off; then
    jus_ui_note $'No reply came back, so the token was never checked — this is NOT an\nexpired credential. This ran inside Codex\'s sandbox, which has the\nnetwork switched off.'
    jus_codex_network_fix
    return
  fi
  if jus_sandbox_marked; then
    jus_ui_note $'No reply came back, so the token was never checked — this is NOT an\nexpired credential.'
    jus_sandbox_explain
    return
  fi
  jus_ui_note $'No reply came back, so the token was never checked — this is NOT an\nexpired credential. Check the network, any sandbox denying outbound\nconnections, and JUSCRIBE_BASE_URL.'
}

# The Authorization header as a curl config (`-K`), for a process substitution:
#
#   curl -K <(jus_curl_auth "$token") …
#
# ⚠️ NEVER `-H "Authorization: Bearer $token"`. curl's argv is readable by
# every process on the machine through `ps`, so a header on the command line
# hands a live token to any local user for as long as the request runs. A
# config read from a file descriptor is not in any argv, and `printf` is a
# builtin, so no process is started with the token either.
#
# `-K` rather than `-H @file` because every curl has it; reading headers from
# a file needs 7.55.0. Stdin stays free for `--data @-`. `\` and `"` are
# escaped because the config value is a quoted string.
jus_curl_auth() {
  local token="${1//\\/\\\\}"
  printf 'header = "Authorization: Bearer %s"\n' "${token//\"/\\\"}"
}

# Call GET /api/v1/profile. Three outcomes, because two of them used to be one:
#
#   0  the server replied 200 — the profile JSON is on stdout
#   1  the server replied and refused — something IS known about the credential
#   2  no reply ever arrived — nothing is known about the credential
#
# -S so curl's own diagnosis ("Could not resolve host", "Connection refused")
# still reaches stderr; -s alone swallows it.
validate_token() {
  local token="$1"
  local response http_code body curl_status=0

  response=$(curl -sS -w "\n%{http_code}" \
    -K <(jus_curl_auth "$token") \
    -H "Accept: application/json" \
    "${BASE_URL}/api/v1/profile") || curl_status=$?

  http_code=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  if transport_failed "$curl_status" "$http_code"; then
    return 2
  fi

  if [[ "$http_code" -ne 200 ]]; then
    return 1
  fi

  echo "$body"
}

# Extract a JSON string value (simple, no jq dependency required)
#
# ⚠️ THE KEY IS DATA, NEVER PYTHON (#5067). The fallback used to build Python
# source around the key and `eval` it, so a key carrying Python ran it. Every
# caller passes a literal dotted path, which is why nothing ever did — and why
# nobody reading the function could tell. The path goes in argv and is walked
# one key at a time, and a missing step reads `null`, as it does through jq.
json_val() {
  local json="$1" key="$2"
  if command -v jq &>/dev/null; then
    echo "$json" | jq -r "$key"
  elif command -v python3 &>/dev/null; then
    echo "$json" | python3 -c '
import json, sys
value = json.load(sys.stdin)
for key in sys.argv[1].lstrip(".").split("."):
    value = value.get(key) if isinstance(value, dict) else None
if isinstance(value, bool):
    print("true" if value else "false")
elif value is None:
    print("null")
else:
    print(value)
' "$key" 2>/dev/null || echo "$json"
  else
    echo "(install jq for formatted output)"
  fi
}

# True when an HTTP status means the call succeeded. Single source of truth for
# both the colouring below and `cmd_api`'s exit code (#2016).
http_status_ok() {
  local http_code="$1"
  [[ "$http_code" =~ ^[0-9]+$ ]] && [[ "$http_code" -ge 200 && "$http_code" -lt 300 ]]
}

# ---------------------------------------------------------------------------
# Output helpers (#4838): one mark per kind of line, colour only on a terminal
# ---------------------------------------------------------------------------
#
# Every line `jus init` prints starts with a mark that says what kind it is:
# `?` a question, `›` the answer, `✓` done or already in place, `!` read this,
# `✗` failed, `–` skipped. Colour only repeats the mark. The mark is what a log
# keeps; the colour is what a terminal adds.
#
# ⚠️ EACH HELPER DECIDES COLOUR FOR THE STREAM IT WRITES TO, AS IT WRITES.
# `jus init` writes to two: the tool menu and every question go to stderr,
# because their stdout is captured by `$(…)`. So the test is `-t` on the fd
# being written, made inside the helper — never inside a `$(…)`, whose stdout
# is a pipe every time — and a helper redirected with `>&2` at the call site
# tests the right stream by itself.
#
# The order (#4826 review): NO_COLOR non-empty → off (no-color.org). Then
# FORCE_COLOR: 0 or false → off, any other non-empty value → on; empty is as
# if unset. Then TERM=dumb → off. Otherwise colour only if the stream is a
# terminal. FORCE_COLOR sits above TERM because bash sets an unset TERM to dumb,
# and cron and `docker run` without -t are what it exists for.
#
# ⚠️ NOT NODE'S READING, whatever this said until the #4838 review: Node and
# supports-color take an empty FORCE_COLOR as on, and `yes`/`no` differently.
# The rule is the ticket's, and is simpler to state.
#
# Raw escape codes rather than tput, which exits non-zero without a usable TERM
# and would stop the script under set -e. The 16 basic colours, bold and dim.
# The codes sit in printf's format string and `%s` carries every piece of text:
# `echo -e` turns a `\c` in a workspace name into a truncation.
jus_ui_color() { # <fd>
  local fd="${1:-1}"
  if [[ -n "${NO_COLOR:-}" ]]; then
    return 1
  fi
  case "${FORCE_COLOR:-}" in
    0 | false) return 1 ;;
    "") ;;
    *) return 0 ;;
  esac
  if [[ "${TERM:-}" == "dumb" ]]; then
    return 1
  fi
  [[ -t "$fd" ]]
}

# Writes <text> to <fd>, wrapped in the SGR code <sgr> when that stream gets
# colour and bare otherwise. No newline.
jus_ui_paint() { # <fd> <sgr> <text>
  local fd="$1" sgr="$2" text="$3"
  if jus_ui_color "$fd"; then
    printf '\033[%sm%s\033[0m' "$sgr" "$text" >&"$fd"
  else
    printf '%s' "$text" >&"$fd"
  fi
}

# A marked line: the mark in its colour, a space, the text. A text carrying
# newlines — a recorded action pre-broken under column 80 — continues under
# the text, two spaces in, never under the mark.
jus_ui_line() { # <fd> <sgr> <mark> <text>
  local fd="$1" sgr="$2" mark="$3" text="$4" first=1 line
  jus_ui_paint "$fd" "$sgr" "$mark"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if (( first )); then
      printf ' %s\n' "$line" >&"$fd"
      first=0
    else
      printf '  %s\n' "$line" >&"$fd"
    fi
  done <<<"$text"
}

jus_ui_done() { jus_ui_line 1 32 "✓" "$1"; }
jus_ui_warn() { jus_ui_line 1 33 "!" "$1"; }
jus_ui_fail() { jus_ui_line 1 31 "✗" "$1"; }
jus_ui_skipped() { jus_ui_line 1 2 "–" "$1"; }

# Context under the line it explains: dim, two spaces in, one line per line.
jus_ui_note() { # <text>
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    jus_ui_paint 1 2 "  ${line}"
    printf '\n'
  done <<<"$1"
}

# A command to copy: bold, four spaces in, alone on its line.
jus_ui_cmd() { # <command>
  jus_ui_paint 1 1 "    $1"
  printf '\n'
}

# <count> copies of <char>, for the rules. A loop rather than printf and tr,
# which BSD tr does not do for a multi-byte character.
jus_ui_fill() { # <char> <count>
  local char="$1" n="$2" out=""
  while (( n > 0 )); do
    out+="$char"
    n=$((n - 1))
  done
  printf '%s' "$out"
}

JUS_UI_WIDTH=60

# ━━ Title ━━━━… to column 60, bold.
jus_ui_banner() { # <title>
  local title="$1" fill
  fill=$(( JUS_UI_WIDTH - ${#title} - 6 ))
  if (( fill < 2 )); then
    fill=2
  fi
  jus_ui_paint 1 1 "━━ ${title} ━━$(jus_ui_fill "━" "$fill")"
  printf '\n'
}

# ── Step 3 of 5 · Workspace ────… to column 60, bold magenta.
jus_ui_step() { # <n> <total> <name>
  local label="Step $1 of $2 · $3" fill
  fill=$(( JUS_UI_WIDTH - ${#label} - 6 ))
  if (( fill < 2 )); then
    fill=2
  fi
  jus_ui_paint 1 "1;35" "── ${label} ──$(jus_ui_fill "─" "$fill")"
  printf '\n'
}

# The question line of a menu, on stderr — the options and the `Select` prompt
# follow it, through jus_ui_note and jus_ui_ask --under.
jus_ui_question() { # <text>
  jus_ui_paint 2 36 "?"
  printf ' ' >&2
  jus_ui_paint 2 1 "$1"
  printf '\n' >&2
}

# What an answer meant, on stderr: `  › Acme Web`, `  › Yes (default)`.
jus_ui_answer() { # <text>
  printf '  ' >&2
  jus_ui_paint 2 2 "›"
  printf ' ' >&2
  jus_ui_paint 2 36 "$1"
  printf '\n' >&2
}

# Asks on stderr and reads the answer from stdin into JUS_UI_ANSWER, the one
# global, like bash's own REPLY. Then records what the answer meant on a `›`
# line, so a log keeps both halves of the exchange.
#
#   --default LABEL   what Enter or end of input means: recorded "LABEL (default)"
#   --secret          read hidden; recorded "received (hidden)"
#   --under           the prompt sits indented under a jus_ui_question, no mark
#   --quiet           no answer line: a menu records the name through jus_ui_answer
#
# ⚠️ IT PRINTS THE QUESTION ITSELF AND NEVER USES `read -p`, which prints
# nothing when stdin is not a terminal — why questions vanished from every log
# (#4826). ⚠️ END OF INPUT IS THE DEFAULT AND IS READ ONCE (#4832): `read`
# returns 1 there and the value it did read is kept, so an answer piped in
# without a final newline survives, and nothing reads a second time. ⚠️ THE
# ANSWER COMES BACK IN A GLOBAL: a `›` line on stdout would land inside the
# values callers return through `$(…)`, and setting a caller's variable by
# name through printf -v or eval collides with these locals or runs the answer.
jus_ui_ask() {
  local default="" secret=0 under=0 quiet=0
  while (( $# > 1 )); do
    case "$1" in
      --default) default="$2"; shift 2 ;;
      --secret) secret=1; shift ;;
      --under) under=1; shift ;;
      --quiet) quiet=1; shift ;;
      *) break ;;
    esac
  done
  local prompt="$1" rc=0
  if (( under )); then
    printf '  ' >&2
  else
    jus_ui_paint 2 36 "?"
    printf ' ' >&2
  fi
  jus_ui_paint 2 1 "$prompt"
  printf ' ' >&2
  JUS_UI_ANSWER=""
  if (( secret )); then
    IFS= read -rs JUS_UI_ANSWER || rc=$?
  else
    IFS= read -r JUS_UI_ANSWER || rc=$?
  fi
  # Trimmed, as `read -rp` was (#4838 review): ` n` ran a [Y/n] question's
  # default, a menu read `2 ` as no choice, and a token kept its spaces. bash
  # 3.2 has no trim of its own, hence the two expansions.
  JUS_UI_ANSWER="${JUS_UI_ANSWER#"${JUS_UI_ANSWER%%[![:space:]]*}"}"
  JUS_UI_ANSWER="${JUS_UI_ANSWER%"${JUS_UI_ANSWER##*[![:space:]]}"}"
  # The terminal echoes the Enter that ended a visible answer. Every other
  # case — a pipe, end of input, a hidden read — leaves the cursor on the
  # question line, so the newline is added here.
  if ! { [[ -t 0 ]] && [[ -t 2 ]] && (( rc == 0 )) && (( secret == 0 )); }; then
    printf '\n' >&2
  fi
  if (( quiet )); then
    return 0
  fi
  # ⚠️ EMPTY WITH NO DEFAULT IS WHAT IT WAS (#4838 review): an empty paste said
  # "received (hidden)", and a question with no default recorded "(default)".
  if [[ -z "$JUS_UI_ANSWER" && -z "$default" ]]; then
    jus_ui_answer "(nothing entered)"
  elif (( secret )); then
    jus_ui_answer "received (hidden)"
  elif [[ -z "$JUS_UI_ANSWER" ]]; then
    jus_ui_answer "${default} (default)"
  else
    jus_ui_answer "$JUS_UI_ANSWER"
  fi
  return 0
}

# One "Done during setup" item: the action, and under it what reverses it,
# labelled — "just indenting to show what to do to reverse is not clear"
# (stakeholder, #4838). The stored strings end in ` — undo with: <command>` or
# ` — undo by <what to do>`; nothing asserts on "undo with", so the split is
# made here rather than in every record.
#
# ⚠️ SPLIT ON THE LAST SEPARATOR (#4838 review). The action can carry server
# text — a workspace name — and one containing " — undo with: " printed a bold
# `Revert with:` command of its own. The revert is always ours and always last.
jus_print_setup_action() { # <recorded action>
  local action="$1" with_tail by_tail
  with_tail="${action##* — undo with: }"
  by_tail="${action##* — undo by }"
  if [[ "$with_tail" != "$action" ]] && { [[ "$by_tail" == "$action" ]] || (( ${#with_tail} < ${#by_tail} )); }; then
    jus_ui_done "${action% — undo with: *}"
    jus_ui_paint 1 2 "  Revert with:"
    printf ' '
    jus_ui_paint 1 1 "$with_tail"
    printf '\n'
  elif [[ "$by_tail" != "$action" ]]; then
    jus_ui_done "${action% — undo by *}"
    jus_ui_note "Revert by ${by_tail}"
  else
    jus_ui_done "$action"
  fi
}

# The `HTTP 200` line of `jus api`, on stderr, coloured by class — only when
# stderr is a terminal (#4838). It used to write the escape codes into every
# piped call, which is every agent transcript.
print_status() {
  local http_code="$1" sgr
  if http_status_ok "$http_code"; then
    sgr=32
  elif [[ "$http_code" -ge 400 ]]; then
    sgr=31
  else
    sgr=33
  fi
  printf 'HTTP ' >&2
  jus_ui_paint 2 "$sgr" "$http_code"
  printf '\n' >&2
}

# ---------------------------------------------------------------------------
# Subcommand: api
# ---------------------------------------------------------------------------

# The first path segments /api/v1 answers at the TOP level — everything that is
# not nested under a workspace. Anything else is workspace-scoped, so a caller
# may leave the `/workspaces/<id>/` off it (#4729).
#
# ⚠️ DERIVED, NEVER REMEMBERED. This is a denylist inside a binary people have
# already installed, so it goes stale on its own: a top-level route added to
# the application is invisible to every `jus` in the field, which would prefix
# it and 404. `spec/project/jus_api_workspace_path_spec.rb` reads the real
# segments off the Rails route set and fails when one is missing here.
JUS_TOPLEVEL_API_SEGMENTS=(
  admin agent_releases api_tokens author_name cli_session community_themes confirmation connected_apps dispatches
  file_locations files guest_link_file_cookie invitation mailing_list
  mobile_release mobile_session my my_themes notifications oauth_registration
  organization_invitations organizations password plans profile public registration schema
  session site_announcements support_contact teams theme_drafts theme_previews theme_versions themes unlock versions waitlist
  workspace_templates workspaces
)

# Resolves the path an `api` caller typed against their workspace.
#
#   $1  the path as typed
#   $2  the stored workspace id, empty when none is configured
#
# Prints the resolved path, or explains itself on stderr and returns 1. Pure —
# it reads no files and no globals but the segment list above, which is what
# lets the spec call it directly.
resolve_api_path() {
  local path="$1" ws_id="$2"

  [[ "$path" == /* ]] || path="/$path"

  if [[ "$path" == *"{ws}"* ]]; then
    if [[ -z "$ws_id" ]]; then
      echo "Error: {ws} placeholder used but no workspace configured. Run '$PROG_NAME init'." >&2
      return 1
    fi
    printf '%s\n' "${path//\{ws\}/$ws_id}"
    return 0
  fi

  # The first segment, with any query string cut off it. `/tickets?state=x`
  # has to match `tickets`, not `tickets?state=x`.
  local first="${path#/}"
  first="${first%%/*}"
  first="${first%%\?*}"

  # Already rooted at the API itself (`/api/mobile/v1/...` reaches a namespace
  # this list says nothing about), a bare slash, or a top-level route.
  if [[ "$path" == /api/* ]] || [[ -z "$first" ]] || jus_is_toplevel_api_segment "$first"; then
    printf '%s\n' "$path"
    return 0
  fi

  if [[ -z "$ws_id" ]]; then
    echo "Error: '$path' is workspace-scoped and no workspace is configured." >&2
    echo "       Run '$PROG_NAME init', or write the path in full: /workspaces/<id>$path" >&2
    return 1
  fi

  printf '%s\n' "/workspaces/${ws_id}${path}"
}

# Whole-segment membership. A substring test would leave `/profiles` alone on
# the strength of `profile`, and send it to a route that does not exist.
jus_is_toplevel_api_segment() {
  local candidate="$1" segment
  for segment in "${JUS_TOPLEVEL_API_SEGMENTS[@]}"; do
    [[ "$segment" == "$candidate" ]] && return 0
  done
  return 1
}

# ── A workspace that moved organization (#5047) ───────────────────────────────
#
# A transfer gives the board a new number from the destination's counter and
# keeps every key pinned to it working, because a key is pinned by the internal
# id. So the saved number 404s, and /profile's `token_scope.workspace_id` — read
# live from the workspace — is the one that works now.
#
# ⚠️ A MISMATCH IS NOT PROOF OF A MOVE. JUSCRIBE_API_TOKEN exported for another
# board (the MCP server reads the same variable), or `jus login` with another
# board's token, produce the same mismatch, and adopting it would point this
# project at the wrong board. So the file is rewritten only when the token is
# the project's own AND the organization changed or was never saved: a transfer
# always changes it (stakeholder decision on #5047).

# The sentence to print after jus_check_saved_workspace, without the `jus: `.
JUS_WORKSPACE_NOTICE=""

# Compares the token's workspace, from a /profile body, with the saved one.
#
#   0  nothing to say: no saved number, an unpinned token, or they agree
#   1  moved: the saved files now hold the token's workspace
#   2  a mismatch that is not a move: nothing written
jus_check_saved_workspace() { # <profile_json>
  local profile="$1" saved token_ws ws_name org_id org_name org_file updated
  JUS_WORKSPACE_NOTICE=""
  [[ -f "$WORKSPACE_FILE" ]] || return 0
  saved="$(tr -d '[:space:]' < "$WORKSPACE_FILE")"
  token_ws="$(jus_json_field "$profile" '.token_scope.workspace_id')"
  [[ -n "$token_ws" && "$token_ws" != "$saved" ]] || return 0

  ws_name="$(jus_json_field "$profile" '.token_scope.workspace_name')"
  org_id="$(jus_json_field "$profile" '.token_scope.organization_id')"
  org_name="$(jus_json_field "$profile" '.token_scope.organization_name')"
  org_file="${CONFIG_DIR}/organization_id"

  if ! jus_token_is_projects_own; then
    JUS_WORKSPACE_NOTICE="JUSCRIBE_API_TOKEN is for workspace ${token_ws}${ws_name:+ (${ws_name})}, not this project's workspace ${saved}, so .jus/config/workspace_id was left alone. Unset it to use the project's own token."
    return 2
  fi
  if [[ -f "$org_file" && "$(tr -d '[:space:]' < "$org_file")" == "$org_id" ]]; then
    JUS_WORKSPACE_NOTICE="your token is for workspace ${token_ws}${ws_name:+ (${ws_name})}, not this project's workspace ${saved}. Both are in ${org_name:-one organization}, so the workspace did not move and .jus/config/workspace_id was left alone. Run '${PROG_NAME} init' to switch this project to it."
    return 2
  fi

  printf '%s' "$token_ws" > "$WORKSPACE_FILE"
  updated=".jus/config/workspace_id"
  if [[ -f "$org_file" && -n "$org_id" ]]; then
    printf '%s' "$org_id" > "$org_file"
    updated+=" and .jus/config/organization_id"
  fi
  JUS_WORKSPACE_NOTICE="this workspace moved to ${org_name:-another organization}, and its number changed from ${saved} to ${token_ws}. Updated ${updated}."
  return 1
}

# True when the token in use is the project's saved one. resolve_token prefers
# the variable, and a variable holding the same token is still the project's.
jus_token_is_projects_own() {
  [[ -z "${JUSCRIBE_API_TOKEN:-}" ]] ||
    { [[ -f "$TOKEN_FILE" ]] && [[ "$JUSCRIBE_API_TOKEN" == "$(cat "$TOKEN_FILE")" ]]; }
}

# True when a resolved path addresses the saved workspace — the only 404 a
# stale number can explain. `31` must not match `3`.
jus_path_uses_workspace() { # <resolved path> <saved workspace id>
  local path="${1#/api/v1}" ws_id="$2"
  [[ -n "$ws_id" ]] || return 1
  case "$path" in
    "/workspaces/${ws_id}" | "/workspaces/${ws_id}/"* | "/workspaces/${ws_id}?"*) return 0 ;;
  esac
  return 1
}

# After a 404 on the saved number: one /profile call, and a line on stderr only
# when the number explains it. The command is NOT re-sent — a caller may have
# written the old number into a literal path, so the re-run is theirs.
jus_explain_workspace_404() { # <token>
  local profile check=0
  profile="$(validate_token "$1" 2>/dev/null)" || return 0
  jus_check_saved_workspace "$profile" || check=$?
  case "$check" in
    1) printf 'jus: %s Re-run the command.\n' "$JUS_WORKSPACE_NOTICE" >&2 ;;
    2) printf 'jus: %s\n' "$JUS_WORKSPACE_NOTICE" >&2 ;;
  esac
}

cmd_api() {
  local raw=false verbose=false
  local args=()

  for arg in "$@"; do
    case "$arg" in
      --raw) raw=true ;;
      -v) verbose=true ;;
      *) args+=("$arg") ;;
    esac
  done

  if [[ ${#args[@]} -lt 2 ]]; then
    echo "Usage: $PROG_NAME api METHOD /path [json_body | @file.json]" >&2
    echo "       $PROG_NAME api GET /tickets      # your workspace is supplied" >&2
    echo "       $PROG_NAME api GET /profile      # top-level routes are not" >&2
    echo "       $PROG_NAME api POST /tickets '{\"ticket\":{...}}'" >&2
    echo "       $PROG_NAME api POST /tickets @.jus/tmp/payload.json" >&2
    echo "       $PROG_NAME api POST /tickets <<'EOF'" >&2
    exit 1
  fi

  local method="${args[0]}"
  local path="${args[1]}"
  local body_arg="${args[2]:-}"

  # Supply the workspace the caller left off, and substitute a {ws} placeholder.
  # Both live in resolve_api_path, which is where the segment list is.
  #
  # The `&&` is load-bearing under `set -euo pipefail`: a failing command on the
  # LEFT of one is exempt from errexit, so a missing file leaves the id empty
  # and resolve_api_path gets to explain itself. An `if` would read the same and
  # a bare `stored_ws_id=$(cat …)` would abort the shell with no message at all.
  local stored_ws_id=""
  [[ -f "$WORKSPACE_FILE" ]] && stored_ws_id=$(cat "$WORKSPACE_FILE")
  path=$(resolve_api_path "$path" "$stored_ws_id") || exit 1

  # Resolve body: @filepath, inline JSON, or piped stdin
  # If multiple args remain after path, join them (recovers from unquoted JSON splitting)
  local body=""
  if [[ -n "$body_arg" ]]; then
    if [[ "$body_arg" == @* ]]; then
      local filepath="${body_arg#@}"
      if [[ ! -f "$filepath" ]]; then
        echo "Error: File not found: $filepath" >&2
        exit 1
      fi
      body=$(cat "$filepath")
    elif [[ ${#args[@]} -gt 3 ]]; then
      # Multiple args after path — join them (likely unquoted JSON that got split)
      body="${args[*]:2}"
    else
      body="$body_arg"
    fi
  elif [[ ! -t 0 ]] && [[ "$method" != "GET" ]] && [[ "$method" != "DELETE" ]] &&
    [[ ! -S /dev/stdin ]]; then
    # Only auto-read a request body from stdin for write methods. GET/DELETE
    # never carry a body, and reading stdin for them blocks forever — `cat`
    # waits for an EOF that never arrives whenever the call runs non-interactively
    # with an inherited/open stdin (piped like `jus api GET ... | jq`, or
    # backgrounded). That hang left zombie shells across sessions (#1851). Write
    # methods still read heredoc/@-less piped bodies here.
    #
    # ⚠️ THE WRITE METHODS KEPT THE HANG UNTIL #4413, and it is reached by an
    # EMPTY body argument, not by a missing one: the branch above tests
    # `[[ -n "$body_arg" ]]`, so a body built with "$(jq ... < file)" whose
    # redirect failed arrives here as if none had been given. One held a shell
    # open for 13 minutes on 2026-09-17.
    #
    # ⚠️ A SOCKET IS NEVER A BODY. Measured on bash 5.2.37: a heredoc and a pipe
    # both give a FIFO, `< file` gives a regular file, and an agent harness's
    # inherited stdin gives a socket. That test is a FAST PATH and not the
    # guarantee — it is one platform's measurement, and where /dev/stdin does
    # not exist it is simply false, which falls through to the bounded read
    # below. The safe direction.
    #
    # ⚠️ THE TIMEOUT IS ON THE FIRST BYTE ONLY. Once a producer has spoken it is
    # real, so the rest is read with no bound and a slow
    # `producer | jus api POST` keeps working.
    local first_line=""
    if IFS= read -r -t "$JUS_STDIN_TIMEOUT" first_line; then
      body="$first_line"$'\n'"$(cat)"
    elif [[ -n "$first_line" ]]; then
      # EOF with no trailing newline — `read` reports failure and still sets it.
      body="$first_line"
    fi
  fi

  # Validate and auto-repair JSON body — handles shell mangling transparently
  if [[ -n "$body" ]] && [[ "$method" != "GET" ]] && [[ "$method" != "DELETE" ]]; then
    if command -v python3 &>/dev/null; then
      if ! printf '%s' "$body" | python3 -c "import sys,json; json.load(sys.stdin)" 2>/dev/null; then
        # Attempt auto-repair: the shell often mangles quotes, strips backslashes,
        # or truncates at special chars. Try common recovery strategies.
        # ⚠️ The status is captured, never left to `set -e`: when every
        # strategy fails python exits 1, and a bare assignment would end the
        # script right here, before the error below could say anything.
        local repaired="" repair_status=0
        repaired=$(printf '%s' "$body" | python3 -c "
import sys, json, re

raw = sys.stdin.read()

# Strategy 1: raw input is already valid (race condition with earlier check)
try:
    json.loads(raw)
    print(raw, end='')
    sys.exit(0)
except: pass

# Strategy 2: shell ate the outer quotes — body looks like {key: value}
# Try wrapping unquoted keys/values
try:
    # Replace single quotes with double quotes (common shell artifact)
    fixed = raw.replace(chr(39), chr(34))
    json.loads(fixed)
    print(fixed, end='')
    sys.exit(0)
except: pass

# Strategy 3: truncated at a special char — try to close open structures
try:
    # Count open/close braces and brackets
    opens = raw.count('{') - raw.count('}')
    open_brackets = raw.count('[') - raw.count(']')
    # If string is inside a value, close it
    fixed = raw.rstrip()
    if opens > 0 or open_brackets > 0:
        # Check if we're inside a string value (odd number of unescaped quotes)
        in_string = (fixed.count('\"') % 2 == 1)
        if in_string:
            fixed += '\"'
        fixed += ']' * open_brackets
        fixed += '}' * opens
        json.loads(fixed)
        print(fixed, end='')
        sys.exit(0)
except: pass

# Strategy 4: body is the inner content without outer braces
try:
    wrapped = '{' + raw + '}'
    json.loads(wrapped)
    print(wrapped, end='')
    sys.exit(0)
except: pass

# All strategies failed
sys.exit(1)
" 2>/dev/null) || repair_status=$?

        if [[ "$repair_status" -eq 0 ]] && [[ -n "$repaired" ]]; then
          echo "Warning: Body was not valid JSON — auto-repaired." >&2
          body="$repaired"
        else
          echo "Error: Body is not valid JSON and could not be auto-repaired." >&2
          echo "The shell likely mangled quotes or special characters." >&2
          echo "Tip: Use heredoc or @file for complex payloads:" >&2
          echo "  $PROG_NAME api $method '$path' <<'EOF'" >&2
          echo '  {"key": "value with \"quotes\" and $vars"}' >&2
          echo "  EOF" >&2
          echo "" >&2
          echo "  $PROG_NAME api $method '$path' @/tmp/payload.json" >&2
          exit 1
        fi
      fi
    fi
  fi

  # Ensure path starts with /api/v1
  if [[ "$path" != /api/* ]]; then
    path="/api/v1${path}"
  fi

  local token
  token=$(resolve_token) || exit 1

  # Client version for the X-Jus-Version header. Empty when this build carries
  # neither an embedded version nor a VERSION file — the request still goes out,
  # just unattributed.
  local jus_version
  jus_version=$(resolve_client_version)

  # The agent running this call, for the X-Jus-Agent header (#4908). Empty when
  # none is detected, and then the request goes out as it always did.
  local jus_agent
  jus_agent=$(resolve_reported_agent)

  local curl_args=(
    -sS
    -X "$method"
    -H "Content-Type: application/json"
    -H "Accept: application/json"
    -w "\n%{http_code}"
  )

  if [[ -n "$jus_version" ]]; then
    curl_args+=(-H "X-Jus-Version: $jus_version")
  fi
  if [[ -n "$jus_agent" ]]; then
    curl_args+=(-H "X-Jus-Agent: $jus_agent")
    local session_header
    while IFS= read -r session_header; do
      curl_args+=(-H "$session_header")
    done < <(jus_session_headers "$jus_agent")
  fi

  local url="${BASE_URL}${path}"

  if [[ "$verbose" == true ]]; then
    echo ">>> $method $url" >&2
    if [[ -n "$body" ]]; then
      echo ">>> Body: $body" >&2
    fi
  fi

  # ⚠️ The auth config goes on the curl line itself, never into curl_args: a
  # process substitution in an array assignment is opened for the assignment
  # and closed when it ends, so curl would be handed a dead descriptor.
  local output curl_status=0
  if [[ -n "$body" ]]; then
    output=$(printf '%s' "$body" | curl -K <(jus_curl_auth "$token") "${curl_args[@]}" --data @- "$url") || curl_status=$?
  else
    output=$(curl -K <(jus_curl_auth "$token") "${curl_args[@]}" "$url") || curl_status=$?
  fi

  local http_code
  http_code=$(echo "$output" | tail -1)
  local response
  response=$(echo "$output" | sed '$d')

  # No reply at all. `jus api` never claimed the token had expired the way
  # `jus whoami` did — it said nothing whatsoever. Under `set -e` the failed
  # assignment above simply ended the script, so the whole run was a silent
  # exit carrying curl's own status: measured against a dead host, no output
  # and exit 6 (#4520). Capturing the status is what keeps us here to say so.
  if transport_failed "$curl_status" "$http_code"; then
    unreachable_message >&2
    return 1
  fi

  print_status "$http_code"

  # The body still goes to stdout on an error — it carries the reason, and
  # callers that inspect it should keep working — but the EXIT CODE now says
  # what happened (#2016). It used to be 0 for everything, so a script following
  # "stdout is pure JSON, pipe it to a parser" could not tell a created comment
  # from a 500, and a 404 body (`{"error":"Not found"}`) has no status field to
  # check either. Non-2xx is a failure, like `curl --fail`.
  local failed=0
  http_status_ok "$http_code" || failed=1

  if [[ -n "$response" ]]; then
    if [[ "$raw" == true ]]; then
      echo "$response"
    elif command -v jq &>/dev/null; then
      echo "$response" | jq . 2>/dev/null || echo "$response"
    else
      echo "$response"
    fi
  fi

  # AFTER the body, so nothing can interleave with the JSON contract (#4508).
  jus_maybe_warn_skills "$method" "$path"

  # A saved number that went stale in a transfer 404s like a missing ticket
  # does; only /profile can tell them apart (#5047).
  if [[ "$http_code" == "404" ]] && jus_path_uses_workspace "$path" "$stored_ws_id"; then
    jus_explain_workspace_404 "$token"
  fi

  return $failed
}

# ---------------------------------------------------------------------------
# Subcommand: download
